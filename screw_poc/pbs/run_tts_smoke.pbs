#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N screw_tts_smoke
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# Three-dialogue Qwen3-TTS smoke test.
# Submit from the repository root:
#   qsub -V screw_poc/pbs/run_tts_smoke.pbs
# Override the number of dialogues:
#   qsub -V -v NUM_DIALOGUES=10 screw_poc/pbs/run_tts_smoke.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

if [[ ! -f screw_poc/scripts/generate_dialogues.py ]]; then
    echo "ERROR: submit this job from the miltoka repository root." >&2
    exit 1
fi
if [[ -f scripts/setup_proxy.sh ]]; then
    # shellcheck source=/dev/null
    source scripts/setup_proxy.sh
fi
command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

JOB_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID="${JOB_ID%%.*}"
NUM_DIALOGUES="${NUM_DIALOGUES:-3}"
DIALOGUES_JSONL="${DIALOGUES_JSONL:-$PWD/screw_poc/artifacts/train_dialogues.jsonl}"
OUT_ROOT="${OUT_ROOT:-$PWD/screw_poc/artifacts/tts_smoke_${JOB_ID}}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export TTS_DEVICE="${TTS_DEVICE:-cuda}"
export TTS_DTYPE="${TTS_DTYPE:-float16}"
export LEAD_IN_SEC="${LEAD_IN_SEC:-0.3}"
export GAP_SEC="${GAP_SEC:-0.2}"

if ! [[ "$NUM_DIALOGUES" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: NUM_DIALOGUES must be a positive integer: $NUM_DIALOGUES" >&2
    exit 1
fi

mkdir -p screw_poc/artifacts/pbs_logs "$OUT_ROOT"
exec > >(tee -a "screw_poc/artifacts/pbs_logs/tts_smoke_${JOB_ID}.log") 2>&1

echo "===== screw PoC TTS smoke ====="
echo "job_id:        ${PBS_JOBID:-n/a}"
echo "host:          $(hostname)"
echo "dialogues:     $DIALOGUES_JSONL"
echo "num_dialogues: $NUM_DIALOGUES"
echo "out_root:      $OUT_ROOT"
echo "cuda:          $CUDA_VISIBLE_DEVICES"
echo "dtype:         $TTS_DTYPE"
echo "started_at:    $(date -Iseconds)"

uv run python screw_poc/scripts/generate_dialogues.py --out-dir screw_poc/artifacts
uv run python screw_poc/scripts/validate_dataset.py \
    "$DIALOGUES_JSONL" --expected-count 1000

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

NUM_DIALOGUES="$NUM_DIALOGUES" \
    bash screw_poc/scripts/run_tts.sh "$DIALOGUES_JSONL" "$OUT_ROOT"

MANIFEST="$OUT_ROOT/training_set/synthetic_moshi_train.jsonl"
test -s "$MANIFEST"
WAV_COUNT="$(find "$OUT_ROOT/training_set/data_stereo" -maxdepth 1 -type f -name '*.wav' | wc -l)"
if [[ "$WAV_COUNT" -ne "$NUM_DIALOGUES" ]]; then
    echo "ERROR: expected $NUM_DIALOGUES WAVs, found $WAV_COUNT" >&2
    exit 1
fi
echo "manifest:    $MANIFEST"
echo "stereo_wavs: $WAV_COUNT"
echo "finished_at: $(date -Iseconds)"
