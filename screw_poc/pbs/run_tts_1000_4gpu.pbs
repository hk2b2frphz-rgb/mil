#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N screw_tts_1000
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# Generate/validate screw dialogues, render Qwen3-TTS on four GPUs, and merge.
#
# Submit:
#   qsub -V screw_poc/pbs/run_tts_1000_4gpu.pbs
#
# Comparison subset example:
#   qsub -V -v \
# DIALOGUES_JSONL=screw_poc/artifacts/subsets/train_0300.jsonl,NUM_DIALOGUES=300,OUT_ROOT=screw_poc/artifacts/tts_0300 \
# screw_poc/pbs/run_tts_1000_4gpu.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

if [[ ! -f screw_poc/scripts/generate_dialogues.py ]]; then
    echo "ERROR: submit this job from the miltoka repository root." >&2
    exit 1
fi
# Proxy first, on every job, immediately after entering the node.  Sourced
# unconditionally (as scripts/_dag_stage.pbs does) so a missing file is a loud
# failure instead of a silent no-proxy run that dies later on the HF download.
# shellcheck source=/dev/null
source "$PWD/scripts/setup_proxy.sh"
echo "proxy: sourced scripts/setup_proxy.sh"
command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

JOB_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID="${JOB_ID%%.*}"
DIALOGUES_JSONL="${DIALOGUES_JSONL:-$PWD/screw_poc/artifacts/train_dialogues.jsonl}"
OUT_ROOT="${OUT_ROOT:-$PWD/screw_poc/artifacts/tts_1000}"
NUM_DIALOGUES="${NUM_DIALOGUES:-1000}"
NUM_SHARDS="${NUM_SHARDS:-4}"
SPARE_RATIO="${SPARE_RATIO:-0.15}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"
export TTS_DEVICE="${TTS_DEVICE:-cuda}"
export TTS_DTYPE="${TTS_DTYPE:-float16}"
export LEAD_IN_SEC="${LEAD_IN_SEC:-0.3}"
export GAP_SEC="${GAP_SEC:-0.2}"
export LOG_EVERY="${LOG_EVERY:-20}"

if ! [[ "$NUM_DIALOGUES" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: NUM_DIALOGUES must be a positive integer: $NUM_DIALOGUES" >&2
    exit 1
fi
if ! [[ "$NUM_SHARDS" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: NUM_SHARDS must be a positive integer: $NUM_SHARDS" >&2
    exit 1
fi
IFS=',' read -r -a GPU_IDS <<< "$CUDA_VISIBLE_DEVICES"
if [[ "${#GPU_IDS[@]}" -lt "$NUM_SHARDS" ]]; then
    echo "ERROR: $NUM_SHARDS shards require at least $NUM_SHARDS visible GPUs." >&2
    exit 1
fi

mkdir -p "$OUT_ROOT/logs" screw_poc/artifacts/pbs_logs
exec > >(tee -a "screw_poc/artifacts/pbs_logs/tts_1000_${JOB_ID}.log") 2>&1

echo "===== screw PoC Qwen3-TTS production ====="
echo "job_id:        ${PBS_JOBID:-n/a}"
echo "host:          $(hostname)"
echo "dialogues:     $DIALOGUES_JSONL"
echo "num_dialogues: $NUM_DIALOGUES"
echo "out_root:      $OUT_ROOT"
echo "num_shards:    $NUM_SHARDS"
echo "gpus:          $CUDA_VISIBLE_DEVICES"
echo "dtype:         $TTS_DTYPE"
echo "started_at:    $(date -Iseconds)"

echo "===== step 1/5: generate and validate text dialogues ====="
uv run python screw_poc/scripts/generate_dialogues.py --out-dir screw_poc/artifacts
uv run python screw_poc/scripts/build_training_subsets.py
uv run python screw_poc/scripts/validate_dataset.py "$DIALOGUES_JSONL"

SOURCE_ROWS="$(grep -c . "$DIALOGUES_JSONL" || true)"
if [[ "$SOURCE_ROWS" -lt "$NUM_DIALOGUES" ]]; then
    echo "ERROR: requested $NUM_DIALOGUES rows, but source has $SOURCE_ROWS." >&2
    exit 1
fi

echo "===== step 2/5: environment preflight ====="
uv run python - <<'PY'
import numpy  # noqa: F401
import qwen_tts  # noqa: F401
import sphn  # noqa: F401
import torchaudio  # noqa: F401
print("qwen_tts/torchaudio preflight ok")
PY
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

echo "===== step 3/5: split dialogues ====="
uv run python - "$DIALOGUES_JSONL" "$OUT_ROOT" "$NUM_SHARDS" "$NUM_DIALOGUES" "$SPARE_RATIO" <<'PY'
import json
import math
import sys
from pathlib import Path

source = Path(sys.argv[1])
out_root = Path(sys.argv[2])
num_shards = int(sys.argv[3])
limit = int(sys.argv[4])
spare_ratio = float(sys.argv[5])
rows = [line for line in source.read_text(encoding="utf-8").splitlines() if line.strip()][:limit]
if len(rows) != limit:
    raise SystemExit(f"selected {len(rows)} rows, expected {limit}")

summary = {"source": str(source), "selected": limit, "shards": []}
for shard_index in range(num_shards):
    shard_dir = out_root / f"shard_{shard_index:03d}"
    shard_dir.mkdir(parents=True, exist_ok=True)
    primary = [row for index, row in enumerate(rows) if index % num_shards == shard_index]
    spare_count = math.ceil(len(primary) * spare_ratio)
    start = (shard_index * 37) % len(rows)
    spares = [rows[(start + index) % len(rows)] for index in range(spare_count)]
    selected = primary + spares
    (shard_dir / "dialogues.jsonl").write_text(
        "\n".join(selected) + "\n", encoding="utf-8"
    )
    (shard_dir / "success_target.txt").write_text(
        f"{len(primary)}\n", encoding="utf-8"
    )
    summary["shards"].append(
        {"index": shard_index, "primary": len(primary), "spares": len(spares)}
    )
(out_root / "split_summary.json").write_text(
    json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
)
print(json.dumps(summary, ensure_ascii=False))
PY

echo "===== step 4/5: render shards in parallel ====="
pids=()
for ((shard_index = 0; shard_index < NUM_SHARDS; shard_index++)); do
    shard_tag="$(printf 'shard_%03d' "$shard_index")"
    shard_dir="$OUT_ROOT/$shard_tag"
    shard_training="$shard_dir/training_set"
    shard_log="$OUT_ROOT/logs/$shard_tag.log"
    gpu_id="${GPU_IDS[$shard_index]}"
    success_target="$(cat "$shard_dir/success_target.txt")"
    (
        set -euo pipefail
        args=(
            uv run python scripts/generate_qwen3_tts_data.py
            --tts-backend qwen3
            --model Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
            --dialogues-jsonl "$shard_dir/dialogues.jsonl"
            --out-dir "$shard_training"
            --success-target "$success_target"
            --resume
            --whole-utterance
            --no-opening-greeting
            --no-emotion
            --speaker-moshi Ono_Anna
            --speaker-user Serena
            --user-speaker-pool Serena,Sohee,Vivian,Dylan,Eric,Aiden,Uncle_Fu,Ryan
            --speaker-other Dylan
            --speaker-background Ryan
            --device "$TTS_DEVICE"
            --dtype "$TTS_DTYPE"
            --lead-in-sec "$LEAD_IN_SEC"
            --gap-sec "$GAP_SEC"
            --log-every "$LOG_EVERY"
        )
        CUDA_VISIBLE_DEVICES="$gpu_id" "${args[@]}"
        test -s "$shard_training/synthetic_moshi_train.jsonl"
    ) > "$shard_log" 2>&1 &
    pids+=("$!")
    echo "started $shard_tag on GPU $gpu_id; log=$shard_log"
done

failed=0
for pid in "${pids[@]}"; do
    if ! wait "$pid"; then
        failed=1
    fi
done
if [[ "$failed" != "0" ]]; then
    echo "ERROR: at least one shard failed. See $OUT_ROOT/logs/." >&2
    exit 1
fi

echo "===== step 5/5: merge and verify ====="
uv run python scripts/merge_training_shards.py \
    --batch-dir "$OUT_ROOT" \
    --out-dir "$OUT_ROOT/merged" \
    --expected-shards "$NUM_SHARDS"
MERGED_MANIFEST="$OUT_ROOT/merged/training_set/synthetic_moshi_train.jsonl"
test -s "$MERGED_MANIFEST"
MERGED_ROWS="$(grep -c . "$MERGED_MANIFEST" || true)"
if [[ "$MERGED_ROWS" -ne "$NUM_DIALOGUES" ]]; then
    echo "ERROR: expected $NUM_DIALOGUES merged rows, found $MERGED_ROWS." >&2
    exit 1
fi
echo "merged_manifest: $MERGED_MANIFEST"
echo "merged_rows:     $MERGED_ROWS"

echo "===== chain: submit training ====="
# Self-chaining, in the style of scripts/run_train_chain.pbs: this job submits
# the training jobs itself, at the point where the merged manifest is known to
# exist.  The previous `qsub -W depend=afterok` form queued both training jobs
# up front, so a TTS failure left them held in the queue to be cleaned up by
# hand; here a failed TTS run never reaches this line and nothing is queued.
CHAIN_TRAIN="${CHAIN_TRAIN:-1}"
CHAIN_ENV="TTS_RUN_DIR=$OUT_ROOT/merged"

if [[ "$CHAIN_TRAIN" != "1" ]]; then
    echo "[chain] CHAIN_TRAIN=$CHAIN_TRAIN -- not submitting training."
elif ! command -v qsub >/dev/null 2>&1; then
    echo "[chain] WARNING: qsub is not available on this node, so training was" >&2
    echo "[chain] NOT submitted.  The TTS output is complete; chain it from the" >&2
    echo "[chain] login node with:" >&2
    echo "[chain]   TTS_RUN_DIR=$OUT_ROOT/merged bash screw_poc/pbs/submit_train_both.sh" >&2
else
    # -V carries the proxy settings and PATH of this job into the children;
    # lowercase -v then overrides what must differ per job, so neither training
    # job inherits this job's four-GPU CUDA_VISIBLE_DEVICES.  Each submission
    # runs inside `if` so a queue rejection reports itself instead of failing
    # a TTS run whose output is already on disk.
    if lora_job="$(qsub -V -v "${CHAIN_ENV},NPROC=1" screw_poc/pbs/run_train.pbs)"; then
        echo "[chain] LoRA:    $lora_job"
    else
        echo "[chain] ERROR: LoRA submission failed; submit run_train.pbs by hand." >&2
    fi
    if full_job="$(qsub -V -v "${CHAIN_ENV},NPROC=2" screw_poc/pbs/run_train_full.pbs)"; then
        echo "[chain] Full FT: $full_job"
    else
        echo "[chain] ERROR: Full-FT submission failed; submit run_train_full.pbs by hand." >&2
    fi
fi

echo "finished_at:     $(date -Iseconds)"
