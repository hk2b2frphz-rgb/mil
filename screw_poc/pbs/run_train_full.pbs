#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N screw_moshi_full
#PBS -q xan_s
#PBS -l select=1:res=middle
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# Full fine-tune Moshi with the same merged Qwen3-TTS data used by LoRA.
# Uses the repository's established nu-dialogue full-FT path on two A100 GPUs.
#
# Submit:
#   qsub -V screw_poc/pbs/run_train_full.pbs
# Override the dataset:
#   qsub -V -v TTS_RUN_DIR=screw_poc/artifacts/tts_0300/merged \
#     screw_poc/pbs/run_train_full.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

if [[ ! -f scripts/run_nu_fullft_experiment.sh ]]; then
    echo "ERROR: submit this job from the miltoka repository root." >&2
    exit 1
fi
# Proxy first, on every job, immediately after entering the node.  Sourced
# unconditionally (as scripts/_dag_stage.pbs does) so a missing file is a loud
# failure instead of a silent no-proxy run that dies later on the HF download.
# shellcheck source=/dev/null
source "$PWD/scripts/setup_proxy.sh"
echo "proxy: sourced scripts/setup_proxy.sh"
command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

JOB_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID="${JOB_ID%%.*}"
TTS_RUN_DIR="${TTS_RUN_DIR:-$PWD/screw_poc/artifacts/tts_1000/merged}"
MANIFEST="$TTS_RUN_DIR/training_set/synthetic_moshi_train.jsonl"
if [[ ! -s "$MANIFEST" ]]; then
    echo "ERROR: training manifest not found: $MANIFEST" >&2
    exit 1
fi

export NPROC="${NPROC:-2}"
# Do not inherit a stale one-GPU CUDA_VISIBLE_DEVICES through #PBS -V.
if [[ -n "${GPU_LIST:-}" ]]; then
    export CUDA_VISIBLE_DEVICES="$GPU_LIST"
else
    export CUDA_VISIBLE_DEVICES="$(seq -s, 0 $((NPROC - 1)))"
fi
if [[ -f scripts/setup_pbs_distributed.sh ]]; then
    # shellcheck source=/dev/null
    source scripts/setup_pbs_distributed.sh
fi

TTS_TAG="$(basename "$(dirname "$(realpath -m "$TTS_RUN_DIR")")")"
export RUN_ID="${RUN_ID:-screw_full_${TTS_TAG}_${JOB_ID}}"
export NU_DATA_DIR="${NU_DATA_DIR:-$PWD/screw_poc/artifacts/nu_fullft/$TTS_TAG}"
export REFRESH_NU_DATA="${REFRESH_NU_DATA:-0}"

# Existing full-FT baseline (f01): conservative LR and epoch-denominated
# schedule for small synthetic datasets.
export HP_LR="${HP_LR:-1e-5}"
export HP_WEIGHT_DECAY="${HP_WEIGHT_DECAY:-0.1}"
export HP_PCT_START="${HP_PCT_START:-0}"
export HP_BATCH_SIZE="${HP_BATCH_SIZE:-1}"
export HP_NUM_MICROBATCHES="${HP_NUM_MICROBATCHES:-8}"
export HP_DURATION_SEC="${HP_DURATION_SEC:-60}"
export HP_LOG_FREQ="${HP_LOG_FREQ:-5}"
export HP_MAX_NORM="${HP_MAX_NORM:-1.0}"
export HP_MAX_EPOCHS="${HP_MAX_EPOCHS:-12}"
export HP_WARMUP_EPOCHS="${HP_WARMUP_EPOCHS:-1}"
export HP_EVAL_EVERY_EPOCH="${HP_EVAL_EVERY_EPOCH:-0.5}"
export HP_CKPT_EVERY_EPOCH="${HP_CKPT_EVERY_EPOCH:-1}"

mkdir -p screw_poc/artifacts/pbs_logs "$NU_DATA_DIR"
exec > >(tee -a "screw_poc/artifacts/pbs_logs/train_full_${JOB_ID}.log") 2>&1

echo "===== screw PoC Moshi Full FT ====="
echo "job_id:       ${PBS_JOBID:-n/a}"
echo "host:         $(hostname)"
echo "tts_run_dir:  $TTS_RUN_DIR"
echo "manifest:     $MANIFEST"
echo "samples:      $(grep -c . "$MANIFEST" || true)"
echo "nproc:        $NPROC"
echo "cuda:         $CUDA_VISIBLE_DEVICES"
echo "nu_data:      $NU_DATA_DIR"
echo "lr:           $HP_LR"
echo "max_epochs:   $HP_MAX_EPOCHS"
echo "started_at:   $(date -Iseconds)"
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

bash scripts/run_nu_fullft_experiment.sh \
    "../screw_poc/experiments/fullft_base_config" \
    "$TTS_RUN_DIR"

echo "finished_at: $(date -Iseconds)"
