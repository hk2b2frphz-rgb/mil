#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N screw_0902_train_eval
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# A100 job: train the LoRA model, then run held-out screw audio inference and
# score the text response. Submit with an afterok dependency on data_dialogue_tts.pbs.
set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[[ -f screw_poc/scripts/run_train.sh ]] || { echo "ERROR: run from repository root" >&2; exit 1; }
[[ -f scripts/setup_proxy.sh ]] && source scripts/setup_proxy.sh

RUN_DATE="2026-09-02"
JOB_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"; JOB_ID="${JOB_ID%%.*}"
TTS_RUN_DIR="${TTS_RUN_DIR:-$PWD/screw_poc/artifacts/${RUN_DATE}_mixed_tts/merged}"
EVAL_SOURCE="${EVAL_SOURCE:-$PWD/screw_poc/artifacts/evaluation_dialogues.jsonl}"
EVAL_OUT="${EVAL_OUT:-$PWD/screw_poc/artifacts/${RUN_DATE}_heldout_${JOB_ID}}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export NPROC=1 REFRESH_EXP_DATA=1 SKIP_AUTO_EVAL=1
[[ -f scripts/setup_pbs_distributed.sh ]] && source scripts/setup_pbs_distributed.sh
[[ -s "$TTS_RUN_DIR/training_set/synthetic_moshi_train.jsonl" ]] || { echo "ERROR: missing TTS manifest" >&2; exit 1; }
[[ -s "$EVAL_SOURCE" ]] || { echo "ERROR: missing held-out dialogue data" >&2; exit 1; }
mkdir -p "$EVAL_OUT" screw_poc/artifacts/pbs_logs
exec > >(tee -a "screw_poc/artifacts/pbs_logs/${RUN_DATE}_train_eval_${JOB_ID}.log") 2>&1

echo "===== screw PoC ${RUN_DATE}: LoRA + held-out evaluation (A100) ====="
bash screw_poc/scripts/run_train.sh "$TTS_RUN_DIR"
MODEL_WEIGHT="$(find screw_poc/experiments/lora_base_config/merged -type f -name consolidated.safetensors -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
[[ -n "$MODEL_WEIGHT" && -f "$MODEL_WEIGHT" ]] || { echo "ERROR: LoRA merged model not found" >&2; exit 1; }

uv run python screw_poc/scripts/${RUN_DATE}/build_eval_inputs.py \
    --source "$EVAL_SOURCE" --out-dir "$EVAL_OUT" --limit "${EVAL_LIMIT:-48}" --device cuda --dtype float16
uv run python response_recorder.py --inputs "$EVAL_OUT/inputs" --out-dir "$EVAL_OUT/inference" \
    --moshi-weight "$MODEL_WEIGHT" --device cuda --half --seeds 0 --silence-sec 8 --max-gen-sec 30 --response-sec 15
uv run python - "$EVAL_OUT/reference.jsonl" "$EVAL_OUT/inference" "$EVAL_OUT/predictions.jsonl" <<'PY'
import json, sys
from pathlib import Path
reference, inference, out = map(Path, sys.argv[1:])
rows = [json.loads(line) for line in reference.read_text(encoding="utf-8").splitlines() if line]
predictions = []
for row in rows:
    path = inference / row["id"] / "seed_0" / "transcript.txt"
    if path.is_file(): predictions.append({"id": row["id"], "response_text": path.read_text(encoding="utf-8").strip()})
out.write_text("".join(json.dumps(row, ensure_ascii=False) + "\n" for row in predictions), encoding="utf-8")
PY
uv run python screw_poc/scripts/score_predictions.py "$EVAL_OUT/predictions.jsonl" --reference "$EVAL_OUT/reference.jsonl" | tee "$EVAL_OUT/score.json"
echo "TRAIN_EVAL_OK=$EVAL_OUT"
