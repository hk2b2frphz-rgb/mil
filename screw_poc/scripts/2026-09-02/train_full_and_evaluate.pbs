#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N screw_0902_train_full_eval
#PBS -q xan_s
#PBS -l select=1:res=middle
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# A100 x2 job: full fine-tune Moshi on the same 2026-09-02 mixed-TTS data the
# LoRA job uses, then run the same held-out screw evaluation on the result.
# This is the full fine-tuning counterpart of train_and_evaluate.pbs, so the
# two score.json files are directly comparable.
#
# Submit (after data_dialogue_tts.pbs has produced the dataset):
#   qsub -V screw_poc/scripts/2026-09-02/train_full_and_evaluate.pbs
#
# Or chained behind the TTS job:
#   tts_job=$(qsub -V screw_poc/scripts/2026-09-02/data_dialogue_tts.pbs)
#   qsub -V -W "depend=afterok:${tts_job}" screw_poc/scripts/2026-09-02/train_full_and_evaluate.pbs
#
# Training itself is scripts/run_nu_fullft_experiment.sh (the nu-dialogue
# full-FT path), the same one screw_poc/pbs/run_train_full.pbs uses. It clones
# and uv-syncs ../moshi-finetune-nu-dialogue on first use, so the job needs
# working network/proxy settings on its first run.
#
# Variables:
#   TTS_RUN_DIR=<dir>   Training data. Default:
#                        screw_poc/artifacts/2026-09-02_mixed_tts/merged
#   EVAL_OUT=<dir>      Evaluation output. Default:
#                        screw_poc/artifacts/2026-09-02_heldout_fullft_<job-id>
#   EVAL_LIMIT=<n>      Held-out queries. Default: 48 (same as the LoRA job).
#   SKIP_EVAL=1         Train only; score later with evaluate_only.pbs.
#   HP_*                Hyperparameters, same names as run_train_full.pbs.
#
# If the job hits the walltime during training, its checkpoints stay under
# screw_poc/experiments/fullft_base_config/checkpoints/. Evaluation on its own
# is always re-runnable with evaluate_only.pbs.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[[ -f scripts/run_nu_fullft_experiment.sh ]] || { echo "ERROR: run from repository root" >&2; exit 1; }
[[ -f scripts/setup_proxy.sh ]] && source scripts/setup_proxy.sh
# Python run as a file only gets that file's directory on sys.path, so anything
# under screw_poc/ importing scripts.* needs the repository root as well.
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"
command -v uv >/dev/null 2>&1 || { echo "ERROR: uv is not available on PATH." >&2; exit 1; }

RUN_DATE="2026-09-02"
JOB_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"; JOB_ID="${JOB_ID%%.*}"
TTS_RUN_DIR="${TTS_RUN_DIR:-$PWD/screw_poc/artifacts/${RUN_DATE}_mixed_tts/merged}"
EVAL_SOURCE="${EVAL_SOURCE:-$PWD/screw_poc/artifacts/evaluation_dialogues.jsonl}"
EVAL_OUT="${EVAL_OUT:-$PWD/screw_poc/artifacts/${RUN_DATE}_heldout_fullft_${JOB_ID}}"
EXP_DIR="$PWD/screw_poc/experiments/fullft_base_config"

MANIFEST="$TTS_RUN_DIR/training_set/synthetic_moshi_train.jsonl"
[[ -s "$MANIFEST" ]] || { echo "ERROR: missing TTS manifest: $MANIFEST" >&2; exit 1; }
[[ -s "$EVAL_SOURCE" ]] || { echo "ERROR: missing held-out dialogue data: $EVAL_SOURCE" >&2; exit 1; }

# Two A100s, matching screw_poc/pbs/run_train_full.pbs. Do not inherit a stale
# single-GPU CUDA_VISIBLE_DEVICES through '#PBS -V'.
export NPROC="${NPROC:-2}"
if [[ -n "${GPU_LIST:-}" ]]; then
    export CUDA_VISIBLE_DEVICES="$GPU_LIST"
else
    export CUDA_VISIBLE_DEVICES="$(seq -s, 0 $((NPROC - 1)))"
fi
[[ -f scripts/setup_pbs_distributed.sh ]] && source scripts/setup_pbs_distributed.sh

TTS_TAG="$(basename "$(dirname "$(realpath -m "$TTS_RUN_DIR")")")"
export RUN_ID="${RUN_ID:-screw_full_${TTS_TAG}_${JOB_ID}}"
export NU_DATA_DIR="${NU_DATA_DIR:-$PWD/screw_poc/artifacts/nu_fullft/$TTS_TAG}"
export REFRESH_NU_DATA="${REFRESH_NU_DATA:-0}"
# The screw PoC scores itself with its own held-out set below, so skip the
# Full-Duplex-Bench-JA run that run_nu_fullft_experiment.sh would start.
export SKIP_AUTO_EVAL=1

# Same full-FT baseline as screw_poc/pbs/run_train_full.pbs.
export HP_LR="${HP_LR:-1e-5}"
export HP_WEIGHT_DECAY="${HP_WEIGHT_DECAY:-0.1}"
export HP_PCT_START="${HP_PCT_START:-0}"
export HP_BATCH_SIZE="${HP_BATCH_SIZE:-1}"
export HP_NUM_MICROBATCHES="${HP_NUM_MICROBATCHES:-8}"
export HP_DURATION_SEC="${HP_DURATION_SEC:-60}"
export HP_LOG_FREQ="${HP_LOG_FREQ:-5}"
export HP_MAX_NORM="${HP_MAX_NORM:-1.0}"
export HP_MAX_EPOCHS="${HP_MAX_EPOCHS:-12}"
export HP_WARMUP_EPOCHS="${HP_WARMUP_EPOCHS:-1}"
export HP_EVAL_EVERY_EPOCH="${HP_EVAL_EVERY_EPOCH:-0.5}"
export HP_CKPT_EVERY_EPOCH="${HP_CKPT_EVERY_EPOCH:-1}"

mkdir -p screw_poc/artifacts/pbs_logs "$NU_DATA_DIR"
exec > >(tee -a "screw_poc/artifacts/pbs_logs/${RUN_DATE}_train_full_eval_${JOB_ID}.log") 2>&1

echo "===== screw PoC ${RUN_DATE}: full fine-tuning + held-out evaluation (A100 x${NPROC}) ====="
echo "job_id:       ${PBS_JOBID:-n/a}"
echo "host:         $(hostname)"
echo "tts_run_dir:  $TTS_RUN_DIR"
echo "samples:      $(grep -c . "$MANIFEST" || true)"
echo "cuda:         $CUDA_VISIBLE_DEVICES"
echo "nu_data:      $NU_DATA_DIR"
echo "lr:           $HP_LR"
echo "max_epochs:   $HP_MAX_EPOCHS"
echo "eval_out:     $EVAL_OUT"
echo "started_at:   $(date -Iseconds)"
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi
echo "==============================================================================="

bash scripts/run_nu_fullft_experiment.sh \
    "../screw_poc/experiments/fullft_base_config" \
    "$TTS_RUN_DIR"

# run_nu_fullft_experiment.sh exports the best-eval-loss checkpoint as
# exported/<RUN_TS>_best/model.safetensors. '|| true': with pipefail a missing
# exported/ directory would abort before the explanatory error below.
MODEL_WEIGHT="$(find "$EXP_DIR/exported" -type f -name model.safetensors -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr | head -1 | cut -d' ' -f2- || true)"
if [[ -z "$MODEL_WEIGHT" || ! -f "$MODEL_WEIGHT" ]]; then
    echo "ERROR: full fine-tuned model was not exported under $EXP_DIR/exported" >&2
    echo "       Training may have stopped before the best checkpoint was selected." >&2
    exit 1
fi
echo "[full] exported model: $MODEL_WEIGHT"

if [[ "${SKIP_EVAL:-0}" == "1" ]]; then
    echo "[full] SKIP_EVAL=1: stopping before evaluation"
    echo "TRAIN_FULL_OK=$MODEL_WEIGHT"
    echo "finished_at: $(date -Iseconds)"
    exit 0
fi

# The evaluation is the same script the LoRA job uses, so both models are
# scored identically. It resumes, so a killed evaluation can be continued by
# submitting evaluate_only.pbs with this MODEL_WEIGHT and EVAL_OUT.
MODEL_WEIGHT="$MODEL_WEIGHT" EVAL_OUT="$EVAL_OUT" EVAL_SOURCE="$EVAL_SOURCE" \
    EVAL_LIMIT="${EVAL_LIMIT:-48}" CUDA_VISIBLE_DEVICES=0 \
    bash "screw_poc/scripts/${RUN_DATE}/evaluate_only.pbs"

echo "TRAIN_FULL_EVAL_OK=$EVAL_OUT"
echo "finished_at: $(date -Iseconds)"
