#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N screw_rag_repair
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -V

# One allocated job, with sequential shell steps. No dependent PBS jobs.
# Reinstall declared dependencies, reuse completed probe audio, then evaluate.
set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[[ -f screw_poc/scripts/moshi_rag/10_setup.pbs ]] || {
    echo "ERROR: run from repository root" >&2
    exit 1
}
# Repair the existing clone; do not delete or replace it.
export FORCE_CLONE=0
echo "[1/3] Repairing and verifying the MoshiRAG environment"
bash screw_poc/scripts/moshi_rag/10_setup.pbs
echo "[2/3] Running the reference probe (existing complete audio is reused)"
bash screw_poc/scripts/moshi_rag/20_reference_probe.pbs
echo "[3/3] Running CSV retrieval evaluation"
bash screw_poc/scripts/moshi_rag/30_table_retrieval.pbs
echo "===== repair and evaluation finished at $(date -Iseconds) ====="
