#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N fd_1000h
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V
#PBS -J 0-95

# Large-scale (~1000h) Japanese full-duplex training-data generation.
#
# Design:
#   - This is a PBS job array (-J 0-95). Each sub-job is one self-contained
#     shard that runs use_cases -> dialogues -> enrich -> audio on a single
#     V100 and writes to its own directory. Self-contained shards give
#     resumability (just re-submit failed indices) and avoid file collisions.
#   - With 8 V100s available, the scheduler runs 8 sub-jobs at a time and
#     queues the rest. 96 shards x 250 dialogues ~= 24000 dialogues. At an
#     estimated ~150s average dialogue length this is ~1000h of stereo audio.
#   - Data generation only. No fine-tuning is launched here.
#
# Submit:
#   qsub scripts/run_full_duplex_training_data_1000h.pbs
#
# Smaller pilot (one shard, to measure real throughput and audio length first):
#   qsub -J 0-0 scripts/run_full_duplex_training_data_1000h.pbs
#
# Recommended first: build the talking-point seed bank ONCE (content diversity).
# All shards read it read-only. Skipped automatically if the file is absent.
#   qsub scripts/build_content_seeds.pbs
#   # or directly:
#   uv run python scripts/build_content_seeds.py \
#     --out data/content_seeds/seeds.jsonl --num 3000 --gemma-dtype float16
#
# After all shards finish, merge into one manifest (CPU only, run on login node):
#   uv run python scripts/merge_training_shards.py \
#     --batch-dir data/runs/fd_1000h \
#     --out-dir   data/runs/fd_1000h/merged
#   # then fine-tune with: SRC_RUN_DIR=data/runs/fd_1000h/merged
#
# Useful overrides:
#   BATCH_ID=fd_1000h
#   DIALOGUES_PER_SHARD=250
#   BASE_SEED=0
#   LISTENING_RATIO=0.7
#   GAP_SEC=0.2
#   LEAD_IN_SEC=0.3
#   GEMMA_MODEL=google/gemma-4-E2B-it
#   QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

SHARD_INDEX="${PBS_ARRAY_INDEX:-0}"
BATCH_ID="${BATCH_ID:-fd_1000h}"
DIALOGUES_PER_SHARD="${DIALOGUES_PER_SHARD:-250}"
BASE_SEED="${BASE_SEED:-0}"

if ! [[ "$BATCH_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: BATCH_ID may contain only letters, digits, dot, underscore, hyphen." >&2
    exit 1
fi
if ! [[ "$DIALOGUES_PER_SHARD" =~ ^[0-9]+$ ]] || [[ "$DIALOGUES_PER_SHARD" -lt 1 ]]; then
    echo "ERROR: DIALOGUES_PER_SHARD must be a positive integer: $DIALOGUES_PER_SHARD" >&2
    exit 1
fi

SHARD_TAG="$(printf 'shard_%03d' "$SHARD_INDEX")"

export RUN_ID="${BATCH_ID}/${SHARD_TAG}"
export OUT_ROOT="$PWD/data/runs/${BATCH_ID}/${SHARD_TAG}"
export NUM_CASES="$DIALOGUES_PER_SHARD"
export SEED="$(( BASE_SEED + SHARD_INDEX ))"
export FULL_DUPLEX_TASKS="${FULL_DUPLEX_TASKS:-all}"
export STEPS="${STEPS:-use_cases,dialogues,enrich,audio}"
export LISTENING_RATIO="${LISTENING_RATIO:-0.7}"
export GAP_SEC="${GAP_SEC:-0.2}"
export LEAD_IN_SEC="${LEAD_IN_SEC:-0.3}"
# Shared talking-point bank (read-only). Built once by build_content_seeds.pbs.
# If the file does not exist, generation proceeds without content seeds.
export CONTENT_SEEDS="${CONTENT_SEEDS:-$PWD/data/content_seeds/seeds.jsonl}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

# V100 does not support bfloat16 efficiently. Both generators run on one GPU.
export GEMMA_DTYPE="${GEMMA_DTYPE:-float16}"
export TTS_DTYPE="${TTS_DTYPE:-float16}"
export TTS_DEVICE="${TTS_DEVICE:-cuda}"
# A single subprocess generates all dialogues in the shard, so allow a long
# timeout. 250 dialogues fit comfortably under this bound.
export GEMMA_TIMEOUT_SEC="${GEMMA_TIMEOUT_SEC:-21600}"

mkdir -p experiments/pbs_logs
JOB_LOG="experiments/pbs_logs/fd_1000h_${BATCH_ID}_${SHARD_TAG}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== Full-duplex 1000h shard ====="
echo "job_id:        ${PBS_JOBID:-n/a}"
echo "array_index:   ${SHARD_INDEX}"
echo "batch_id:      ${BATCH_ID}"
echo "shard:         ${SHARD_TAG}"
echo "host:          $(hostname)"
echo "run_id:        ${RUN_ID}"
echo "out_root:      ${OUT_ROOT}"
echo "num_cases:     ${NUM_CASES}"
echo "seed:          ${SEED}"
echo "listening:     ${LISTENING_RATIO}"
echo "gap_sec:       ${GAP_SEC}"
echo "gemma_dtype:   ${GEMMA_DTYPE}"
echo "tts_dtype:     ${TTS_DTYPE}"
echo "started_at:    $(date -Iseconds)"
echo "==================================="

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
else
    echo "WARN: nvidia-smi is not available on PATH."
fi

bash scripts/run_full_duplex_training_data.sh

MANIFEST="$OUT_ROOT/training_set/synthetic_moshi_train.jsonl"
if [[ ! -s "$MANIFEST" ]]; then
    echo "ERROR: training manifest was not created: $MANIFEST" >&2
    exit 1
fi
echo "manifest:      $MANIFEST"
echo "finished_at:   $(date -Iseconds)"
