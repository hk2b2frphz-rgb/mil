#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N qwen_tts_vllm_1000
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# Qwen3-TTS vLLM-Omni production, 1000-dialogue corpus.
#
# Mixed voices (user=CustomVoice, moshi=clone_voice_examples result):
#   QWEN_VOICE_MODE=mixed \
#   CLONE_OUT_DIR_MOSHI=data/clone_examples/<moshi-result> \
#   USER_SPEAKER_POOL=Ono_Anna \
#   qsub -V scripts/run_qwen_tts_vllm_1000_4gpu.pbs
#
# Comfortably inside one 24h reservation, but re-submitting resumes either way.

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
export SOURCE_BATCH_ID="${SOURCE_BATCH_ID:-qwen_dialogues_1000_${DIALOGUES_VERSION:-v1}}"
exec bash scripts/run_qwen_tts_vllm_common.sh
