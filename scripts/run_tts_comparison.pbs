#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N tts_compare
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

# TTS smoke phase: one self-contained small-GPU job, no manual audio.
#
# CLUSTER TODO: confirm that `select=1:res=small` is the local small GPU
# allocation string. If the site requires an explicit GPU count, replace the
# directive above (for example with the site's equivalent of
# `select=1:res=small:ngpus=1`) before submitting.
#
# Submit:
#   qsub -V scripts/run_tts_comparison.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

export BATCH_ID="${BATCH_ID:-tts_comparison}"
export OUT_ROOT="${OUT_ROOT:-$PWD/data/runs/$BATCH_ID}"
export COMPARE_OUT="${COMPARE_OUT:-$OUT_ROOT/listening}"
export REFS_DIR="${REFS_DIR:-$OUT_ROOT/shared_refs}"
export REFS_JSON="$REFS_DIR/refs.json"
export VENDOR_DIR="${VENDOR_DIR:-$OUT_ROOT/vendor}"
export COSYVOICE_REPO="${COSYVOICE_REPO:-$VENDOR_DIR/CosyVoice}"
export COSYVOICE_GIT_REF="${COSYVOICE_GIT_REF:-main}"
export TTS_DEVICE="${TTS_DEVICE:-cuda}"
export TTS_DTYPE="${TTS_DTYPE:-float16}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

mkdir -p "$COMPARE_OUT" "$REFS_DIR" "$VENDOR_DIR" experiments/pbs_logs
exec > >(tee -a "experiments/pbs_logs/${BATCH_ID}.log") 2>&1

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

echo "===== TTS smoke ====="
echo "job_id:       ${PBS_JOBID:-n/a}"
echo "host:         $(hostname)"
echo "out_root:     $OUT_ROOT"
echo "comparison:   $COMPARE_OUT"
echo "references:   $REFS_JSON"
echo "cuda_visible: $CUDA_VISIBLE_DEVICES"
echo "started_at:   $(date -Iseconds)"
echo "=========================="

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

# Preflight: run the TTS smoke tests in the project env before any heavy model
# loading. Keep this scoped to TTS so unrelated training dependencies do not
# block a listening smoke job.
echo "===== step 0/5: preflight tests (fail fast before heavy GPU work) ====="
uv run --with pytest python -m pytest tests/test_tts_comparison.py -q

echo "===== step 1/5: shared Qwen3 reference voices ====="
CUDA_VISIBLE_DEVICES=0 uv run python scripts/build_moss_reference_voices.py \
    --out-dir "$REFS_DIR" \
    --model "${QWEN_TTS_MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice}" \
    --device "$TTS_DEVICE" \
    --dtype "$TTS_DTYPE"

TORCH_VERSION="$(uv run python -c 'import torch; print(torch.__version__)')"
TORCHAUDIO_VERSION="$(uv run python -c 'import torchaudio; print(torchaudio.__version__)')"
COMMON_ARGS=(
    --dialogues-jsonl
    "$PWD/tests/fixtures/listening_dialogues.jsonl"
    "$PWD/tests/fixtures/aizuchi_dialogues.jsonl"
    --refs-json "$REFS_JSON"
    --out-dir "$COMPARE_OUT"
    --device "$TTS_DEVICE"
    --dtype "$TTS_DTYPE"
)

QWEN_UV=(
    uv run --isolated --no-project
    --index "pytorch-cu121=https://download.pytorch.org/whl/cu121"
    --with qwen-tts
    --with numpy
    --with scipy
    --with soundfile
    --with sphn
    --with "torch==$TORCH_VERSION"
    --with "torchaudio==$TORCHAUDIO_VERSION"
)

# CosyVoice has no stable official wheel. Rather than hand-maintaining a subset
# of its requirements (which keeps missing transitive imports like rich /
# matplotlib / pyarrow), we install directly from the repo's requirements.txt
# after checkout (see step 3) and only override the few things we must not take
# verbatim. This base array holds those overrides; the filtered requirements are
# appended via --with-requirements at step 4.
COSYVOICE_UV=(
    uv run --isolated --no-project
    --index "pytorch-cu121=https://download.pytorch.org/whl/cu121"
    # Use the cluster's cu121 torch build instead of CosyVoice's pinned 2.3.1.
    --with "torch==$TORCH_VERSION"
    --with "torchaudio==$TORCHAUDIO_VERSION"
    # CosyVoice pins openai-whisper==20231117 which requires triton==2.0.0 and
    # conflicts with the cu121 torch (triton 3.x). whisper is unused by
    # CosyVoice3 zero-shot / inference_instruct2, so take a recent unpinned one.
    --with "openai-whisper>=20240930"
    --with huggingface-hub
    --with sphn
)

KOKORO_UV=(
    uv run --isolated --no-project
    --index "pytorch-cu121=https://download.pytorch.org/whl/cu121"
    --with "kokoro>=0.9.4"
    --with "misaki[ja]"
    --with pyopenjtalk
    --with soundfile
    --with numpy
    --with sphn
    --with "torch==$TORCH_VERSION"
)

echo "===== step 2/5: qwen3 baseline ====="
CUDA_VISIBLE_DEVICES=0 "${QWEN_UV[@]}" python scripts/run_tts_comparison.py \
    "${COMMON_ARGS[@]}" \
    --backends qwen3

echo "===== step 3/5: prepare official CosyVoice checkout ====="
if [[ ! -d "$COSYVOICE_REPO/.git" ]]; then
    git clone --recursive https://github.com/FunAudioLLM/CosyVoice.git "$COSYVOICE_REPO"
fi
git -C "$COSYVOICE_REPO" checkout "$COSYVOICE_GIT_REF"
git -C "$COSYVOICE_REPO" submodule update --init --recursive

# Derive the inference dependency set from CosyVoice's own requirements.txt so we
# never miss a transitive import again. Strip only what must not be installed in
# this isolated env:
#   --extra-index-url lines  -> handled by --index
#   torch / torchaudio       -> cluster cu121 build (added in COSYVOICE_UV)
#   openai-whisper           -> old triton==2.0.0 pin; re-added unpinned above
#   onnxruntime== (CPU)      -> keep onnxruntime-gpu only
#   web/server/training-only -> deepspeed fastapi* gradio grpcio* tensorboard
#                               tensorrt* uvicorn (unneeded, heavy/conflicting)
COSYVOICE_REQ_SRC="$COSYVOICE_REPO/requirements.txt"
COSYVOICE_REQ="$OUT_ROOT/cosyvoice_requirements.inference.txt"
if [[ ! -f "$COSYVOICE_REQ_SRC" ]]; then
    echo "ERROR: $COSYVOICE_REQ_SRC not found; cannot derive CosyVoice deps." >&2
    exit 1
fi
grep -viE '^[[:space:]]*(--|torch==|torchaudio==|openai-whisper|onnxruntime==|deepspeed|fastapi|gradio|grpcio|tensorboard|tensorrt|uvicorn)' \
    "$COSYVOICE_REQ_SRC" > "$COSYVOICE_REQ"
echo "[cosyvoice] inference requirements derived at $COSYVOICE_REQ:"
cat "$COSYVOICE_REQ"

echo "===== step 4/5: CosyVoice3 ====="
CUDA_VISIBLE_DEVICES=1 COSYVOICE_REPO="$COSYVOICE_REPO" \
    "${COSYVOICE_UV[@]}" --with-requirements "$COSYVOICE_REQ" \
    python scripts/run_tts_comparison.py \
    "${COMMON_ARGS[@]}" \
    --backends cosyvoice3

echo "===== step 5/5: Kokoro ====="
CUDA_VISIBLE_DEVICES=1 "${KOKORO_UV[@]}" python scripts/run_tts_comparison.py \
    "${COMMON_ARGS[@]}" \
    --backends kokoro

echo "===== completed ====="
echo "Listening index: $COMPARE_OUT/INDEX.html"
echo "Markdown index:  $COMPARE_OUT/INDEX.md"
echo "Output tree:"
find "$COMPARE_OUT" -maxdepth 2 -type f -print | sort
echo "finished_at: $(date -Iseconds)"
