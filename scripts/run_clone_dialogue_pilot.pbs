#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N clone_dialogue_pilot
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# Synthesize ONE dialogue with both roles voice-cloned from real diarized
# speech, as a listening check before committing to a full run.
#
# Runs in the main uv project env through the qwen-tts package -- the same path
# clone_voice_examples.py already uses. It deliberately does NOT go through
# vLLM-Omni: batched clone inference there is only worth its setup cost at
# production scale, and this is a single dialogue.
#
# Submit (references re-selected from the diarization output):
#   qsub -v ANALYSIS_DIR=data/real_dialogue/<jobid>/<wav_stem> \
#        scripts/run_clone_dialogue_pilot.pbs
#
# Or reuse the exact references a previous clone_voice_examples.py run used
# (self-contained: reference.wav + manifest.json live in those directories):
#   qsub -v 'CLONE_OUT_DIR_USER=data/clone_examples/<a>,CLONE_OUT_DIR_MOSHI=data/clone_examples/<b>' \
#        scripts/run_clone_dialogue_pilot.pbs
#
# Optional:
#   USER_SPEAKER=A / MOSHI_SPEAKER=B  which diarized speaker plays which role.
#                                     CHECK THIS -- A/B is assigned by total
#                                     speaking time, not by role.
#   REF_RANK=0                        0 = ref00 (the longest clean segment)
#   CLONE_MODE=in-context|x-vector    x-vector clones timbre only, no transcript
#   SCRIPT_FILE=<path>                plain-text script, one turn per line:
#                                       user: ...
#                                       moshi: ...
#   DIALOGUES_JSONL=<path>            script to read; default = built-in
#   DIALOGUE_INDEX=0                  which dialogue in that JSONL
#   USER_REF_TEXT / MOSHI_REF_TEXT    fix a wrong reference transcript
#   USER_REF_WAV  / MOSHI_REF_WAV     pick the reference audio by hand
#   NO_OPENING_GREETING=1             drop the fixed moshi first line
#   STEREO_LEFT=user|moshi            which role goes to the left channel
#   OUT_DIR=data/clone_dialogue_pilot/<name>
#   EXTRA_ARGS="--gap-sec 0.6"        extra flags passed verbatim

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
    # shellcheck source=/dev/null
    source "$PWD/scripts/setup_proxy.sh"
fi

command -v uv >/dev/null 2>&1 || { echo "ERROR: uv not on PATH" >&2; exit 1; }

USER_SPEAKER="${USER_SPEAKER:-A}"
MOSHI_SPEAKER="${MOSHI_SPEAKER:-B}"
REF_RANK="${REF_RANK:-0}"
CLONE_MODE="${CLONE_MODE:-in-context}"

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
OUT_DIR="${OUT_DIR:-data/clone_dialogue_pilot/${JOB_ID_SHORT}}"

args=(
    uv run python scripts/clone_dialogue_pilot.py
    --out-dir "$OUT_DIR"
    --rank "$REF_RANK"
    --mode "$CLONE_MODE"
)
if [[ -n "${CLONE_OUT_DIR_USER:-}" || -n "${CLONE_OUT_DIR_MOSHI:-}" ]]; then
    # Both roles must come from somewhere; mixing one clone-out dir with an
    # analysis dir for the other is allowed, so only require what is missing.
    [[ -n "${CLONE_OUT_DIR_USER:-}" ]]  && args+=(--clone-out-dir-user "$CLONE_OUT_DIR_USER")
    [[ -n "${CLONE_OUT_DIR_MOSHI:-}" ]] && args+=(--clone-out-dir-moshi "$CLONE_OUT_DIR_MOSHI")
fi
if [[ -n "${ANALYSIS_DIR:-}" ]]; then
    args+=(
        --analysis-dir "$ANALYSIS_DIR"
        --user-speaker "$USER_SPEAKER"
        --moshi-speaker "$MOSHI_SPEAKER"
    )
elif [[ -z "${CLONE_OUT_DIR_USER:-}" || -z "${CLONE_OUT_DIR_MOSHI:-}" ]]; then
    echo "ERROR: set ANALYSIS_DIR, or both CLONE_OUT_DIR_USER and CLONE_OUT_DIR_MOSHI" >&2
    exit 1
fi
if [[ -n "${SCRIPT_FILE:-}" ]]; then
    args+=(--script-file "$SCRIPT_FILE")
elif [[ -n "${DIALOGUES_JSONL:-}" ]]; then
    args+=(--dialogues-jsonl "$DIALOGUES_JSONL" --dialogue-index "${DIALOGUE_INDEX:-0}")
fi
# Transcript fixes for the reference audio (whisper output is not always right).
[[ -n "${USER_REF_TEXT:-}" ]]  && args+=(--user-ref-text "$USER_REF_TEXT")
[[ -n "${MOSHI_REF_TEXT:-}" ]] && args+=(--moshi-ref-text "$MOSHI_REF_TEXT")
[[ -n "${USER_REF_WAV:-}" ]]   && args+=(--user-ref-wav "$USER_REF_WAV")
[[ -n "${MOSHI_REF_WAV:-}" ]]  && args+=(--moshi-ref-wav "$MOSHI_REF_WAV")
[[ -n "${STEREO_LEFT:-}" ]]    && args+=(--stereo-left "$STEREO_LEFT")
[[ -n "${NO_OPENING_GREETING:-}" ]] && args+=(--no-opening-greeting)

mkdir -p "$OUT_DIR"
LOG_FILE="${LOG_FILE:-$OUT_DIR/run.log}"
export PYTHONUNBUFFERED=1

{
    echo "===== clone dialogue pilot ====="
    echo "job:      ${JOB_ID_RAW}"
    echo "started:  $(date -Is)"
    echo "mode:     $CLONE_MODE (rank=$REF_RANK)"
    echo "out_dir:  $OUT_DIR"
    echo "log:      $LOG_FILE"
} | tee "$LOG_FILE"

# shellcheck disable=SC2086
"${args[@]}" ${EXTRA_ARGS:-} 2>&1 | tee -a "$LOG_FILE"

echo "done: $OUT_DIR/dialogue_stereo.wav (log: $LOG_FILE)" | tee -a "$LOG_FILE"
