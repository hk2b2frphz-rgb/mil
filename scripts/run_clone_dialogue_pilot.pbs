#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N clone_dialogue_pilot
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# Render a few dialogues with both roles voice-cloned from real diarized speech,
# through the production renderer -- whole-utterance synthesis + CTC forced
# alignment + timeline placement, exactly what a full run does. The point is
# for the listening check to have the same prosody the training data will,
# rather than a turn-by-turn approximation of it.
#
# Runs in the main uv project env (transformers engine, qwen-tts package), so
# it does not wait on the vLLM-Omni build. vLLM only buys cross-dialogue
# batching, which is meaningless for a single dialogue.
#
# Submit (references re-selected from the diarization output):
#   qsub -v ANALYSIS_DIR=data/real_dialogue/<jobid>/<wav_stem> \
#        scripts/run_clone_dialogue_pilot.pbs
#
# Or reuse the exact references a previous clone_voice_examples.py run used:
#   qsub -v 'CLONE_OUT_DIR_USER=data/clone_examples/<a>,CLONE_OUT_DIR_MOSHI=data/clone_examples/<b>' \
#        scripts/run_clone_dialogue_pilot.pbs
#
# Mixed production check (user=CustomVoice, moshi=clone):
#   qsub -v 'QWEN_VOICE_MODE=mixed,CLONE_OUT_DIR_MOSHI=data/clone_examples/<b>,USER_SPEAKER_POOL=Ono_Anna' \
#        scripts/run_clone_dialogue_pilot.pbs
#
# Optional:
#   USER_SPEAKER=A / MOSHI_SPEAKER=B  which diarized speaker plays which role.
#                                     CHECK THIS -- A/B is assigned by total
#                                     speaking time, not by role.
#   REF_RANK=0                        0 = ref00 (the longest clean segment)
#   CLONE_MODE=in-context|x-vector    x-vector clones timbre only, no transcript
#   DIALOGUES_JSONL=<path>            script source; default = built-in templates
#   NUM_DIALOGUES=3                   how many dialogues to render (default 3)
#   DIALOGUE_INDEX=0                  where to start in that JSONL (0-based)
#   USER_REF_TEXT / MOSHI_REF_TEXT    fix a wrong reference transcript
#   USER_REF_WAV  / MOSHI_REF_WAV     pick the reference audio by hand
#   GREETING_CACHE=1                  reuse the cached opening line instead of
#                                     re-synthesizing it (production behaviour)
#   OUT_DIR=data/clone_dialogue_pilot/<name>
#   EXTRA_ARGS="--gap-sec 0.6"        extra flags passed verbatim
#
# For a quicker, lower-fidelity check (turn-by-turn, no alignment) run
# scripts/clone_dialogue_pilot.py directly instead.

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
    # shellcheck source=/dev/null
    source "$PWD/scripts/setup_proxy.sh"
fi

command -v uv >/dev/null 2>&1 || { echo "ERROR: uv not on PATH" >&2; exit 1; }

USER_SPEAKER="${USER_SPEAKER:-A}"
MOSHI_SPEAKER="${MOSHI_SPEAKER:-B}"
REF_RANK="${REF_RANK:-0}"
CLONE_MODE="${CLONE_MODE:-in-context}"
QWEN_VOICE_MODE="${QWEN_VOICE_MODE:-auto}"

# ANALYSIS_DIR can supply both role references. Role-specific folders/WAVs are
# otherwise used to infer auto: moshi-only=mixed, both=full clone.
resolve_pilot_voice_mode() {
    local requested="$QWEN_VOICE_MODE"
    local analysis=0 moshi_audio=0 user_audio=0
    local moshi_any=0 user_any=0 user_explicit=0
    [[ -n "${ANALYSIS_DIR:-}" ]] && analysis=1
    [[ "$analysis" == "1" || -n "${CLONE_OUT_DIR_MOSHI:-}${MOSHI_REF_WAV:-}" ]] \
        && moshi_audio=1
    [[ "$analysis" == "1" || -n "${CLONE_OUT_DIR_USER:-}${USER_REF_WAV:-}" ]] \
        && user_audio=1
    [[ "$moshi_audio" == "1" || -n "${MOSHI_REF_TEXT:-}" ]] && moshi_any=1
    [[ "$user_audio" == "1" || -n "${USER_REF_TEXT:-}" ]] && user_any=1
    [[ -n "${CLONE_OUT_DIR_USER:-}${USER_REF_WAV:-}${USER_REF_TEXT:-}" ]] \
        && user_explicit=1

    if [[ "$moshi_any" == "1" && "$moshi_audio" == "0" ]]; then
        echo "ERROR: MOSHI_REF_TEXT was set without a moshi reference source" >&2
        return 1
    fi
    if [[ "$user_any" == "1" && "$user_audio" == "0" ]]; then
        echo "ERROR: USER_REF_TEXT was set without a user reference source" >&2
        return 1
    fi

    case "$requested" in
        auto)
            if [[ "$moshi_audio" == "1" && "$user_audio" == "1" ]]; then
                printf 'clone'
            elif [[ "$moshi_audio" == "1" ]]; then
                printf 'mixed'
            elif [[ "$user_audio" == "1" ]]; then
                echo "ERROR: a user clone source without a moshi clone source is unsupported" >&2
                return 1
            else
                echo "ERROR: set ANALYSIS_DIR or at least a moshi clone reference source" >&2
                return 1
            fi
            ;;
        mixed)
            if [[ "$moshi_audio" == "0" || "$user_explicit" == "1" ]]; then
                echo "ERROR: QWEN_VOICE_MODE=mixed needs only a moshi clone source" >&2
                return 1
            fi
            printf 'mixed'
            ;;
        clone)
            if [[ "$moshi_audio" == "0" || "$user_audio" == "0" ]]; then
                echo "ERROR: QWEN_VOICE_MODE=clone needs both role references" >&2
                return 1
            fi
            printf 'clone'
            ;;
        *)
            echo "ERROR: QWEN_VOICE_MODE must be auto, clone, or mixed: $requested" >&2
            return 1
            ;;
    esac
}
QWEN_VOICE_MODE="$(resolve_pilot_voice_mode)"
if [[ "$QWEN_VOICE_MODE" == "mixed" ]]; then
    QWEN_TTS_MODEL="${QWEN_TTS_MODEL:-${MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice}}"
else
    QWEN_TTS_MODEL="${QWEN_TTS_MODEL:-${MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-Base}}"
fi
QWEN_CLONE_MODEL="${QWEN_CLONE_MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-Base}"
USER_SPEAKER_POOL="${USER_SPEAKER_POOL:-Ono_Anna}"
DIALOGUE_INDEX="${DIALOGUE_INDEX:-0}"
NUM_DIALOGUES="${NUM_DIALOGUES:-3}"

if ! [[ "$NUM_DIALOGUES" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: NUM_DIALOGUES must be a positive integer: $NUM_DIALOGUES" >&2
    exit 1
fi
if ! [[ "$DIALOGUE_INDEX" =~ ^[0-9]+$ ]]; then
    echo "ERROR: DIALOGUE_INDEX must be a non-negative integer: $DIALOGUE_INDEX" >&2
    exit 1
fi

if [[ "$CLONE_MODE" != "in-context" && "$CLONE_MODE" != "x-vector" ]]; then
    echo "ERROR: CLONE_MODE must be in-context or x-vector: $CLONE_MODE" >&2
    exit 1
fi
if [[ "$CLONE_MODE" == "in-context" ]]; then
    if [[ -n "${MOSHI_REF_WAV:-}" && -z "${MOSHI_REF_TEXT:-}" ]]; then
        echo "ERROR: MOSHI_REF_TEXT is required with an explicit MOSHI_REF_WAV in in-context mode" >&2
        exit 1
    fi
    if [[ "$QWEN_VOICE_MODE" == "clone" \
          && -n "${USER_REF_WAV:-}" && -z "${USER_REF_TEXT:-}" ]]; then
        echo "ERROR: USER_REF_TEXT is required with an explicit USER_REF_WAV in in-context mode" >&2
        exit 1
    fi
fi

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
OUT_DIR="${OUT_DIR:-data/clone_dialogue_pilot/${JOB_ID_SHORT}}"
mkdir -p "$OUT_DIR"

# Resolve one reference per role. Each field is fetched separately so the
# Japanese transcript never has to survive shell word splitting.
resolve() {  # resolve <field> <role>
    local field="$1" role="$2"
    local -a src=()
    local clone_out speaker
    if [[ "$role" == "user" ]]; then
        clone_out="${CLONE_OUT_DIR_USER:-}"; speaker="$USER_SPEAKER"
    else
        clone_out="${CLONE_OUT_DIR_MOSHI:-}"; speaker="$MOSHI_SPEAKER"
    fi
    if [[ -n "$clone_out" ]]; then
        src=(--clone-out-dir "$clone_out" --mode "$CLONE_MODE")
    else
        if [[ -z "${ANALYSIS_DIR:-}" ]]; then
            echo "ERROR: no $role source is available to resolve $field" >&2
            return 1
        fi
        src=(--analysis-dir "$ANALYSIS_DIR" --speaker "$speaker")
    fi
    uv run python scripts/resolve_clone_refs.py "${src[@]}" \
        --rank "$REF_RANK" --field "$field"
}

REF_WAV_MOSHI="${MOSHI_REF_WAV:-$(resolve wav moshi)}"
if [[ "$QWEN_VOICE_MODE" == "clone" ]]; then
    REF_WAV_USER="${USER_REF_WAV:-$(resolve wav user)}"
fi

gen_args=(
    uv run python scripts/generate_qwen3_tts_data.py
    --out-dir "$OUT_DIR"
    --tts-backend qwen3
    --qwen-engine transformers
    --whole-utterance
    --qwen-voice-mode "$QWEN_VOICE_MODE"
    --model "$QWEN_TTS_MODEL"
    --qwen-clone-model "$QWEN_CLONE_MODEL"
    --device cuda
    --dtype float16
    --num-dialogues "$NUM_DIALOGUES"
    --qwen-clone-ref-audio-moshi "$REF_WAV_MOSHI"
)
if [[ "$QWEN_VOICE_MODE" == "clone" ]]; then
    # Full clone has one reference per role, so preset rotation must be off.
    gen_args+=(
        --user-speaker-pool ''
        --qwen-clone-ref-audio-user "$REF_WAV_USER"
    )
else
    gen_args+=(--user-speaker-pool "$USER_SPEAKER_POOL")
fi
# Production caches the greeting so every shard emits a bit-identical opening
# line. For a listening check that only hides things: a cache entry rendered
# with an earlier reference (or with a preset voice) keeps being replayed in
# front of freshly cloned turns, which is exactly what makes the opening sound
# like a different voice. Re-synthesize it each submit unless asked otherwise.
if [[ -z "${GREETING_CACHE:-}" ]]; then
    gen_args+=(--opening-greeting-cache-dir '')
fi
if [[ "$CLONE_MODE" == "x-vector" ]]; then
    gen_args+=(--qwen-clone-x-vector-only)
else
    REF_TEXT_MOSHI="${MOSHI_REF_TEXT:-$(resolve text moshi)}"
    gen_args+=(--qwen-clone-ref-text-moshi "$REF_TEXT_MOSHI")
    if [[ "$QWEN_VOICE_MODE" == "clone" ]]; then
        REF_TEXT_USER="${USER_REF_TEXT:-$(resolve text user)}"
        gen_args+=(--qwen-clone-ref-text-user "$REF_TEXT_USER")
    fi
fi

# --num-dialogues takes the FIRST n, so DIALOGUE_INDEX is honoured by handing
# the renderer a JSONL that already starts where we want it to.
if [[ -n "${DIALOGUES_JSONL:-}" ]]; then
    SELECTED="$OUT_DIR/selected_dialogues.jsonl"
    awk -v s="$((DIALOGUE_INDEX + 1))" -v n="$NUM_DIALOGUES" \
        'NF { c++; if (c >= s && c < s + n) print; if (c >= s + n) exit }' \
        "$DIALOGUES_JSONL" > "$SELECTED"
    selected_count="$(grep -c . "$SELECTED" || true)"
    if [[ "$selected_count" -eq 0 ]]; then
        echo "ERROR: DIALOGUE_INDEX=$DIALOGUE_INDEX is out of range in $DIALOGUES_JSONL" >&2
        exit 1
    fi
    if [[ "$selected_count" -lt "$NUM_DIALOGUES" ]]; then
        echo "NOTE: only $selected_count dialogue(s) available from index $DIALOGUE_INDEX" >&2
    fi
    gen_args+=(--dialogues-jsonl "$SELECTED")
fi

LOG_FILE="${LOG_FILE:-$OUT_DIR/run.log}"
export PYTHONUNBUFFERED=1

{
    echo "===== clone dialogue pilot (production renderer) ====="
    echo "job:        ${JOB_ID_RAW}"
    echo "started:    $(date -Is)"
    echo "mode:       $CLONE_MODE (rank=$REF_RANK)"
    echo "voice_mode: $QWEN_VOICE_MODE"
    echo "dialogues:  $NUM_DIALOGUES from index $DIALOGUE_INDEX"
    echo "model:      $QWEN_TTS_MODEL"
    echo "clone_model:$QWEN_CLONE_MODEL"
    if [[ "$QWEN_VOICE_MODE" == "clone" ]]; then
        echo "user  ref:  $REF_WAV_USER"
    else
        echo "user voices:$USER_SPEAKER_POOL (CustomVoice)"
    fi
    echo "moshi ref:  $REF_WAV_MOSHI"
    echo "out_dir:    $OUT_DIR"
} | tee "$LOG_FILE"

# shellcheck disable=SC2086
"${gen_args[@]}" ${EXTRA_ARGS:-} 2>&1 | tee -a "$LOG_FILE"

echo "done: $OUT_DIR/data_stereo (log: $LOG_FILE)" | tee -a "$LOG_FILE"
