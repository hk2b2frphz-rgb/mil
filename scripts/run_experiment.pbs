#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N job_run
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe

# Full server job: generate synthetic data, then launch fine-tuning.
#
# Minimal submit:
#   qsub scripts/run_experiment.pbs
#
# Common submit with MLflow and hyperparameter overrides:
#   qsub -v NUM_CASES=250,MLFLOW_EXPERIMENT_NAME=dummy,HP_LR=5e-6,HP_LORA_RANK=64,HP_MAX_STEPS=800 scripts/run_experiment.pbs
#
# Use an existing generated dataset instead of generating a new one:
#   qsub -v SRC_RUN_DIR=./data/runs/<RUN_ID> scripts/run_experiment.pbs
#
# Optional variables:
#   BASE_EXP=exp001_lora_baseline
#   NUM_CASES=100
#   SRC_RUN_DIR=./data/runs/<RUN_ID>
#   HP_LR=2e-6
#   HP_LORA_RANK=32
#   HP_LORA_SCALING=2.0
#   HP_BATCH_SIZE=8
#   HP_NUM_MICROBATCHES=1
#   HP_MAX_STEPS=500
#   HP_CKPT_FREQ=50
#   HP_EVAL_FREQ=25
#   MLFLOW_EXPERIMENT_NAME=job_run
#   MLFLOW_RUN_NAME=run_<id>
#   MLFLOW_TRACKING_URI=file:/workspace/mlruns
#
# If res=small is not available on your PBS cluster, replace the select line
# above with the site's resource line.

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"

BASE_EXP="${BASE_EXP:-exp001_lora_baseline}"
NUM_CASES="${NUM_CASES:-100}"
NPROC="${NPROC:-1}"
INPUT_SRC_RUN_DIR="${SRC_RUN_DIR:-}"

if [[ -z "$INPUT_SRC_RUN_DIR" ]] && {
    ! [[ "$NUM_CASES" =~ ^[0-9]+$ ]] || [[ "$NUM_CASES" -lt 1 ]];
}; then
    echo "ERROR: NUM_CASES must be a positive integer. got: $NUM_CASES" >&2
    exit 1
fi

mkdir -p experiments/pbs_logs
JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
RUN_ID="run_${JOB_ID_SHORT}"
JOB_LOG="experiments/pbs_logs/${RUN_ID}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

export NPROC
export RUN_ID
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export MLFLOW_RUN_NAME="${MLFLOW_RUN_NAME:-$RUN_ID}"
export MLFLOW_EXPERIMENT_NAME="${MLFLOW_EXPERIMENT_NAME:-job_run}"

echo "===== job ====="
echo "job_id:     ${PBS_JOBID:-n/a}"
echo "job_name:   ${PBS_JOBNAME:-n/a}"
echo "host:       $(hostname)"
echo "workdir:    $(pwd)"
echo "run_id:     ${RUN_ID}"
echo "base_exp:   ${BASE_EXP}"
echo "num_cases:  ${NUM_CASES}"
echo "src_run_dir:${INPUT_SRC_RUN_DIR:-<generate new>}"
echo "job_log:    ${JOB_LOG}"
echo "nproc:      ${NPROC}"
echo "cuda:       ${CUDA_VISIBLE_DEVICES}"
echo "mlflow:     ${MLFLOW_EXPERIMENT_NAME:-off}"
echo "started_at: $(date -Iseconds)"
echo "==============="

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH. Load the server environment/module before qsub." >&2
    exit 1
}

if [[ -n "${MLFLOW_EXPERIMENT_NAME:-}" || -n "${MLFLOW_TRACKING_URI:-}" ]]; then
    if ! uv run python -c "import mlflow" >/dev/null 2>&1; then
        echo "mlflow is not installed in the project uv environment; installing it."
        uv pip install mlflow
    fi
fi

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
else
    echo "WARN: nvidia-smi is not available on PATH."
fi

echo
if [[ -n "$INPUT_SRC_RUN_DIR" ]]; then
    echo "[1/2] using existing data"
    SRC_RUN_DIR="$INPUT_SRC_RUN_DIR"
else
    echo "[1/2] generating data"
    RUN_ID="$RUN_ID" \
    NUM_CASES="$NUM_CASES" \
    STEPS=use_cases,dialogues,audio \
    bash scripts/run_pipeline.sh

    SRC_RUN_DIR="./data/runs/${RUN_ID}"
fi

if [[ ! -f "$SRC_RUN_DIR/training_set/synthetic_moshi_train.jsonl" ]]; then
    echo "ERROR: training manifest not found: $SRC_RUN_DIR/training_set/synthetic_moshi_train.jsonl" >&2
    exit 1
fi

echo
echo "[2/2] fine-tuning"
bash scripts/run_experiment.sh "$BASE_EXP" "$SRC_RUN_DIR"

echo "finished_at: $(date -Iseconds)"
