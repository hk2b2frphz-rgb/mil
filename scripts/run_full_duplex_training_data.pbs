#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N fd_train_data
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# Generate domain-bounded Japanese full-duplex training data.
#
# Default:
#   qsub scripts/run_full_duplex_training_data.pbs
#
# Smaller smoke run:
#   qsub -v NUM_CASES=14 scripts/run_full_duplex_training_data.pbs
#
# Selected tasks:
#   qsub -v \
# FULL_DUPLEX_TASKS=pause_handling,user_interruption,user_backchannel,\
# NUM_CASES=60 \
# scripts/run_full_duplex_training_data.pbs
#
# Resume individual stages:
#   qsub -v \
# RUN_ID=fd_train_<existing-id>,\
# STEPS=audio \
# scripts/run_full_duplex_training_data.pbs
#
# Useful overrides:
#   NUM_CASES=140
#   FULL_DUPLEX_TASKS=all
#   STEPS=use_cases,dialogues,audio
#   SEED=0
#   LLM_MODEL=google/gemma-4-E2B-it
#   QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
#   CUDA_VISIBLE_DEVICES=0

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh
# shellcheck source=/dev/null
source "$PWD/scripts/run_id_utils.sh"

export RUN_ID="${RUN_ID:-$(default_run_id fd_train)}"
export NUM_CASES="${NUM_CASES:-140}"
export FULL_DUPLEX_TASKS="${FULL_DUPLEX_TASKS:-all}"
export STEPS="${STEPS:-use_cases,dialogues,audio}"
export SEED="${SEED:-0}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export OUT_ROOT="${OUT_ROOT:-$PWD/data/runs/$RUN_ID}"

# V100 does not support bfloat16 efficiently. Both generators run sequentially
# on the same GPU, so one device is sufficient.
export LLM_DTYPE="${LLM_DTYPE:-float16}"
export TTS_DTYPE="${TTS_DTYPE:-float16}"
export TTS_DEVICE="${TTS_DEVICE:-cuda}"

if ! [[ "$NUM_CASES" =~ ^[0-9]+$ ]] || [[ "$NUM_CASES" -lt 1 ]]; then
    echo "ERROR: NUM_CASES must be a positive integer: $NUM_CASES" >&2
    exit 1
fi
if ! [[ "$RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: RUN_ID may contain only letters, digits, dot, underscore, and hyphen." >&2
    exit 1
fi

mkdir -p experiments/pbs_logs
JOB_LOG="experiments/pbs_logs/full_duplex_training_${RUN_ID}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== Full-duplex training-data PBS job ====="
echo "job_id:       ${PBS_JOBID:-n/a}"
echo "job_name:     ${PBS_JOBNAME:-n/a}"
echo "host:         $(hostname)"
echo "workdir:      $(pwd)"
echo "run_id:       $RUN_ID"
echo "num_cases:    $NUM_CASES"
echo "tasks:        $FULL_DUPLEX_TASKS"
echo "steps:        $STEPS"
echo "seed:         $SEED"
echo "out_root:     $OUT_ROOT"
echo "cuda:         $CUDA_VISIBLE_DEVICES"
echo "llm_dtype:  $LLM_DTYPE"
echo "tts_dtype:    $TTS_DTYPE"
echo "job_log:      $JOB_LOG"
echo "started_at:   $(date -Iseconds)"
echo "============================================="

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
else
    echo "WARN: nvidia-smi is not available on PATH."
fi

bash scripts/run_full_duplex_training_data.sh

MANIFEST="$OUT_ROOT/training_set/synthetic_moshi_train.jsonl"
if [[ ",$STEPS," == *,audio,* ]]; then
    if [[ ! -s "$MANIFEST" ]]; then
        echo "ERROR: training manifest was not created: $MANIFEST" >&2
        exit 1
    fi
    echo "manifest:      $MANIFEST"
    echo "fine-tune via: SRC_RUN_DIR=$OUT_ROOT"
else
    echo "audio stage was skipped; no manifest check performed."
fi

echo "finished_at:  $(date -Iseconds)"
