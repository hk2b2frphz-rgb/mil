#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N lora_lr_sweep
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
source scripts/setup_pbs_distributed.sh

export RUN_ID="${RUN_ID:-lora_lr_${JOB_ID_SHORT}}"
export SWEEP_PATTERNS="${SWEEP_PATTERNS:-lr_2e-6,lr_1p5e-6,lr_1e-6,lr_5e-7}"
export NUM_CASES="${NUM_CASES:-250}"
export MLFLOW_EXPERIMENT_NAME="${MLFLOW_EXPERIMENT_NAME:-job_lora_lr}"
export MLFLOW_TRACKING_URI="${MLFLOW_TRACKING_URI:-sqlite:///$PWD/mlruns/mlflow.db}"
export MLFLOW_ARTIFACT_ROOT="${MLFLOW_ARTIFACT_ROOT:-file:$PWD/mlruns/artifacts}"
export MLFLOW_LIVE_SYNC_INTERVAL="${MLFLOW_LIVE_SYNC_INTERVAL:-120}"

mkdir -p experiments/pbs_logs
exec > >(tee -a "experiments/pbs_logs/${RUN_ID}.log") 2>&1

# Which job file a chained handoff should resubmit. Patterns that do not
# fit in this walltime are handed to a fresh copy of this job instead of
# being silently dropped (scripts/sweep_chain.sh). Disable with SWEEP_CHAIN=0.
export SELF_PBS="${SELF_PBS:-scripts/lora_lr_sweep.pbs}"

bash scripts/run_sweep_pair.sh
