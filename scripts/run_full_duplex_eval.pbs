#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N fdb_ja
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

# V100 server-side evaluation. This job never calls OpenAI/Azure APIs.
#
# Base model:
#   qsub -v MODEL_ID=base scripts/run_full_duplex_eval.pbs
#
# Merged LoRA or exported full-FT model:
#   qsub -v MODEL_ID=lora_h01,MODEL_WEIGHT=/path/model.safetensors,MODEL_CONFIG=/path/moshi_lm_kwargs.json \
#     scripts/run_full_duplex_eval.pbs
#
# Useful overrides:
#   FDB_TASKS=pause_handling,smooth_turn_taking,user_interruption
#   FDB_SEEDS=0,1,2
#   FDB_TAIL_SEC=8
#   REFRESH_FDB_DATA=1

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
export RUN_ID="${RUN_ID:-${MODEL_ID:-model}_${JOB_ID_SHORT}}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export HALF="${HALF:-1}"

mkdir -p experiments/pbs_logs
exec > >(tee -a "experiments/pbs_logs/full_duplex_${RUN_ID}.log") 2>&1

echo "job_id:     ${PBS_JOBID:-n/a}"
echo "queue:      xvn_s"
echo "host:       $(hostname)"
echo "workdir:    $(pwd)"
echo "run_id:     $RUN_ID"
echo "cuda:       $CUDA_VISIBLE_DEVICES"

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

bash scripts/run_full_duplex_eval.sh
