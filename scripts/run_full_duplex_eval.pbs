#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N fdb_ja
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

# V100 server-side evaluation. This job never calls OpenAI/Azure APIs.
#
# Base model:
#   qsub -v MODEL_ID=base scripts/run_full_duplex_eval.pbs
#
# Merged LoRA or exported full-FT model:
#   qsub -v MODEL_ID=lora_h01,MODEL_WEIGHT=/path/model.safetensors,MODEL_CONFIG=/path/moshi_lm_kwargs.json \
#     scripts/run_full_duplex_eval.pbs
#
# Useful overrides:
#   FDB_TASKS=pause_handling,smooth_turn_taking,user_interruption
#   FDB_CASES_PER_TASK=1 (smoke: first N cases from every selected task)
#   FDB_SEEDS=0,1,2
#   FDB_TAIL_SEC=8
#   FDB_TTS_BACKEND=qwen3
#   FDB_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
#   FDB_TTS_SPEAKER=Ono_Anna
#   FDB_TTS_BACKGROUND_SPEAKER=Uncle_Fu
#   FDB_DEVICE=cuda
#   FDB_DTYPE=float16
#   FDB_WHOLE_UTTERANCE=1 (default; requires torchaudio+uroman/pykakasi,
#     falls back to per-fragment synthesis with a warning if unavailable)
#   FDB_WHOLE_UTTERANCE_MAX_CHARS=150
#   FDB_BACKCHANNEL_GT=eval_sets/full_duplex_ja/backchannel_gt.json (default if
#     present; see eval/build_backchannel_gt.py -- this is a project-design
#     proxy distribution, not a human-annotated corpus)
#   FDB_OPENING_GREETING=1 (default; reserves silent lead-in for the model's
#     trained fixed opening line, see scripts/generate_qwen3_tts_data.py
#     OPENING_GREETING_TEXT. Set to 0 for base Moshi / llm-jp baselines,
#     which were never trained to say it. The dataset dir defaults to
#     data/full_duplex_ja_v2_greeting or _nogreeting depending on this flag,
#     so switching it can't silently reuse a mismatched cached dataset.)
#   FDB_OPENING_GREETING_GAP_SEC=0.4
#   FDB_OPENING_GREETING_CACHE_DIR=data/.cache/opening_greeting (default;
#     the fixed greeting audio itself is cached here and reused across
#     dataset (re)builds instead of resynthesizing every time)
#   REFRESH_FDB_DATA=1

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
export RUN_ID="${RUN_ID:-${MODEL_ID:-model}_${JOB_ID_SHORT}}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export HALF="${HALF:-1}"
export FDB_TTS_BACKEND="${FDB_TTS_BACKEND:-qwen3}"
export FDB_TTS_MODEL="${FDB_TTS_MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice}"
export FDB_TTS_SPEAKER="${FDB_TTS_SPEAKER:-Ono_Anna}"
export FDB_TTS_BACKGROUND_SPEAKER="${FDB_TTS_BACKGROUND_SPEAKER:-Uncle_Fu}"
export FDB_DEVICE="${FDB_DEVICE:-cuda}"
export FDB_DTYPE="${FDB_DTYPE:-float16}"
export FDB_WHOLE_UTTERANCE="${FDB_WHOLE_UTTERANCE:-1}"
export FDB_WHOLE_UTTERANCE_MAX_CHARS="${FDB_WHOLE_UTTERANCE_MAX_CHARS:-150}"
export FDB_OPENING_GREETING="${FDB_OPENING_GREETING:-1}"
export FDB_OPENING_GREETING_GAP_SEC="${FDB_OPENING_GREETING_GAP_SEC:-0.4}"

# Disable Triton / torch.compile -- V100 lacks support for many Triton kernels.
export TORCHINDUCTOR_DISABLE=1
export NO_TORCH_COMPILE="${NO_TORCH_COMPILE:-1}"
export TORCH_COMPILE_DISABLE=1

mkdir -p experiments/pbs_logs
exec > >(tee -a "experiments/pbs_logs/full_duplex_${RUN_ID}.log") 2>&1

echo "job_id:     ${PBS_JOBID:-n/a}"
echo "queue:      xvn_s"
echo "host:       $(hostname)"
echo "workdir:    $(pwd)"
echo "run_id:     $RUN_ID"
echo "cuda:       $CUDA_VISIBLE_DEVICES"

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

bash scripts/run_full_duplex_eval.sh
