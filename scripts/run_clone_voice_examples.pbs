#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N clone_voice
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# Zero-shot voice-clone a few example sentences with Qwen3-TTS, using a
# reference segment cut by analyze_real_dialogue.py (scripts/clone_voice_examples.py).
# Clone uses Qwen/Qwen3-TTS-12Hz-1.7B-Base (ungated) in-context mode, so the
# real speaker's own prosody/tension is preserved. Runs in the MAIN uv env
# (qwen-tts already lives there); no isolated env needed.
#
# Required:
#   qsub -v 'ANALYSIS_DIR=data/real_dialogue/<jobid>/<wav_stem>,SPEAKER=A' scripts/run_clone_voice_examples.pbs
#
# Optional:
#   OUT_DIR=data/clone_examples/<name>   (default: data/clone_examples/<jobid>)
#   NUM_REFS=3                           (auto-selected references to compare; default 3)
#   MODES=in-context,x-vector            (clone modes to sweep; default both)
#   CV_SPEAKER=Ono_Anna                  (CustomVoice preset speaker; default Ono_Anna)
#   NO_CUSTOMVOICE=1                     (skip the CustomVoice baseline)
#   NO_XVECTOR_ALL=1                     (skip the aggregated-x-vector combo)
#   XVECTOR_MAX_SEC=90                   (cap on concatenated reference seconds)
#   EXAMPLES_FILE=path/to/lines.txt      (one sentence per line; default: built-in)
#   REF_WAV=... REF_TEXT=...             (override auto-selected reference; forces 1 ref)
#   EXTRA_ARGS="..."                     (extra flags passed through verbatim)
#
# Sweeps NUM_REFS references x MODES clone modes (one subdir ref{k}_{mode} each)
# plus a CustomVoice preset baseline (customvoice_<speaker>/), so you can A/B
# clone vs the original preset voice.

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

SPEAKER="${SPEAKER:-A}"

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
OUT_DIR="${OUT_DIR:-data/clone_examples/${JOB_ID_SHORT}}"

mkdir -p "$OUT_DIR"
LOG_FILE="${LOG_FILE:-$OUT_DIR/run.log}"

{
    echo "===== clone voice examples ====="
    echo "job:      ${JOB_ID_RAW}"
    echo "started:  $(date -Is)"
    echo "speaker:  $SPEAKER"
    echo "analysis: ${ANALYSIS_DIR:-<none>}"
    echo "out_dir:  $OUT_DIR"
    echo "log:      $LOG_FILE"
} | tee "$LOG_FILE"

# Unbuffered so `tail -f run.log` follows model load / synthesis progress live.
export PYTHONUNBUFFERED=1
# shellcheck disable=SC2086
uv run python -u scripts/clone_voice_examples.py \
    ${ANALYSIS_DIR:+--analysis-dir "$ANALYSIS_DIR"} \
    --speaker "$SPEAKER" \
    --out-dir "$OUT_DIR" \
    ${NUM_REFS:+--num-refs "$NUM_REFS"} \
    ${MODES:+--modes "$MODES"} \
    ${CV_SPEAKER:+--customvoice-speaker "$CV_SPEAKER"} \
    ${NO_CUSTOMVOICE:+--no-customvoice} \
    ${NO_XVECTOR_ALL:+--no-xvector-all} \
    ${XVECTOR_MAX_SEC:+--xvector-max-sec "$XVECTOR_MAX_SEC"} \
    ${EXAMPLES_FILE:+--examples-file "$EXAMPLES_FILE"} \
    ${REF_WAV:+--ref-wav "$REF_WAV"} \
    ${REF_TEXT:+--ref-text "$REF_TEXT"} \
    ${EXTRA_ARGS:-} 2>&1 | tee -a "$LOG_FILE"

echo "done: $OUT_DIR (log: $LOG_FILE)" | tee -a "$LOG_FILE"
