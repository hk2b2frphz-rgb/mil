#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N clone_voice
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V

# Voice-synthesis test (clone + CustomVoice) driven by a YAML config.
# Copy the template, edit it (paths, proxy, params), and point CONFIG at it:
#   cp configs/voice_synth.example.yaml configs/voice_synth.local.yaml
#   qsub -v CONFIG=configs/voice_synth.local.yaml scripts/run_clone_voice_examples.pbs
#
# The config holds proxy, GPU orchestration, and all synthesis params (both
# clone and CustomVoice). qsub -v env vars still override individual config
# values. The combo plan is sharded across GPUs (one process per GPU); after
# all shards finish, a single --aggregate pass verifies completeness and writes
# index.json.
#
# Common qsub -v overrides (else taken from the config):
#   CONFIG=configs/voice_synth.local.yaml   (which config to use)
#   OUT_DIR=...  NUM_SHARDS=4  CUDA_VISIBLE_DEVICES=0,1,2,3
#   ANALYSIS_DIR=...  SPEAKER=A
#   EXTRA_ARGS="..."                        (extra flags passed verbatim)

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"

command -v uv >/dev/null 2>&1 || { echo "ERROR: uv not on PATH" >&2; exit 1; }

CONFIG="${CONFIG:-configs/voice_synth.local.yaml}"
if [[ ! -f "$CONFIG" ]]; then
    echo "ERROR: config not found: $CONFIG" >&2
    echo "       cp configs/voice_synth.example.yaml $CONFIG  # then edit it" >&2
    exit 1
fi

# Base proxy (if the repo helper exists), then let the config's proxy override.
if [[ -f scripts/setup_proxy.sh ]]; then
    # shellcheck source=/dev/null
    source scripts/setup_proxy.sh
fi
# Exports proxy (overrides the above when set) + CFG_NUM_SHARDS / CFG_* values.
eval "$(uv run python scripts/voice_synth_config.py "$CONFIG" --shell)"

# Precedence for orchestration: qsub -v env  >  config  >  built-in default.
SPEAKER="${SPEAKER:-}"
NUM_SHARDS="${NUM_SHARDS:-${CFG_NUM_SHARDS:-4}}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-${CFG_CUDA_VISIBLE_DEVICES:-0,1,2,3}}"

if ! [[ "$NUM_SHARDS" =~ ^[0-9]+$ ]] || [[ "$NUM_SHARDS" -lt 1 ]]; then
    echo "ERROR: NUM_SHARDS must be a positive integer: $NUM_SHARDS" >&2
    exit 1
fi
IFS=',' read -r -a GPU_IDS <<< "$CUDA_VISIBLE_DEVICES"
if [[ "${#GPU_IDS[@]}" -lt "$NUM_SHARDS" ]]; then
    echo "ERROR: CUDA_VISIBLE_DEVICES has ${#GPU_IDS[@]} GPU(s) but NUM_SHARDS=$NUM_SHARDS" >&2
    exit 1
fi

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
OUT_DIR="${OUT_DIR:-${CFG_OUT_DIR:-data/clone_examples/${JOB_ID_SHORT}}}"

mkdir -p "$OUT_DIR" "$OUT_DIR/logs"
LOG_FILE="${LOG_FILE:-$OUT_DIR/run.log}"
export PYTHONUNBUFFERED=1

{
    echo "===== clone voice examples (config-driven, parallel) ====="
    echo "job:      ${JOB_ID_RAW}"
    echo "started:  $(date -Is)"
    echo "config:   $CONFIG"
    echo "out_dir:  $OUT_DIR"
    echo "gpus:     $CUDA_VISIBLE_DEVICES"
    echo "shards:   $NUM_SHARDS"
    echo "log:      $LOG_FILE"
} | tee "$LOG_FILE"

# Common python args: config supplies synthesis params; env vars override.
COMMON_ARGS=( scripts/clone_voice_examples.py --config "$CONFIG"
    --out-dir "$OUT_DIR" --num-shards "$NUM_SHARDS" )
[[ -n "${SPEAKER:-}" ]]       && COMMON_ARGS+=( --speaker "$SPEAKER" )
[[ -n "${ANALYSIS_DIR:-}" ]]  && COMMON_ARGS+=( --analysis-dir "$ANALYSIS_DIR" )
# shellcheck disable=SC2206
[[ -n "${EXTRA_ARGS:-}" ]]    && COMMON_ARGS+=( $EXTRA_ARGS )

# Preflight: import qwen_tts + prefetch the config's models ONCE so parallel
# shards read from the shared HF cache instead of racing on first download.
echo "===== preflight: import + prefetch models =====" | tee -a "$LOG_FILE"
uv run python scripts/voice_synth_config.py "$CONFIG" --prefetch 2>&1 | tee -a "$LOG_FILE"

echo "===== render $NUM_SHARDS shards in parallel =====" | tee -a "$LOG_FILE"
pids=()
for ((i = 0; i < NUM_SHARDS; i++)); do
    gpu_id="${GPU_IDS[$i]}"
    shard_log="$OUT_DIR/logs/shard_$(printf '%02d' "$i").log"
    (
        set -euo pipefail
        echo "[shard $i] gpu=$gpu_id"
        CUDA_VISIBLE_DEVICES="$gpu_id" uv run python -u "${COMMON_ARGS[@]}" --shard-index "$i"
    ) > "$shard_log" 2>&1 &
    pids+=("$!")
    echo "started shard $i on gpu $gpu_id (log=$shard_log)" | tee -a "$LOG_FILE"
done

failed=0
for pid in "${pids[@]}"; do
    if ! wait "$pid"; then failed=1; fi
done
if [[ "$failed" != "0" ]]; then
    echo "WARNING: a shard exited non-zero; see $OUT_DIR/logs/shard_*.log" | tee -a "$LOG_FILE"
fi

echo "===== aggregate + verify =====" | tee -a "$LOG_FILE"
uv run python -u "${COMMON_ARGS[@]}" --aggregate 2>&1 | tee -a "$LOG_FILE"

echo "done: $OUT_DIR (log: $LOG_FILE)" | tee -a "$LOG_FILE"
