#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N smoke_lora_chain_mlflow
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# Smoke test for the fix in scripts/run_experiment.sh where a failed
# `uv pip install mlflow` (no network on the compute node) used to kill the
# entire training job with set -euo pipefail, instead of just disabling
# MLflow live sync and letting training proceed.
#
# This reproduces the failing code path: MLFLOW_EXPERIMENT_NAME is set, so
# run_experiment.sh tries to import/install mlflow at the start of the train
# stage. Uses xvn_s (V100) for both the data and train stage instead of the
# usual xan_s (A100), since A100 is often busy and this run does not need it.
#
# Submit:
#   qsub -V scripts/smoke_run_lora_chain_mlflow.pbs
#
# What to check in the log (experiments/pbs_logs/<chain_id>_link02_train.log):
#   - before the fix: job dies right after
#       "[exp] installing mlflow into project uv environment"
#   - after the fix: on install failure you instead see
#       "[exp] WARN: failed to install mlflow (no network on this node?);
#        continuing training without MLflow live sync"
#     and training proceeds to completion.
#
# To also exercise a train -> train handoff (walltime timeout mid-training),
# add to the qsub -v list: TIMEBOX_WALLTIME_SEC=120,TIMEBOX_LEAD_SEC=60

set -euo pipefail

REPO_ROOT="${PBS_O_WORKDIR:-$(pwd)}"
cd "$REPO_ROOT"

export RUN_ID="${RUN_ID:-smoke_mlflow_$(date +%Y%m%d_%H%M%S)}"
export NUM_CASES="${NUM_CASES:-4}"
export TOTAL_STEPS="${TOTAL_STEPS:-10}"
export HP_CKPT_FREQ="${HP_CKPT_FREQ:-5}"
export MLFLOW_EXPERIMENT_NAME="${MLFLOW_EXPERIMENT_NAME:-smoke_mlflow_chain_test}"
export DATA_QUEUE="${DATA_QUEUE:-xvn_s}"
export DATA_SELECT="${DATA_SELECT:-1:res=small}"
export TRAIN_QUEUE="${TRAIN_QUEUE:-xvn_s}"
export TRAIN_SELECT="${TRAIN_SELECT:-1:res=small}"
export PIPELINE_WALLTIME="${PIPELINE_WALLTIME:-02:00:00}"

echo "===== smoke: LoRA chain with MLflow enabled, all on V100 (xvn_s) ====="
echo "run_id:          $RUN_ID"
echo "num_cases:       $NUM_CASES"
echo "total_steps:     $TOTAL_STEPS"
echo "mlflow_exp:      $MLFLOW_EXPERIMENT_NAME"
echo "data_resource:   $DATA_QUEUE / $DATA_SELECT"
echo "train_resource:  $TRAIN_QUEUE / $TRAIN_SELECT"
echo "========================================================================"

exec bash scripts/run_full_duplex_lora_chain.pbs
