#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N qwen_tts_whole
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# Qwen3-TTS whole-utterance smoke: per-speaker concatenated TTS + MMS_FA alignment.
#
#   qsub -V scripts/run_qwen_tts_whole_utterance_smoke.pbs
#
# Overrides:
#   SOURCE_BATCH_ID=qwen_dialogues_1000 qsub -V scripts/run_qwen_tts_whole_utterance_smoke.pbs
#   NUM_DIALOGUES=10 qsub -V scripts/run_qwen_tts_whole_utterance_smoke.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh
# shellcheck source=/dev/null
source "$PWD/scripts/run_id_utils.sh"

export SOURCE_BATCH_ID="${SOURCE_BATCH_ID:-qwen_dialogues_1000}"
export BATCH_ID="${BATCH_ID:-$(default_run_id "${SOURCE_BATCH_ID}_tts_whole")}"
export RUN_ID="$BATCH_ID"
export DIALOGUES_JSONL="${DIALOGUES_JSONL:-$PWD/data/runs/${SOURCE_BATCH_ID}/llm_dialogues/dialogues.jsonl}"
export OUT_ROOT="${OUT_ROOT:-$PWD/data/runs/$BATCH_ID}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export TTS_DTYPE="${TTS_DTYPE:-float16}"
export TTS_DEVICE="${TTS_DEVICE:-cuda}"
export NUM_DIALOGUES="${NUM_DIALOGUES:-3}"
export LEAD_IN_SEC="${LEAD_IN_SEC:-0.3}"
export GAP_SEC="${GAP_SEC:-0.2}"
export STYLE_PRESET="${STYLE_PRESET:-auto}"

if [[ "$NUM_DIALOGUES" != "all" ]]; then
    if ! [[ "$NUM_DIALOGUES" =~ ^[0-9]+$ ]] || [[ "$NUM_DIALOGUES" -lt 1 ]]; then
        echo "ERROR: NUM_DIALOGUES must be a positive integer or 'all': $NUM_DIALOGUES" >&2
        exit 1
    fi
fi

mkdir -p experiments/pbs_logs
JOB_LOG="experiments/pbs_logs/${BATCH_ID}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== Qwen3-TTS whole-utterance smoke ====="
echo "job_id:       ${PBS_JOBID:-n/a}"
echo "host:         $(hostname)"
echo "source_batch: $SOURCE_BATCH_ID"
echo "out_root:     $OUT_ROOT"
echo "dialogues:    $DIALOGUES_JSONL"
echo "num_dialogues:$NUM_DIALOGUES"
echo "cuda_visible: $CUDA_VISIBLE_DEVICES"
echo "dtype:        $TTS_DTYPE"
echo "device:       $TTS_DEVICE"
echo "timing:       lead_in=$LEAD_IN_SEC gap=$GAP_SEC"
echo "style_preset: $STYLE_PRESET"
echo "mode:         whole-utterance (MMS_FA alignment)"
echo "started_at:   $(date -Iseconds)"
echo "============================================"

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

if [[ ! -s "$DIALOGUES_JSONL" ]]; then
    echo "ERROR: dialogues JSONL was not found or is empty: $DIALOGUES_JSONL" >&2
    exit 1
fi

echo "===== step 1/1: Qwen3-TTS whole-utterance dialogue audio ====="
tts_args=(
    uv run python scripts/generate_qwen3_tts_data.py
    --tts-backend qwen3
    --dialogues-jsonl "$DIALOGUES_JSONL"
    --auto-overlap-aizuchi
    --whole-utterance
    --out-dir "$OUT_ROOT"
    --device "$TTS_DEVICE"
    --dtype "$TTS_DTYPE"
    --lead-in-sec "$LEAD_IN_SEC"
    --gap-sec "$GAP_SEC"
    --no-emotion
    --style-preset "$STYLE_PRESET"
)
if [[ "$NUM_DIALOGUES" != "all" ]]; then
    tts_args+=(--num-dialogues "$NUM_DIALOGUES")
fi
"${tts_args[@]}"

WAV_GLOB="$OUT_ROOT/data_stereo/*.wav"
if ! compgen -G "$WAV_GLOB" >/dev/null; then
    echo "ERROR: no stereo WAVs were created in $OUT_ROOT/data_stereo" >&2
    exit 1
fi

WAV_COUNT="$(compgen -G "$WAV_GLOB" | wc -l | tr -d ' ')"
if [[ "$NUM_DIALOGUES" != "all" ]]; then
    if [[ "$WAV_COUNT" != "$NUM_DIALOGUES" ]]; then
        echo "ERROR: expected $NUM_DIALOGUES stereo WAVs in $OUT_ROOT/data_stereo, found $WAV_COUNT" >&2
        compgen -G "$WAV_GLOB" | sort >&2
        exit 1
    fi
fi

echo "stereo_wav_dir: $OUT_ROOT/data_stereo"
echo "stereo_wavs:    $WAV_COUNT"
echo "manifest:       $OUT_ROOT/synthetic_moshi_train.jsonl"
echo "finished_at:    $(date -Iseconds)"
