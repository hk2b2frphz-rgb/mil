#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N moshi_backchannel_verify
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V
# ---------------------------------------------------------------------------
# Purpose: verification only, not production data generation.
# Feed LLM-jp-Moshi a spoken prompt and record whether the Moshi
# stream produces natural short backchannels during the user audio.
# If listening-time backchannels appear reliably, this can seed a
# later data-generation pipeline.
#
# The analyzer classifies hits as:
#   listening: emitted before input_duration_sec, during user speech.
#   response:  emitted after input_duration_sec, as a turn response.
#
# Run from repo root:
#   qsub scripts/verify_moshi_backchannels.pbs
# Local GPU run:
#   bash scripts/verify_moshi_backchannels.pbs
#
# Notes:
#   - Queue and select resources follow the local xvn_s small-GPU jobs.
#   - Prompts are TTS-generated by response_recorder.py for this check;
#     production use should replace them with real dialogue audio.
# ---------------------------------------------------------------------------
set -euo pipefail

# --- Move to repository root ---------------------------------------------
# PBS provides PBS_O_WORKDIR; local runs resolve relative to this file.
if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
    cd "$PBS_O_WORKDIR"
else
    cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi
source scripts/setup_proxy.sh
REPO_ROOT="$(pwd)"
mkdir -p experiments/pbs_logs
JOB_TAG="${PBS_JOBID%%.*}"
JOB_LOG="experiments/pbs_logs/moshi_backchannel_verify_${JOB_TAG:-local}.log"
exec > >(tee -a "$JOB_LOG") 2>&1
echo "===== moshi backchannel verify ====="
echo "repo_root: $REPO_ROOT"
echo "host:      $(hostname)"
echo "started:   $(date -Iseconds)"
echo "git:       $(git rev-parse --short HEAD 2>/dev/null || echo n/a) / $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo n/a)"
echo "job_log:   $JOB_LOG"


# --- Parameters, overridable via environment ------------------------------
RUN_ID="${RUN_ID:-$(date +%Y-%m-%d_%H%M%S)}"
OUT_DIR="${OUT_DIR:-$REPO_ROOT/data/verify/backchannel_$RUN_ID}"
HF_REPO="${HF_REPO:-llm-jp/llm-jp-moshi-v1}"
PROMPTS_FILE="${PROMPTS_FILE:-$REPO_ROOT/eval_sets/loneliness_support_prompts.txt}"
N_PROMPTS="${N_PROMPTS:-12}"          # Number of prompt lines to verify.
SEEDS="${SEEDS:-0,1,2}"               # Multiple seeds for stochastic output.
SILENCE_SEC="${SILENCE_SEC:-12}"      # Post-input silence budget.
MAX_GEN_SEC="${MAX_GEN_SEC:-45}"      # Safety cap per trial.
TEMP_TEXT="${TEMP_TEXT:-0.8}"         # Slightly higher text diversity.
TEMP="${TEMP:-0.8}"
DEVICE="${DEVICE:-cuda}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

# Disable Triton / torch.compile — V100 lacks support for many Triton kernels.
export TORCHINDUCTOR_DISABLE=1
export NO_TORCH_COMPILE="${NO_TORCH_COMPILE:-1}"
export TORCH_COMPILE_DISABLE=1

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

# Build a verification prompt subset from the first N_PROMPTS lines.
PROMPTS_SUBSET="$OUT_DIR/_prompts_subset.txt"
mkdir -p "$OUT_DIR"
head -n "$N_PROMPTS" "$PROMPTS_FILE" > "$PROMPTS_SUBSET"

echo "out_dir:      $OUT_DIR"
echo "hf_repo:      $HF_REPO"
echo "prompts:      $PROMPTS_SUBSET ($(wc -l < "$PROMPTS_SUBSET") lines)"
echo "seeds:        $SEEDS / silence=${SILENCE_SEC}s / max_gen=${MAX_GEN_SEC}s"
echo "temp_text:    $TEMP_TEXT / temp=$TEMP"

# --- 1. Record Moshi continuation from spoken prompts ---------------------
# --response-sec 0 saves the full response audio for manual listening.
echo
echo "[1/2] response_recorder: generate Moshi continuations from spoken prompts..."
uv run python response_recorder.py \
    --hf-repo "$HF_REPO" \
    --text-file "$PROMPTS_SUBSET" \
    --seeds "$SEEDS" \
    --silence-sec "$SILENCE_SEC" \
    --max-gen-sec "$MAX_GEN_SEC" \
    --temp "$TEMP" \
    --temp-text "$TEMP_TEXT" \
    --response-sec 0 \
    --device "$DEVICE" \
    --out-dir "$OUT_DIR"

# --- 2. Detect and classify backchannels ----------------------------------
echo
echo "[2/2] analyze_backchannels: classify hits as listening or response..."
uv run python scripts/analyze_backchannels.py --out-dir "$OUT_DIR"

echo
echo "===== done ====="
echo "out_dir:  $OUT_DIR"
echo "report:   $OUT_DIR/backchannel_report.json"
echo "audio:    $OUT_DIR/<prompt>/seed_<n>/response.wav  (manual listening check)"
echo "ended:    $(date -Iseconds)"
