#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N az_n_tts10k2
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# Qwen3-TTS for the normal-frequency 10,000-dialogue corpus, v2.
# Re-submit this same file after walltime to resume unfinished shards.
# Finished shards, dialogues and requests are all skipped on resume.
#
# VOICE MODE: mixed -- moshi is the cloned voice, user stays on the CustomVoice
# preset pool. CLONE_OUT_DIR_MOSHI is hardcoded below and QWEN_VOICE_MODE is
# left unset on purpose: it defaults to "auto", and auto resolves to "mixed"
# when a moshi clone source is present and no user clone source is (see
# resolve_qwen_voice_mode in scripts/run_qwen_tts_vllm_common.sh).
#
# v1 was submitted with no clone source at all, so auto silently resolved to
# "customvoice" for BOTH channels. Hardcoding the path is what stops that from
# happening again -- do not turn it back into an optional override.
#
# The directory is a clone_voice_examples.py output folder;
# scripts/resolve_clone_refs.py picks the reference wav (and transcript, when
# CLONE_MODE=in-context) out of it by REF_RANK.
#
# OUT_ROOT is a new v2 path, so the v1 output and its generation_config.json
# lock are untouched and there is nothing to delete first.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export CLONE_OUT_DIR_MOSHI="$PWD/data/clone_examples/99999"

export SOURCE_BATCH_ID="qwen_aizuchi_10000_normal_v2"
export BATCH_ID="aizuchi_normal_10000_v2_tts_vllm"
export DIALOGUES_JSONL="$PWD/data/runs/aizuchi_normal_10000_v2/dialogue/llm_dialogues/dialogues.jsonl"
export OUT_ROOT="$PWD/data/runs/aizuchi_normal_10000_v2/tts"
export NUM_DIALOGUES="${NUM_DIALOGUES:-10000}"

exec bash scripts/run_qwen_tts_vllm_10000_4gpu.pbs
