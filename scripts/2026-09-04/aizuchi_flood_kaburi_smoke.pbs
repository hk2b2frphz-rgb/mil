#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N az_f_kabsmk
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# KABURI-TTS smoke on the FLOOD(v6) aizuchi corpus -- the upper end of the
# backchannel density sweep (reserved < normal < eager < flood). Same TTS,
# voices and report as the normal and eager smokes.
#
#   qsub -V scripts/2026-09-04/aizuchi_flood_kaburi_smoke.pbs
#
# Interactive node equivalent:
#
#   AIZUCHI_PRESET=flood bash scripts/run_tts_smoke.sh kaburi-pred 3
#
# flood reacts at nearly every clause boundary with no minimum gap, so it is
# the condition most likely to push the utterance count past what a 30s KABURI
# canvas holds. Watch the chunk count per dialogue in the log: if it climbs
# well above the normal run's, the corpus is being cut into more pieces and
# there are more prosody seams in the result.
#
# Needs the corpus from scripts/2026-09-04/aizuchi_flood_dialogue_3000.pbs.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export AIZUCHI_PRESET="flood"

exec bash scripts/run_tts_smoke.sh kaburi-pred "${NUM_DIALOGUES:-3}"
