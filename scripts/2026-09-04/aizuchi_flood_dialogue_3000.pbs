#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N az_f_dlg3k6
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# 3,000 listener-only dialogues, FLOOD frequency, v6.
# The upper end of the backchannel-density axis: the "flood" preset reacts at
# essentially every clause boundary, allows adjacent clauses (min_gap=0), drops
# the length floors, and permits six reactions in one user utterance. It is
# expected to sound excessive -- that is the point, it bounds the axis whose
# other end is "reserved".
#
# Ordering of the presets by density (see AIZUCHI_FREQUENCY_PRESETS in
# scripts/generate_synthetic_moshi_training_data.py):
#   reserved < eager < normal(v6) < flood
# Note that "eager" is the pre-v6 label and is now LESS dense than "normal":
# v6 made normal talkative without renaming it.
#
# Everything except AIZUCHI_ONLY_FREQUENCY matches aizuchi_normal_dialogue_3000.pbs
# so the comparison isolates the backchannel policy.
#
# Every AIZUCHI_ONLY_* value below can be overridden at submit time, e.g.:
#   qsub -V -v AIZUCHI_ONLY_MAX_BLOCKS=8 scripts/2026-09-04/aizuchi_flood_dialogue_3000.pbs
#
# Submit:
#   qsub -V scripts/2026-09-04/aizuchi_flood_dialogue_3000.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export AIZUCHI_VERSION="v6"
export BATCH_ID="qwen_aizuchi_3000_flood_${AIZUCHI_VERSION}"
export OUT_ROOT="$PWD/data/runs/aizuchi_flood_3000_${AIZUCHI_VERSION}/dialogue"
export NUM_CASES="${NUM_CASES:-3000}"
export DIALOGUE_GENERATION_MODE="aizuchi-only"
export AIZUCHI_ONLY_FREQUENCY="flood"

# Same block range as the normal and eager v6 jobs: the reaction density is the
# only variable, and every dialogue has to stay inside one 170s training chunk
# (moshi-finetune splits longer ones, and the later chunks teach the model to
# open with a backchannel instead of the greeting).
export AIZUCHI_ONLY_MIN_BLOCKS="${AIZUCHI_ONLY_MIN_BLOCKS:-4}"
export AIZUCHI_ONLY_MAX_BLOCKS="${AIZUCHI_ONLY_MAX_BLOCKS:-6}"

# The v6 experiment assumes the listener responds instead of learning periodic
# quiet stretches. Zero also suppresses userAI inline pause tags.
export AIZUCHI_ONLY_MAX_SILENCES="0"
export AIZUCHI_ONLY_SILENCE_RATE="0"
export AIZUCHI_ONLY_SILENCE_MIN_SEC="${AIZUCHI_ONLY_SILENCE_MIN_SEC:-2.0}"
export AIZUCHI_ONLY_SILENCE_MAX_SEC="${AIZUCHI_ONLY_SILENCE_MAX_SEC:-4.0}"
export AIZUCHI_ONLY_PROBE_RATE="0"

exec bash scripts/run_dialogues_qwen_3000.pbs
