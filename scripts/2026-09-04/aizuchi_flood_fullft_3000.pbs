#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N az_f_ft3k6
#PBS -q xan_s
#PBS -l select=1:res=middle
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# Full fine-tuning for the flood-frequency 3,000-dialogue corpus, v6.
# Full-Duplex-Bench-JA runs automatically after best-checkpoint export.
#
# Verify rendered durations before training -- flood puts up to six reactions in
# one user utterance, so check this corpus even though the block range matches
# the normal job:
#   python3 -c "import json; d=sorted(json.loads(l)['duration'] for l in open('data/runs/aizuchi_flood_3000_v6/tts/merged/training_set/synthetic_moshi_train.jsonl')); n=len(d); print('p95=%.1f max=%.1f over170=%.1f%%' % (d[int(n*.95)], d[-1], 100*sum(1 for x in d if x>170)/n))"
#
# Submit:
#   qsub -V scripts/2026-09-04/aizuchi_flood_fullft_3000.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export AIZUCHI_VERSION="v6"
export RUN_ID="${RUN_ID:-aizuchi_flood_3000_${AIZUCHI_VERSION}_fullft}"
export SRC_RUN_DIR="${SRC_RUN_DIR:-$PWD/data/runs/aizuchi_flood_3000_${AIZUCHI_VERSION}/tts/merged}"
export SWEEP_PATTERNS="${SWEEP_PATTERNS:-f01}"
export NU_KEEP_BEST_ONLY="0"
export SELF_PBS="scripts/2026-09-04/aizuchi_flood_fullft_3000.pbs"

exec bash scripts/fullft_sweep.pbs
