#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N az_r_dlg10k
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# 10,000 listener-only dialogues: reserved backchannel frequency.
set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export BATCH_ID="qwen_aizuchi_10000_reserved_v1"
export OUT_ROOT="$PWD/data/runs/aizuchi_reserved_10000/dialogue"
export NUM_CASES=10000
export DIALOGUE_GENERATION_MODE="aizuchi-only"
export AIZUCHI_ONLY_FREQUENCY="reserved"
export AIZUCHI_ONLY_MIN_BLOCKS=8
export AIZUCHI_ONLY_MAX_BLOCKS=14
export AIZUCHI_ONLY_SILENCE_RATE=0.35
export AIZUCHI_ONLY_SILENCE_MIN_SEC=2.5
export AIZUCHI_ONLY_SILENCE_MAX_SEC=8.0
export AIZUCHI_ONLY_PROBE_RATE=0.5

exec bash scripts/run_dialogues_qwen_10000.pbs
