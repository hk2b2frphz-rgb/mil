#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N az_e_lora10k
#PBS -q xan_s
#PBS -l select=1:res=middle
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# LoRA fine-tuning for the eager-frequency 10,000-dialogue aizuchi corpus.
# LoRA keeps the base model's listening/turn-taking behaviour that full FT
# overwrites, so this is the path to a working listener model.
#
# HP_DURATION_SEC is the setting that matters most here. moshi-finetune splits
# any dialogue longer than duration_sec into equal chunks, and every chunk
# after the first starts mid-conversation with no opening greeting. The model
# cannot tell such a chunk from the true start of a call, so it learns to skip
# the greeting and open with a backchannel instead. Measure the corpus first:
#
#   python3 -c "import json; d=sorted(json.loads(l)['duration'] for l in open('data/runs/aizuchi_eager_10000/tts/merged/training_set/synthetic_moshi_train.jsonl')); n=len(d); print('p95=%.1f max=%.1f' % (d[int(n*.95)], d[-1]))"
#
# then set HP_DURATION_SEC at or above that p95 so nearly every dialogue stays
# in one chunk:
#
#   qsub -V -v HP_DURATION_SEC=300 scripts/2026-09-02/aizuchi_eager_lora_10000.pbs
#
# Raising it costs VRAM. If training OOMs, halve HP_BATCH_SIZE (the base config
# uses 16) rather than lowering HP_DURATION_SEC back down.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export BASE_EXP="lora_base_config"
export SRC_RUN_DIR="$PWD/data/runs/aizuchi_eager_10000/tts/merged"

# Keep the first run inside one walltime so the automatic Full-Duplex-Bench
# evaluation at the end actually runs. The base config's 2000 steps does not
# fit; chain with scripts/run_train_chain.pbs if more exposure is needed.
export HP_MAX_STEPS="${HP_MAX_STEPS:-1200}"
export HP_DURATION_SEC="${HP_DURATION_SEC:-170}"

export MLFLOW_EXPERIMENT_NAME="${MLFLOW_EXPERIMENT_NAME:-job_aizuchi_lora}"

exec bash scripts/run_experiment.pbs
