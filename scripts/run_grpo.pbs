#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N grpo_moshi
#PBS -q xan_s
#PBS -l select=1:res=middle
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -V
# ---------------------------------------------------------------------------
# GRPO interactivity alignment training for Moshi on 2x A100 80GB.
#
# Reproduces the Kyutai Multi-Faceted Interactivity Alignment paper
# (arxiv 2606.11167) adapted for the loneliness counseling domain.
#
# Submit:
#   qsub scripts/run_grpo.pbs
#   qsub -v CONFIG=configs/grpo_loneliness.yaml scripts/run_grpo.pbs
# ---------------------------------------------------------------------------
set -euo pipefail

if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
    cd "$PBS_O_WORKDIR"
else
    cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi
source scripts/setup_proxy.sh
REPO_ROOT="$(pwd)"

CONFIG="${CONFIG:-configs/grpo_loneliness.yaml}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

if [[ "${DISABLE_TRITON:-0}" == "1" ]]; then
    export TORCHINDUCTOR_DISABLE=1
    export NO_TORCH_COMPILE="${NO_TORCH_COMPILE:-1}"
    export TORCH_COMPILE_DISABLE=1
fi

mkdir -p experiments/pbs_logs
JOB_TAG="${PBS_JOBID%%.*}"
JOB_LOG="experiments/pbs_logs/grpo_${JOB_TAG:-local}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== GRPO interactivity alignment ====="
echo "repo_root: $REPO_ROOT"
echo "host:      $(hostname)"
echo "config:    $CONFIG"
echo "cuda:      $CUDA_VISIBLE_DEVICES"
echo "started:   $(date -Iseconds)"
echo "git:       $(git rev-parse --short HEAD 2>/dev/null || echo n/a) / $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo n/a)"
echo "job_log:   $JOB_LOG"
echo "========================================="

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

uv run python scripts/grpo/train_grpo.py --config "$CONFIG"

echo "===== done ====="
echo "ended: $(date -Iseconds)"
