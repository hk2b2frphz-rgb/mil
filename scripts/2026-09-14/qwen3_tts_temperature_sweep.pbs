#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N qwen_tsweep
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# One string, many draws, across temperatures.
#
#   qsub -V scripts/2026-09-14/qwen3_tts_temperature_sweep.pbs
#   TEXTS_FILE=my_texts.txt REPEATS=100 \
#     qsub -V scripts/2026-09-14/qwen3_tts_temperature_sweep.pbs
#
# Interactive node equivalent:
#
#   TEXTS=<word> REPEATS=50 TEMPERATURE_SWEEP=0.7,1.0,1.3 \
#     bash scripts/run_qwen3_tts_diversity.sh
#
# The companion to qwen3_tts_diversity_probe.pbs, which varied the spelling and
# so could not tell content apart from sampling: with 20 different strings, of
# course the audio differs. Here the string is held still and only temperature
# moves, which is the question a 10,000-sample bank actually turns on -- a bank
# that large cannot be built out of 20 spellings.
#
# The first probe measured the engine default at cv 0.455 for the single-mora
# words and 0.10-0.13 for the multi-mora ones, so the headroom to look for is
# whether a higher temperature widens the short ones without breaking them.
# Both ends matter: the report counts identical audio (the bank stops growing)
# and prints min/max, so a temperature that only produces garbage shows up as
# an implausible spread rather than as a good score.
#
# 50 draws x 3 temperatures x 1 text = 150 samples on one engine load. REPEATS
# is per temperature. All three groups land in one report, lined up in the
# "temperature" table.
#
# Re-measuring the result needs no GPU:
#   uv run python scripts/qwen3_tts_diversity_probe.py --out-dir <dir> --reanalyze

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

# The word itself lives in a data file so this one stays ASCII.
export TEXTS_FILE="${TEXTS_FILE:-$PWD/scripts/2026-09-14/sweep_texts_un.txt}"
export REPEATS="${REPEATS:-50}"
export TEMPERATURE_SWEEP="${TEMPERATURE_SWEEP:-0.7,1.0,1.3}"
export BATCH_ID="${BATCH_ID:-qwen3_temperature_sweep_$(date +%Y%m%d_%H%M%S)}"

exec bash scripts/run_qwen3_tts_diversity.sh
