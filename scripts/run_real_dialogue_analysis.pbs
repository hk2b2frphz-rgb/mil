#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N real_dialogue
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# 1ch ロールプレイ実対話 WAV の聴取確認用分析 (scripts/analyze_real_dialogue.py)。
# ダイアライゼーション (nvidia/diar_streaming_sortformer_4spk-v2, 非ゲート・CC-BY-4.0)
# + faster-whisper 書き起こしで、solo/stereo トラックと発話ごとの切り出し WAV を出す。
#
# Required:
#   qsub -v WAVS=/path/to/dialogue1.wav scripts/run_real_dialogue_analysis.pbs
#
# 複数ファイル (カンマ区切り) や glob も可:
#   qsub -v 'WAVS=/path/a.wav,/path/b.wav' scripts/run_real_dialogue_analysis.pbs
#   qsub -v 'WAVS=/path/sessions/*.wav'    scripts/run_real_dialogue_analysis.pbs
#
# Optional:
#   OUT_DIR=data/real_dialogue/<name>   (default: data/real_dialogue/<jobid>)
#   WHISPER_MODEL=large-v3
#   EXTRA_ARGS="--skip-asr"             (書き起こし省略で高速確認)

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

WAVS="${WAVS:?Set WAVS to one or more input wav paths (comma separated, glob ok)}"

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
OUT_DIR="${OUT_DIR:-data/real_dialogue/${JOB_ID_SHORT}}"

# カンマ区切り → 配列。glob はここで展開される。
IFS=',' read -r -a wav_patterns <<< "$WAVS"
wav_files=()
for pat in "${wav_patterns[@]}"; do
    for f in $pat; do
        wav_files+=("$f")
    done
done
if [[ ${#wav_files[@]} -eq 0 ]]; then
    echo "ERROR: no wav files matched: $WAVS" >&2
    exit 1
fi

echo "===== real dialogue analysis ====="
echo "inputs:  ${wav_files[*]}"
echo "out_dir: $OUT_DIR"

# shellcheck disable=SC2086
uv run python scripts/analyze_real_dialogue.py \
    "${wav_files[@]}" \
    --out-dir "$OUT_DIR" \
    ${WHISPER_MODEL:+--whisper-model "$WHISPER_MODEL"} \
    ${EXTRA_ARGS:-}

echo "done: $OUT_DIR"
