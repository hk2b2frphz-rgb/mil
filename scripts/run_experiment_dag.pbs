#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N exp_dag
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -V

# Submit the whole experiment DAG (one qsub per stage, chained by dependency)
# from a lightweight job. The driver only calls qsub -- it uses no GPU and
# finishes quickly; the real work runs in the per-stage jobs it submits.
#
# The config is read automatically:
#   CONFIG env  >  EXPERIMENT_CONFIG env  >  configs/experiment.local.yaml
#
#   qsub scripts/run_experiment_dag.pbs
#   qsub -v CONFIG=experiments/exp01.yaml scripts/run_experiment_dag.pbs
#   qsub -v 'CONFIG=experiments/exp01.yaml,EXTRA_ARGS=--dry-run' scripts/run_experiment_dag.pbs
#   qsub -v 'EXTRA_ARGS=--stages eval' scripts/run_experiment_dag.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
[[ -f scripts/setup_proxy.sh ]] && source scripts/setup_proxy.sh

command -v uv >/dev/null 2>&1 || { echo "ERROR: uv not on PATH" >&2; exit 1; }
command -v qsub >/dev/null 2>&1 || {
    echo "ERROR: qsub is not available on this node, so the DAG driver cannot" >&2
    echo "       submit the per-stage jobs. Run it on the login node instead:" >&2
    echo "       uv run python scripts/run_experiment_dag.py [config]" >&2
    exit 1
}

# CONFIG (qsub -v) wins; else EXPERIMENT_CONFIG; else the driver's own default.
export EXPERIMENT_CONFIG="${CONFIG:-${EXPERIMENT_CONFIG:-configs/experiment.local.yaml}}"
echo "experiment config: $EXPERIMENT_CONFIG"

# shellcheck disable=SC2086
uv run python scripts/run_experiment_dag.py ${EXTRA_ARGS:-}
