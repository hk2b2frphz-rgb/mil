#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N mixft_tts_resp
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# STAGE 2 of the mixed-corpus pipeline. See scripts/mixed_corpus_fullft_2026-09-04/README.md.
#
# Renders the RESPONSE dialogues with Qwen3-TTS.
#
# VOICE: CLONE_OUT_DIR_MOSHI is hardcoded to the SAME clone source the aizuchi
# corpus used (data/clone_examples/99999). This is the single most important
# line in this file. If the two halves of the mixed corpus carry different
# moshi voices, the acoustic codebooks get a bimodal target for the same
# speaker and the fine-tuned voice becomes unstable -- which is exactly the
# failure the full-FT voice drift investigation traced back to the acoustic
# heads. Do not turn this into an optional override.
#
# QWEN_VOICE_MODE is deliberately left unset: it defaults to "auto", which
# resolves to "mixed" when a moshi clone source is present and no user clone
# source is (resolve_qwen_voice_mode in scripts/run_qwen_tts_vllm_common.sh).
#
# Re-submit this same file after walltime to resume unfinished shards.
# Finished shards, dialogues and requests are all skipped on resume.
#
# Submit:
#   qsub -V scripts/mixed_corpus_fullft_2026-09-04/21_tts_response.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export RESPONSE_VERSION="${RESPONSE_VERSION:-v1}"
export NUM_CASES="${NUM_CASES:-10000}"
RESPONSE_ROOT="$PWD/data/runs/response_${NUM_CASES}_${RESPONSE_VERSION}"

export CLONE_OUT_DIR_MOSHI="$PWD/data/clone_examples/99999"

export SOURCE_BATCH_ID="qwen_response_${NUM_CASES}_${RESPONSE_VERSION}"
export BATCH_ID="response_${NUM_CASES}_${RESPONSE_VERSION}_tts_vllm"
export DIALOGUES_JSONL="$RESPONSE_ROOT/dialogue/llm_dialogues/dialogues.jsonl"
export OUT_ROOT="$RESPONSE_ROOT/tts"
export NUM_DIALOGUES="${NUM_DIALOGUES:-$NUM_CASES}"

test -s "$DIALOGUES_JSONL" || {
    echo "ERROR: dialogues not found: $DIALOGUES_JSONL" >&2
    echo "       Run scripts/mixed_corpus_fullft_2026-09-04/11_dialogue_response.pbs first." >&2
    exit 1
}

bash scripts/run_qwen_tts_vllm_10000_4gpu.pbs

MERGED="$OUT_ROOT/merged/training_set/synthetic_moshi_train.jsonl"
NEXT="scripts/mixed_corpus_fullft_2026-09-04/30_mix_corpus.pbs"

if [[ ! -s "$MERGED" ]]; then
    # The TTS driver merges shards only once every shard has finished. Not an
    # error: re-submit this same file to resume the remaining shards.
    echo "merged manifest not present yet: $MERGED"
    if [[ "${CHAIN:-1}" == "1" ]] && command -v qsub >/dev/null 2>&1; then
        echo "re-submitting this stage to continue the remaining shards"
        qsub -V -v "RESPONSE_VERSION=$RESPONSE_VERSION,NUM_CASES=$NUM_CASES" \
            scripts/mixed_corpus_fullft_2026-09-04/21_tts_response.pbs
    fi
    exit 0
fi

echo "stage 2 done: $MERGED"

if [[ "${CHAIN:-1}" == "1" ]]; then
    if command -v qsub >/dev/null 2>&1; then
        echo "chaining -> $NEXT"
        qsub -V -v "RESPONSE_VERSION=$RESPONSE_VERSION,NUM_CASES=$NUM_CASES" "$NEXT"
    else
        echo "WARNING: qsub not on PATH; submit $NEXT manually." >&2
    fi
else
    echo "CHAIN=0; submit $NEXT manually."
fi
