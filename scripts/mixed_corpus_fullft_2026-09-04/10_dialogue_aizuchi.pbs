#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N mixft_dlg_aizu
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# STAGE 0a (OPTIONAL) of the mixed-corpus pipeline.
# See scripts/mixed_corpus_fullft_2026-09-04/README.md.
#
# Regenerates the talkative, silence-free v6 AIZUCHI half of the corpus. Earlier versions
# are kept separate so their quiet or rapid-fire targets cannot leak in.
# Stage 3 points at v6 by default.
#
# This is a thin wrapper around the 2026-09-04 job so the two rounds cannot
# drift apart: all AIZUCHI_ONLY_* tuning lives in that file, not here.
#
# Submit:
#   qsub -V scripts/mixed_corpus_fullft_2026-09-04/10_dialogue_aizuchi.pbs
#
# This pipeline pins AIZUCHI_VERSION so an inherited old value cannot leak in.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export AIZUCHI_VERSION="v6"
exec bash scripts/2026-09-04/aizuchi_normal_dialogue_10000.pbs
