#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N moss_ttsd_pilot
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

# MOSS-TTSD Japanese quality pilot: one V100, one shard, 50 dialogues.
# Produces stereo WAV files (left=moshi, right=user) and
# training_set/synthetic_moshi_train.jsonl under data/runs/$BATCH_ID.
#
# Qwen3 references are generated in the shared environment, then MOSS-TTSD
# audio runs in an isolated transformers 5.0.0 environment.
#
# Submit from the repository root:
#   qsub -V scripts/run_moss_ttsd_pilot.pbs
#
# Optional:
#   BATCH_ID=moss_ttsd_pilot_$(date +%Y%m%d) NUM_CASES=100 \
#     qsub -V scripts/run_moss_ttsd_pilot.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

export BATCH_ID="${BATCH_ID:-moss_ttsd_pilot}"
export RUN_ID="$BATCH_ID"
export OUT_ROOT="$PWD/data/runs/$BATCH_ID"
export NUM_CASES="${NUM_CASES:-50}"
export SEED="${SEED:-0}"
export FULL_DUPLEX_TASKS="${FULL_DUPLEX_TASKS:-all}"
export STEPS="${STEPS:-use_cases,dialogues,enrich,audio}"
export LISTENING_RATIO="${LISTENING_RATIO:-0.7}"
export GAP_SEC="${GAP_SEC:-0.2}"
export LEAD_IN_SEC="${LEAD_IN_SEC:-0.3}"
export CONTENT_SEEDS="${CONTENT_SEEDS:-$PWD/data/content_seeds/seeds.jsonl}"
export MOSS_REFS_DIR="$OUT_ROOT/moss_refs"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

export LLM_DTYPE="${LLM_DTYPE:-float16}"
export LLM_TIMEOUT_SEC="${LLM_TIMEOUT_SEC:-7200}"
export TTS_DTYPE=float16
export TTS_DEVICE=cuda
export MOSS_TTS_MODEL="${MOSS_TTS_MODEL:-OpenMOSS-Team/MOSS-TTSD-v1.0}"
export MOSS_CODEC_MODEL="${MOSS_CODEC_MODEL:-OpenMOSS-Team/MOSS-Audio-Tokenizer}"

mkdir -p experiments/pbs_logs
JOB_LOG="experiments/pbs_logs/${BATCH_ID}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== MOSS-TTSD pilot ====="
echo "job_id:      ${PBS_JOBID:-n/a}"
echo "host:        $(hostname)"
echo "out_root:    $OUT_ROOT"
echo "num_cases:   $NUM_CASES"
echo "tts_model:   $MOSS_TTS_MODEL"
echo "codec_model: $MOSS_CODEC_MODEL"
echo "started_at:  $(date -Iseconds)"
echo "==========================="

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

echo "===== step 1/3: LLM dialogues (shared env) ====="
STEPS=use_cases,dialogues,enrich bash scripts/run_full_duplex_training_data.sh

echo "===== step 2/3: Qwen3 reference generation (shared env) ====="
uv run python -c \
    'import transformers; print("shared transformers:", transformers.__version__)'
uv run python scripts/build_moss_reference_voices.py \
    --out-dir "$MOSS_REFS_DIR" \
    --model "${QWEN_TTS_MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice}" \
    --device "$TTS_DEVICE" \
    --dtype "$TTS_DTYPE"

DIALOGUES_JSONL="$OUT_ROOT/llm_dialogues/dialogues_enriched.jsonl"
if [[ ! -s "$DIALOGUES_JSONL" ]]; then
    DIALOGUES_JSONL="$OUT_ROOT/llm_dialogues/dialogues.jsonl"
fi

TORCH_VERSION="$(uv run python -c 'import torch; print(torch.__version__)')"
TORCHAUDIO_VERSION="$(uv run python -c 'import torchaudio; print(torchaudio.__version__)')"
MOSS_UV=(
    uv run --isolated --no-project
    --index "pytorch-cu121=https://download.pytorch.org/whl/cu121"
    --with "transformers==5.0.0"
    --with safetensors
    --with tiktoken
    --with einops
    --with soundfile
    --with numpy
    --with sphn
    --with tqdm
    --with "torch==$TORCH_VERSION"
    --with "torchaudio==$TORCHAUDIO_VERSION"
)

echo "===== step 3/3: MOSS-TTSD audio (isolated env) ====="
"${MOSS_UV[@]}" python -c \
    'import torch, transformers; print("isolated transformers:", transformers.__version__); print("isolated torch:", torch.__version__)'
"${MOSS_UV[@]}" python scripts/generate_qwen3_tts_data.py \
    --out-dir "$OUT_ROOT/training_set" \
    --dialogues-jsonl "$DIALOGUES_JSONL" \
    --tts-backend moss-ttsd \
    --moss-model "$MOSS_TTS_MODEL" \
    --moss-codec-model "$MOSS_CODEC_MODEL" \
    --moss-refs-json "$MOSS_REFS_DIR/refs.json" \
    --device "$TTS_DEVICE" \
    --dtype "$TTS_DTYPE" \
    --gap-sec "$GAP_SEC" \
    --lead-in-sec "$LEAD_IN_SEC"

MANIFEST="$OUT_ROOT/training_set/synthetic_moshi_train.jsonl"
if [[ ! -s "$MANIFEST" ]]; then
    echo "ERROR: pilot manifest was not created: $MANIFEST" >&2
    exit 1
fi

echo "manifest:    $MANIFEST ($(grep -c . "$MANIFEST") samples)"
echo "stereo_wav:  $OUT_ROOT/training_set/data_stereo"
echo "finished_at: $(date -Iseconds)"
