#!/usr/bin/env bash
#PBS -N vllm_smoke_seq
#PBS -q xan_s
# TODO(cluster): verify that `select=1:res=small` guarantees one A100 GPU.
#PBS -l select=1:res=small
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -V
#PBS -S /bin/bash

# Sequential vLLM smoke test on a single GPU allocation.
# Loads each model one at a time (only one resident at a time, so each fits on
# the allocation), verifies offline inference, then tears it down before the next.
# This only checks that models load and return inference; it is not a
# production generation configuration.
#
# Models (default order):
#   Qwen/Qwen3.6-27B-FP8       (Qwen recipe: vLLM >= 0.17.0)
#   Qwen/Qwen3.6-35B-A3B-FP8   (Qwen recipe: vLLM >= 0.17.0)
#   openai/gpt-oss-120b        (MXFP4, fits one A100 80GB per vLLM recipe)
#
# Submit:
#   qsub -V scripts/run_vllm_smoketest_seq.pbs
# Override the model list (space-separated):
#   VLLM_MODELS="openai/gpt-oss-120b Qwen/Qwen3.6-27B" qsub -V scripts/run_vllm_smoketest_seq.pbs
#
# Note: a single failing model does NOT abort the run; every model is attempted
# and a PASS/FAIL summary is printed at the end. The job exits non-zero if any
# model failed. If an HF repo ID 404s, double-check the exact name on HuggingFace.

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
    # shellcheck source=/dev/null
    source "$PWD/scripts/setup_proxy.sh"
fi

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}
command -v curl >/dev/null 2>&1 || {
    echo "ERROR: curl is not available on PATH." >&2
    exit 1
}

export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export PORT="${PORT:-8000}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-8192}"
export UV_TORCH_BACKEND="${UV_TORCH_BACKEND:-cu129}"
# Pinned to 0.21.0: vLLM 0.22+ hard-require CUDA 13 (nvidia-cutlass-dsl[cu13]) which the 570.x driver cannot run.
export VLLM_VERSION="${VLLM_VERSION:-0.21.0}"
# Leave empty by default; pip-bundled CUDA runtime is expected. Set this to a
# cuda12.x module only if your cluster requires an explicit CUDA module; do NOT
# use a cuda13.x module -- the node driver (570.x) does not support CUDA 13.
export VLLM_CUDA_MODULE="${VLLM_CUDA_MODULE:-}"
export VLLM_CUDART_SONAME="${VLLM_CUDART_SONAME:-libcudart.so.12}"
export VLLM_ENV_DIR="${VLLM_ENV_DIR:-.venv_vllm_smoke_seq}"
export VLLM_RECREATE_ENV="${VLLM_RECREATE_ENV:-1}"
export VLLM_TENSOR_PARALLEL_SIZE="${VLLM_TENSOR_PARALLEL_SIZE:-1}"
export VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.90}"
export VLLM_MAX_NUM_BATCHED_TOKENS="${VLLM_MAX_NUM_BATCHED_TOKENS:-1024}"
export VLLM_QWEN_REASONING_PARSER="${VLLM_QWEN_REASONING_PARSER:-qwen3}"
export VLLM_QWEN_CHAT_TEMPLATE_KWARGS="${VLLM_QWEN_CHAT_TEMPLATE_KWARGS:-}"
export VLLM_PREPARE_GPTOSS_TIKTOKEN="${VLLM_PREPARE_GPTOSS_TIKTOKEN:-1}"
export TIKTOKEN_ENCODINGS_DIR="${TIKTOKEN_ENCODINGS_DIR:-$PWD/.cache/tiktoken_encodings}"
VLLM_MODELS="${VLLM_MODELS:-Qwen/Qwen3.6-27B-FP8 Qwen/Qwen3.6-35B-A3B-FP8 openai/gpt-oss-120b}"

VLLM_PYTHON="$VLLM_ENV_DIR/bin/python"
CPU_ARCH="$(uname -m)"
VLLM_WHEEL_URL="${VLLM_WHEEL_URL:-https://github.com/vllm-project/vllm/releases/download/v${VLLM_VERSION}/vllm-${VLLM_VERSION}+cu129-cp38-abi3-manylinux_2_34_${CPU_ARCH}.whl}"
VLLM_INSTALL_SPEC="${VLLM_INSTALL_SPEC:-$VLLM_WHEEL_URL}"

mkdir -p experiments/pbs_logs
JOB_LOG="experiments/pbs_logs/vllm_smoke_seq.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== sequential vLLM smoke test ====="
echo "job_id:        ${PBS_JOBID:-n/a}"
echo "host:          $(hostname)"
echo "models:        $VLLM_MODELS"
echo "cuda_devices:  $CUDA_VISIBLE_DEVICES"
echo "max_model_len: $MAX_MODEL_LEN"
echo "torch_backend: $UV_TORCH_BACKEND"
echo "vllm_version:  $VLLM_VERSION"
echo "cudart_soname: $VLLM_CUDART_SONAME"
echo "cuda_module:   ${VLLM_CUDA_MODULE:-n/a}"
echo "vllm_install:  $VLLM_INSTALL_SPEC"
echo "tp_size:       $VLLM_TENSOR_PARALLEL_SIZE"
echo "gpu_mem_util:  $VLLM_GPU_MEMORY_UTILIZATION"
echo "max_batched:   $VLLM_MAX_NUM_BATCHED_TOKENS"
echo "venv:          $VLLM_ENV_DIR"
echo "started_at:    $(date -Iseconds)"
echo "======================================"

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

if [[ -n "$VLLM_CUDA_MODULE" ]]; then
    if ! command -v module >/dev/null 2>&1; then
        for module_init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash; do
            if [[ -f "$module_init" ]]; then
                # shellcheck source=/dev/null
                source "$module_init"
                break
            fi
        done
    fi
    command -v module >/dev/null 2>&1 || {
        echo "ERROR: environment modules are not available; cannot load $VLLM_CUDA_MODULE." >&2
        exit 1
    }
    module load "$VLLM_CUDA_MODULE"
fi

if [[ "$VLLM_RECREATE_ENV" == "1" ]]; then
    rm -rf "$VLLM_ENV_DIR"
fi
uv venv "$VLLM_ENV_DIR"
# Put the venv bin on PATH so ninja/cmake/python resolve by name. We invoke vllm
# by absolute path, which does NOT activate the venv, so without this torch's
# inductor (shutil.which("ninja")) cannot find ninja at inference time.
export PATH="$(cd "$VLLM_ENV_DIR" && pwd)/bin:$PATH"
# Build tools for any source builds at install time and for torch.compile/inductor
# kernel compilation at inference time (ninja must be on PATH inside the venv).
uv pip install --python "$VLLM_PYTHON" ${VLLM_BUILD_TOOLS:-ninja cmake}
uv pip install --python "$VLLM_PYTHON" "$VLLM_INSTALL_SPEC" --torch-backend="$UV_TORCH_BACKEND"
if [[ -n "${VLLM_EXTRA_DEPS:-}" ]]; then
    read -r -a vllm_extra_deps <<< "$VLLM_EXTRA_DEPS"
    uv pip install --python "$VLLM_PYTHON" "${vllm_extra_deps[@]}"
fi
"$VLLM_PYTHON" - <<'PY'
import ctypes
import os
import torch
import vllm
print("torch:", torch.__version__, "cuda:", torch.version.cuda)
print("vllm:", vllm.__version__)
ctypes.CDLL(os.environ["VLLM_CUDART_SONAME"])
print(os.environ["VLLM_CUDART_SONAME"], "OK")
PY

prepare_gptoss_tiktoken() {
    local model="$1"
    if [[ "$VLLM_PREPARE_GPTOSS_TIKTOKEN" != "1" ]]; then
        return 0
    fi
    if [[ "$model" != openai/gpt-oss-* ]]; then
        return 0
    fi

    mkdir -p "$TIKTOKEN_ENCODINGS_DIR"
    export TIKTOKEN_ENCODINGS_BASE="$TIKTOKEN_ENCODINGS_DIR"
    if [[ ! -s "$TIKTOKEN_ENCODINGS_DIR/o200k_base.tiktoken" ]]; then
        curl --fail --location --silent --show-error \
            --output "$TIKTOKEN_ENCODINGS_DIR/o200k_base.tiktoken" \
            "https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken"
    fi
    if [[ ! -s "$TIKTOKEN_ENCODINGS_DIR/cl100k_base.tiktoken" ]]; then
        curl --fail --location --silent --show-error \
            --output "$TIKTOKEN_ENCODINGS_DIR/cl100k_base.tiktoken" \
            "https://openaipublic.blob.core.windows.net/encodings/cl100k_base.tiktoken"
    fi
    echo "tiktoken_encodings_base: $TIKTOKEN_ENCODINGS_BASE"
}

# Smoke-test one model. Returns 0 on PASS, non-zero on FAIL. Designed to be
# called from an `if` so a single failure never aborts the whole job.
run_one() {
    local model="$1"
    local sanitized="${model//\//_}"
    local model_log="experiments/pbs_logs/vllm_smoke_${sanitized}.log"

    echo ""
    echo "########## MODEL: $model ##########"
    echo "started_at: $(date -Iseconds)"
    prepare_gptoss_tiktoken "$model"

    if ! SMOKE_MODEL="$model" "$VLLM_PYTHON" - <<'PY' > >(tee -a "$model_log") 2>&1; then
import os
import sys

from vllm import LLM, SamplingParams

model = os.environ["SMOKE_MODEL"]
kwargs = {
    "model": model,
    "tensor_parallel_size": int(os.environ.get("VLLM_TENSOR_PARALLEL_SIZE", "1")),
    "max_model_len": int(os.environ.get("MAX_MODEL_LEN", "8192")),
    "gpu_memory_utilization": float(os.environ.get("VLLM_GPU_MEMORY_UTILIZATION", "0.90")),
}
max_num_batched_tokens = os.environ.get("VLLM_MAX_NUM_BATCHED_TOKENS", "")
if max_num_batched_tokens:
    kwargs["max_num_batched_tokens"] = int(max_num_batched_tokens)

llm = LLM(**kwargs)
outs = llm.chat(
    [{"role": "user", "content": "Hello, please introduce yourself briefly."}],
    SamplingParams(max_tokens=64, temperature=0.0),
)
text = outs[0].outputs[0].text
print(text)
if not text.strip():
    print(f"ERROR: empty completion for {model}", file=sys.stderr)
    sys.exit(1)
PY
        return 1
    fi

    # Give the GPU a moment to release memory before loading the next model.
    sleep 10
    echo "finished_at: $(date -Iseconds)"
    return 0
}

declare -a SUMMARY=()
OVERALL_RC=0
for model in $VLLM_MODELS; do
    if run_one "$model"; then
        SUMMARY+=("PASS  $model")
        echo "SMOKE TEST PASSED: $model"
    else
        SUMMARY+=("FAIL  $model")
        OVERALL_RC=1
        echo "SMOKE TEST FAILED: $model"
    fi
done

echo ""
echo "===== smoke test summary ====="
for line in "${SUMMARY[@]}"; do
    echo "$line"
done
echo "finished_at: $(date -Iseconds)"
echo "=============================="

exit "$OVERALL_RC"
