#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N bank_stereo
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# Stereo dialogues whose listener side is retrieved rather than synthesized.
#
#   qsub -V scripts/2026-09-15/aizuchi_bank_stereo_test.pbs
#   NUM_DIALOGUES=5 BANK_DIR=data/runs/diversity/<run> \
#     qsub -V scripts/2026-09-15/aizuchi_bank_stereo_test.pbs
#
# Interactive node equivalent:
#
#   bash scripts/run_bank_stereo_test.sh 3
#
# The whole proposal end to end for the first time: a user side that was
# synthesized, a listener side that was retrieved from a bank, and timing that
# was predicted by KABURI.
#
# It starts by rewriting the corpus, which is not a convenience. The dialogue
# generator's backchannel vocabulary contains no "un" at all -- the four words
# that were 76% of the 116 backchannels in the real recording are none of them
# in it -- so there is no corpus on disk a bank of them could be tested
# against, and one has to be made. The rewrite draws from the measured
# frequencies and touches only the listener's turns, so the user's speech is
# the same speech as before and the two corpora stay comparable.
#
# Qwen3-TTS then renders the rewritten dialogue as usual. Its user channel is
# what is kept. Its listener channel is discarded by the splice and survives
# only as the A/B baseline: the same words, same places, synthesized instead of
# retrieved.
#
# V100 for the Qwen3 pass. The placement and the splice are CPU.
#
# The bank must hold the words the rewrite puts in. The 20-spelling diversity
# probe covers all seven of the default distribution; the temperature sweep
# holds only "un", so pair that one with BACKCHANNEL_TEXT.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export NUM_DIALOGUES="${NUM_DIALOGUES:-3}"
export AIZUCHI_PRESET="${AIZUCHI_PRESET:-normal}"

exec bash scripts/run_bank_stereo_test.sh "$NUM_DIALOGUES"
