#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N ra_stereov2
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# STEP 3 of 5. Stereo training audio: the speaker synthesized, the listener
# retrieved from the bank, the timing predicted by KABURI.
#
#   qsub -V scripts/2026-09-15/real_aizuchi_stereo_500_v2.pbs
#
# Needs step 1 (the dialogues) and step 2 (the bank).
#
# Three passes, of which only the middle one uses the GPU:
#   Qwen3-TTS   the speaker side, V100
#   KABURI      where the listener comes in, CPU, no acoustic model
#   insert      bank clips into the silent listener channel, CPU
#
# The listener is never synthesized. Its audio comes from the bank, and
# rendering it in order to throw it away would also push the speaker's turns
# later on the timeline, since a listener turn that is not overlapped occupies
# time of its own.
#
# KEEP_TEXT=1 because step 1 already generated the words the corpus should
# hold. The rewrite pass runs only to write the speaker-only copy and the list
# of words the splice may substitute; it must not draw new words over the ones
# the model chose.
#
# What to read in the output: the line reporting how many backchannels KABURI
# placed INSIDE an utterance versus after one. Inside means overlap, which is
# what this route exists to produce; a measured KABURI run gave overlap 0.021
# against the paper's 0.096-0.161, so this is not to be assumed.
#
# V2 note: aizuchi_frequency_label rides through this step untouched. The
# rewrite pass preserves unknown dialogue fields, the TTS step copies the
# label into each sidecar's metadata.dialogue, and the splice pass rewrites
# only alignments and audio. Step 4 reads it from there. If you swap any of
# these three scripts, check the label still arrives before training.

# AIZUCHI_VOCAB_FILE must be the same file step 1 used. Without it the
# rewrite pass decides what is a backchannel by character count, and the
# opening greeting and the "are you still there?" reply get counted as
# backchannels too: the greeting is then dropped from the speaker-only copy
# and never synthesized, and the reply is looked up in a bank that does not
# hold it, so a clip of some other word is used instead.
#
# DROP_GREETING=1 keeps the corpus to backchannels only: the fixed opening
# ("moshi-moshi, this is the ...") is left out of the speaker-only copy, so it
# is never synthesized and appears in neither the audio nor the transcript.
# The reply to "are you still there?" is NOT dropped -- it is a real response
# the listener has to make, and the bank has no clip for it, so it has to be
# synthesized like any other non-backchannel listener turn.
#
# With no greeting the listener's first sound is its first backchannel, several
# seconds in, which leaves the density tag step 4 writes more room than it
# needs. LEAD_IN_SEC therefore stays at its default; widening it is only
# necessary when the greeting is kept.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export CORPUS_VERSION="${CORPUS_VERSION:-v2}"
export CORPUS_ROOT="real_aizuchi_500_${CORPUS_VERSION}"
export DIALOGUES_JSONL="$PWD/data/runs/$CORPUS_ROOT/dialogue/llm_dialogues/dialogues.jsonl"
export BANK_DIR="${BANK_DIR:-$PWD/data/runs/diversity/real_aizuchi_bank_${CORPUS_VERSION}}"
export OUT_ROOT="$PWD/data/runs/$CORPUS_ROOT/tts"
export NUM_DIALOGUES="${NUM_DIALOGUES:-500}"
export KEEP_TEXT=1
# See the notes above -- both matter for the greeting and the tag.
export AIZUCHI_VOCAB_FILE="${AIZUCHI_VOCAB_FILE:-$PWD/scripts/2026-09-15/aizuchi_vocab_no_bare_un.tsv}"
export DROP_GREETING="${DROP_GREETING:-1}"
export MATCH_TOP_K="${MATCH_TOP_K:-5}"

exec bash scripts/run_bank_stereo_test.sh "$NUM_DIALOGUES"
