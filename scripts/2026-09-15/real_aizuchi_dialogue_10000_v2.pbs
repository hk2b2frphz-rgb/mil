#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N ra_dlg10kv2
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# STEP 1 of 5. 10,000 listener-only dialogues, each generated at its own
# backchannel density and labeled with it.
#
#   qsub -V scripts/2026-09-15/real_aizuchi_dialogue_10000_v2.pbs
#
# RE-SUBMIT THE SAME FILE TO CONTINUE. 10,000 dialogues does not fit in one
# walltime. DIALOGUE_RESUME=1 keeps what is already in dialogues.jsonl and
# generates only the rest, so re-submitting picks up where it stopped.
#
# WHAT V2 IS FOR
#
# 1. Frequency becomes an input to the model, not just a property of the data.
#    Each dialogue records the density it was generated at, and step 4 writes
#    that into the listener's text stream as an unspoken tag. The model reads
#    it during training and can be given it at inference.
#
# 2. AIZUCHI_DENSITY_MIXED=1 draws a fresh density per dialogue. A corpus
#    where every dialogue carries the same tag teaches nothing about the tag --
#    there is no contrast to learn from. 10,000 dialogues spread over 0..1 is
#    what gives the tag its meaning, and is the main reason to run this scale
#    rather than the 500 (scripts/2026-09-15/real_aizuchi_dialogue_500_v2.pbs).
#
# 3. Placement is probability per clause boundary with the end of an utterance
#    guaranteed; word choice stays with the LLM. Vocabulary is the written
#    default minus bare "un".
#
# MAX_BLOCKS stays at 6. moshi-finetune splits any dialogue longer than
# duration_sec (170s) into equal chunks, and every chunk after the first starts
# mid-conversation with no opening greeting -- the model cannot tell such a
# chunk from the true start of a call and learns to open with a backchannel.
# Measure the rendered durations after step 3 and lower this if they run long:
#
#   uv run python scripts/build_training_manifest.py --dry-run \
#       --training-set data/runs/real_aizuchi_10000_v2/tts/placement_bank/shard_000/training_set
#
# IMPORTANT: step 2 must build its bank from the same AIZUCHI_VOCAB_FILE. The
# splice matches a clip to a backchannel by the word itself, so a mismatched
# bank makes every backchannel fall back to a length match with a different
# word -- the audio says something the transcript does not.
#
# A100 for the dialogue LLM (vLLM, Qwen3.6-27B).

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export CORPUS_VERSION="${CORPUS_VERSION:-v2}"
export NUM_CASES="${NUM_CASES:-10000}"
export BATCH_ID="real_aizuchi_10000_${CORPUS_VERSION}"
export OUT_ROOT="$PWD/data/runs/real_aizuchi_10000_${CORPUS_VERSION}/dialogue"
# Re-submitting continues instead of starting over. Required at this scale.
export DIALOGUE_RESUME="${DIALOGUE_RESUME:-1}"

export DIALOGUE_GENERATION_MODE="aizuchi-only"
# Position: probability per clause boundary, end of utterance guaranteed.
# Word: the same LLM call the rule-based route used, not a random draw.
export AIZUCHI_ONLY_PLACEMENT="density"
# Draw a fresh 0-1 density per dialogue. This is what makes the corpus
# conditionable; AIZUCHI_DENSITY is ignored while this is 1.
export AIZUCHI_DENSITY_MIXED="${AIZUCHI_DENSITY_MIXED:-1}"
export AIZUCHI_DENSITY="${AIZUCHI_DENSITY:-0.5}"
# Must match step 2's TEXTS_FILE exactly.
export AIZUCHI_VOCAB_FILE="$PWD/scripts/2026-09-15/aizuchi_vocab_no_bare_un.tsv"
# Density mode calls the same word-choice prompt builder as rule mode, so the
# example flag applies here too. Thinking stays llm-mode-only.
export AIZUCHI_ONLY_EXAMPLE="${AIZUCHI_ONLY_EXAMPLE:-0}"
export AIZUCHI_ENABLE_THINKING="${AIZUCHI_ENABLE_THINKING:-0}"
export AIZUCHI_THINKING_MAX_TOKENS="${AIZUCHI_THINKING_MAX_TOKENS:-1600}"
# Only read by AIZUCHI_ONLY_PLACEMENT=rule; inert here.
export AIZUCHI_ONLY_FREQUENCY="normal"

# Dialogue shape. Silences matter for a listener model: they are where it has
# to learn NOT to speak.
export AIZUCHI_ONLY_MIN_BLOCKS="${AIZUCHI_ONLY_MIN_BLOCKS:-4}"
export AIZUCHI_ONLY_MAX_BLOCKS="${AIZUCHI_ONLY_MAX_BLOCKS:-6}"
export AIZUCHI_ONLY_MAX_SILENCES="${AIZUCHI_ONLY_MAX_SILENCES:-2}"
export AIZUCHI_ONLY_SILENCE_RATE="${AIZUCHI_ONLY_SILENCE_RATE:-0.25}"
export AIZUCHI_ONLY_SILENCE_MIN_SEC="${AIZUCHI_ONLY_SILENCE_MIN_SEC:-2.0}"
export AIZUCHI_ONLY_SILENCE_MAX_SEC="${AIZUCHI_ONLY_SILENCE_MAX_SEC:-5.0}"
export AIZUCHI_ONLY_PROBE_RATE="${AIZUCHI_ONLY_PROBE_RATE:-0.5}"

exec bash scripts/run_dialogues_qwen_10000.pbs
