#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N kab_place
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# KABURI's timing, an existing corpus's audio, banked backchannels. No GPU.
#
#   qsub -V scripts/2026-09-15/aizuchi_normal_placement_bank.pbs
#   SOURCE_DIR=data/runs/<other_run>/training_set \
#     qsub -V scripts/2026-09-15/aizuchi_normal_placement_bank.pbs
#
# Interactive node equivalent:
#
#   bash scripts/run_kaburi_placement_bank.sh 3
#
# The counterpart to aizuchi_normal_kaburi_bank.pbs. That one renders the whole
# dialogue with KABURI and so needs an A100 for the bfloat16 codec. This one
# takes only what KABURI is actually wanted for -- where the backchannels go --
# and never loads the acoustic model at all. The timing model is a realizer
# plus a four-layer gap model and already ran on CPU inside the render job; all
# that changed is that the 5GB acoustic checkpoint is no longer loaded
# alongside it.
#
# So this queue is the V100 one purely because it is the cheaper reservation;
# nothing here uses the GPU. Minutes, for a handful of dialogues.
#
# SOURCE_DIR is an already rendered training_set whose user-side audio is kept
# as-is. Its listener channel is replaced: the backchannels move to KABURI's
# gaps and are re-voiced from the bank. It defaults to whatever this preset was
# already synthesized into -- the merged Qwen3 set, else a shard of it, else
# the newest Qwen3 smoke run -- and the resolved path is printed.
#
# Dialogues are paired by id rather than by filename, so a shard holding a
# slice of the corpus works as well as the merged set: sharding renumbers the
# sample_NNNNN stems, and matching those would pair up different dialogues.
#
# BANK_DIR defaults to the newest data/runs/diversity/* -- the temperature
# sweep is the better stock, being one word and 150 draws of it.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export NUM_DIALOGUES="${NUM_DIALOGUES:-3}"
export AIZUCHI_PRESET="${AIZUCHI_PRESET:-normal}"

exec bash scripts/run_kaburi_placement_bank.sh "$NUM_DIALOGUES"
