#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N ra_ft10kv2
#PBS -q xan_s
#PBS -l select=1:res=middle
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# STEP 5 of 5. Full fine-tuning on the tagged 10,000-dialogue corpus.
# Full-Duplex-Bench-JA runs automatically after best-checkpoint export.
#
#   qsub -V scripts/2026-09-15/real_aizuchi_fullft_10000_v2.pbs
#
# Re-submit to continue: the sweep carries itself across walltime.
#
# Defaults to the step-4 output (shard_000_conditioned). To train the
# unconditioned baseline for comparison, point it at step 3 instead:
#   qsub -V -v SRC_RUN_DIR=$PWD/data/runs/real_aizuchi_10000_v2/tts/placement_bank/shard_000 \
#       scripts/2026-09-15/real_aizuchi_fullft_10000_v2.pbs
# That A/B is worth running: it is the only way to tell whether the tag is
# doing anything, or whether the model is ignoring it and averaging over the
# densities it was trained on.
#
# Check the rendered durations before committing a reservation:
#   uv run python scripts/build_training_manifest.py --dry-run \
#       --training-set data/runs/real_aizuchi_10000_v2/tts/placement_bank/shard_000_conditioned/training_set
# Note the p95/max it prints include any lead-in pad step 4 added.
#
# 10,000 dialogues is the scale the f01 pattern was tuned on, so read this run
# as a result rather than as a check that the data trains at all.
#
# HOW TO READ THE RESULT
#
# The thing to measure is not just "does it backchannel" but "does the tag
# move the rate". Generate with the tag set to a low density and to a high one
# over the same speaker audio and count backchannels per minute. If the two
# come out the same, the model ignored the tag -- most likely because too few
# dialogues carried a distinct one (check step 1 ran with
# AIZUCHI_DENSITY_MIXED=1) or because too many lost it (check step 4 printed
# no density_tag_dropped WARNING).

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export CORPUS_VERSION="${CORPUS_VERSION:-v2}"
export RUN_ID="${RUN_ID:-real_aizuchi_10000_${CORPUS_VERSION}_fullft}"
export SRC_RUN_DIR="${SRC_RUN_DIR:-$PWD/data/runs/real_aizuchi_10000_${CORPUS_VERSION}/tts/placement_bank/shard_000_conditioned}"
export SWEEP_PATTERNS="${SWEEP_PATTERNS:-f01}"
# Overall eval loss can prefer an overly silent checkpoint. Keep the latest
# checkpoints too, so greeting and reaction behavior can be compared with the
# loss-best export before deployment.
export NU_KEEP_BEST_ONLY="0"
export SELF_PBS="scripts/2026-09-15/real_aizuchi_fullft_10000_v2.pbs"

exec bash scripts/fullft_sweep.pbs
