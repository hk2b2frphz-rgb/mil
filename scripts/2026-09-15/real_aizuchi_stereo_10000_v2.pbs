#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N ra_st10kv2
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# STEP 3 of 5. Stereo training audio for the 10,000-dialogue corpus: the
# speaker synthesized, the listener retrieved from the bank, the timing
# predicted by KABURI.
#
#   qsub -V scripts/2026-09-15/real_aizuchi_stereo_10000_v2.pbs
#
# Needs step 1 (the dialogues) and step 2 (the bank).
#
# RE-SUBMIT THE SAME FILE TO CONTINUE. RESUME=auto below makes the Qwen3-TTS
# pass keep the shards it already rendered, and start clean when there is
# nothing there yet (it decides by looking under OUT_ROOT). Without it a
# walltime cut throws away everything, which at this scale is most of a day.
# Not RESUME=1: that forces resume even on the first submission, when there is
# nothing to resume.
#
# NUM_SHARDS=4 uses all four V100s. run_bank_stereo_test.sh defaults to 1
# because it was written for 3-dialogue checks; 10,000 on one GPU does not
# finish. Both are plain overrides -- the smoke path keeps its old defaults.
#
# Three passes, of which only the middle one uses the GPU:
#   Qwen3-TTS   the speaker side, V100 x4
#   KABURI      where the listener comes in, CPU, no acoustic model
#   insert      bank clips into the silent listener channel, CPU
#
# The listener is never synthesized. Its audio comes from the bank, and
# rendering it in order to throw it away would also push the speaker's turns
# later on the timeline.
#
# KEEP_TEXT=1 because step 1 already generated the words the corpus should
# hold. The rewrite pass runs only to write the speaker-only copy and the list
# of words the splice may substitute.
#
# What to read in the output: the line reporting how many backchannels KABURI
# placed INSIDE an utterance versus after one. Inside means overlap, which is
# what this route exists to produce.
#
# aizuchi_frequency_label rides through untouched: the rewrite pass preserves
# unknown dialogue fields, the TTS step copies the label into each sidecar's
# metadata.dialogue, and the splice pass rewrites only alignments and audio.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export CORPUS_VERSION="${CORPUS_VERSION:-v2}"
export CORPUS_ROOT="real_aizuchi_10000_${CORPUS_VERSION}"
export DIALOGUES_JSONL="$PWD/data/runs/$CORPUS_ROOT/dialogue/llm_dialogues/dialogues.jsonl"
export BANK_DIR="${BANK_DIR:-$PWD/data/runs/diversity/real_aizuchi_bank_${CORPUS_VERSION}}"
export OUT_ROOT="$PWD/data/runs/$CORPUS_ROOT/tts"
export NUM_DIALOGUES="${NUM_DIALOGUES:-10000}"
export KEEP_TEXT=1
export MATCH_TOP_K="${MATCH_TOP_K:-5}"
# See the note above: both differ from the smoke defaults on purpose.
export NUM_SHARDS="${NUM_SHARDS:-4}"
export RESUME="${RESUME:-auto}"

exec bash scripts/run_bank_stereo_test.sh "$NUM_DIALOGUES"
