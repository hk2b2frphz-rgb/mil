#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N real_dialogue_pipe
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII characters anywhere in this file
# (not even in comments) -- the job dies immediately at submission.
#
# End-to-end preprocessing for a real-dialogue 1ch WAV. Just point it at a WAV.
#
#   Stage 1: diarization + transcription            (analyze_real_dialogue.py)
#   Stage 2: source separation + re-transcription   (separate_real_dialogue.py)
#
# After stage 2 the "split into 2 speakers" work is done. The manual steps and
# the eval job command are printed with real paths at the end of the job.
#
# Usage (this is all you need):
#   qsub -v 'WAVS=/path/dialogue1.wav' scripts/run_real_dialogue_pipeline.pbs
#
# Multiple files (comma separated, glob ok):
#   qsub -v 'WAVS=/path/a.wav,/path/b.wav' scripts/run_real_dialogue_pipeline.pbs
#   qsub -v 'WAVS=/path/sessions/*.wav'    scripts/run_real_dialogue_pipeline.pbs
#
# Optional:
#   OUT_DIR=data/real_dialogue/<name>  output root (default: data/real_dialogue/<jobid>)
#   SKIP_ANALYSIS=1                    skip stage 1 if already done
#   SKIP_SEPARATION=1                  run stage 1 only
#   WHISPER_MODEL=large-v3
#   SEP_MODEL=speechbrain/sepformer-whamr16k
#   SEP_SKIP_ASR=1                     separation only, skip re-transcription
#   DIAR_UV_WITH / SEP_UV_WITH         extra --with args for each uv env
#   DIAR_EXTRA_ARGS / SEP_EXTRA_ARGS   extra CLI args for the stage 1 / 2 python
#                                      scripts, e.g. --min-segment-sec 0.05
#                                      (default is 0.02) or --num-speakers 3
#
# Stage 1 and 2 have conflicting deps (NeMo wants numpy<2 and old transformers,
# SpeechBrain wants another line), so each runs in its own isolated uv env even
# though they are in the same job.

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

WAVS="${WAVS:?Set WAVS to one or more input wav paths (comma separated, glob ok)}"

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
OUT_DIR="${OUT_DIR:-data/real_dialogue/${JOB_ID_SHORT}}"

# comma separated -> array. globs are expanded here.
IFS=',' read -r -a wav_patterns <<< "$WAVS"
wav_files=()
for pat in "${wav_patterns[@]}"; do
    for f in $pat; do
        wav_files+=("$f")
    done
done
if [[ ${#wav_files[@]} -eq 0 ]]; then
    echo "ERROR: no wav files matched: $WAVS" >&2
    exit 1
fi
for f in "${wav_files[@]}"; do
    if [[ ! -f "$f" ]]; then
        echo "ERROR: not a file: $f" >&2
        exit 1
    fi
done

mkdir -p "$OUT_DIR"
LOG_FILE="${LOG_FILE:-$OUT_DIR/pipeline.log}"
exec > >(tee -a "$LOG_FILE") 2>&1

export PYTHONUNBUFFERED=1

banner() {
    echo ""
    echo "=================================================================="
    echo "$1"
    echo "  time: $(date -Is)"
    echo "=================================================================="
}

banner "real dialogue preprocessing pipeline - start"
echo "job:      ${JOB_ID_RAW}"
echo "host:     $(hostname)"
echo "inputs:   ${wav_files[*]}"
echo "out_dir:  $OUT_DIR"
echo "log:      $LOG_FILE"
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,memory.total --format=csv
fi

# per-WAV output dirs. Created up front so the guidance below can print real paths.
analysis_dirs=()
for f in "${wav_files[@]}"; do
    stem="$(basename "$f")"
    stem="${stem%.*}"
    analysis_dirs+=("$OUT_DIR/$stem")
done

# ------------------------------------------------------------------- stage 1
if [[ "${SKIP_ANALYSIS:-0}" == "1" ]]; then
    banner "stage 1: skipped (SKIP_ANALYSIS=1)"
else
    banner "stage 1/2: diarization + transcription"
    echo "model: nvidia/diar_streaming_sortformer_4spk-v2 (CC-BY-4.0, no token needed)"
    echo "This is the slowest part for long recordings."

    # shellcheck disable=SC2086
    uv run --no-project --python 3.11 \
        --index-url https://download.pytorch.org/whl/cu121 \
        --extra-index-url https://pypi.org/simple \
        --with 'torch==2.5.1' \
        --with 'torchvision==0.20.1' \
        --with 'torchaudio==2.5.1' \
        --with 'nemo_toolkit[asr]>=2.5.0' \
        --with faster-whisper \
        --with librosa \
        --with soundfile \
        --with 'numpy<2' \
        ${DIAR_UV_WITH:-} \
        python -u scripts/analyze_real_dialogue.py \
        "${wav_files[@]}" \
        --out-dir "$OUT_DIR" \
        ${WHISPER_MODEL:+--whisper-model "$WHISPER_MODEL"} \
        ${DIAR_EXTRA_ARGS:-}

    banner "stage 1 done -- you can listen now"
    for d in "${analysis_dirs[@]}"; do
        echo "$d"
        echo "  time-masked solo:  speaker_A_solo.wav / speaker_B_solo.wav"
        echo "  L/R preview:       stereo_diarized.wav"
        echo "  per utterance:     segments/A/ , segments/B/"
        echo "  stats:             stats.json"
    done
    echo ""
    echo "NOTE: the solo tracks at this stage only mute the other speaker's spans."
    echo "      The recording is 1ch, so the other voice still bleeds through in"
    echo "      overlap regions. Removing that is what stage 2 does."
fi

# ------------------------------------------------------------------- stage 2
if [[ "${SKIP_SEPARATION:-0}" == "1" ]]; then
    banner "stage 2: skipped (SKIP_SEPARATION=1)"
else
    banner "stage 2/2: source separation + re-transcription of separated tracks"
    echo "model: ${SEP_MODEL:-speechbrain/sepformer-whamr16k} (Apache-2.0)"
    echo "Channel-to-speaker assignment comes from the stage 1 diarization."

    sep_extra=""
    if [[ "${SEP_SKIP_ASR:-0}" == "1" ]]; then
        sep_extra="--skip-asr"
        echo "SEP_SKIP_ASR=1: skipping re-transcription."
    fi

    # shellcheck disable=SC2086
    uv run --no-project --python 3.11 \
        --index-url https://download.pytorch.org/whl/cu121 \
        --extra-index-url https://pypi.org/simple \
        --with 'torch==2.5.1' \
        --with 'torchaudio==2.5.1' \
        --with 'speechbrain>=1.0.0' \
        --with faster-whisper \
        --with librosa \
        --with soundfile \
        --with 'numpy<2' \
        ${SEP_UV_WITH:-} \
        python -u scripts/separate_real_dialogue.py \
        "${wav_files[@]}" \
        --out-dir "$OUT_DIR" \
        ${SEP_MODEL:+--sep-model "$SEP_MODEL"} \
        ${WHISPER_MODEL:+--whisper-model "$WHISPER_MODEL"} \
        $sep_extra ${SEP_EXTRA_ARGS:-}

    banner "stage 2 done -- separation into 2 speakers is complete"
fi

# ------------------------------------------------------------- results / next
banner "results and next steps"

for d in "${analysis_dirs[@]}"; do
    echo "------------------------------------------------------------------"
    echo "$d"
    if [[ -f "$d/separation_report.json" ]]; then
        chunks=$(grep -o '"chunks":[[:space:]]*[0-9]*' "$d/separation_report.json" | head -1 | tr -dc '0-9')
        inherited=$(grep -o '"inherited_assignments":[[:space:]]*[0-9]*' "$d/separation_report.json" | head -1 | tr -dc '0-9')
        echo "  separated chunks: ${chunks:-?} (inherited assignments: ${inherited:-?})"
        echo "    A high inherited count means many chunks had weak assignment cues."
        echo "    If that worries you, re-run with a shorter --chunk-sec."
    fi
    echo "  [what to listen to]"
    echo "    separated tracks: $d/separated/A.wav , $d/separated/B.wav"
    echo "    L/R side by side: $d/separated/stereo.wav"
    echo "    per utterance:    $d/segments_separated/A/ , $d/segments_separated/B/"
    echo "  [what to check specifically]"
    echo "    Files with _ov in the name are overlap spans. Whether the other"
    echo "    speaker's backchannel is gone there is the pass/fail point."
    echo "    Also check that non-overlapping utterances are not muffled or metallic."
done

echo ""
echo "=================================================================="
echo "next steps (manual)"
echo "=================================================================="
echo ""
echo "1) Decide which speaker is the counselor and drop an empty marker file"
for d in "${analysis_dirs[@]}"; do
    echo "     touch $d/counselor_B.txt     # counselor is B"
    echo "     touch $d/counselor_A.txt     # counselor is A (exactly one of the two)"
done
echo ""
echo "2) Prune the test data (rows with keep=0 are excluded from eval)"
for d in "${analysis_dirs[@]}"; do
    echo "     $d/A_segments_review.tsv"
    echo "     $d/B_segments_review.tsv"
done
echo ""
echo "3) Submit the eval job. Pass the paths below to ANALYSIS_DIRS as-is."
echo "   (Separate multiple dirs with SPACES. qsub -v treats a comma as a"
echo "    variable separator, so commas must not be used here.)"
echo ""
printf '     qsub -v '\''MODEL_ID=lora_h01,MODEL_WEIGHT=/path/model.safetensors,ANALYSIS_DIRS=%s'\'' \\\n' "${analysis_dirs[*]}"
echo "       scripts/run_real_dialogue_eval.pbs"
echo ""
echo "log: $LOG_FILE"
echo "finished_at: $(date -Iseconds)"
