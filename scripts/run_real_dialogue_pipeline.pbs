#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N real_dialogue_pipe
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

# 実対話 1ch WAV の前処理を通しで実行する。WAV を指定するだけでよい。
#
#   ステージ1: ダイアライゼーション + 書き起こし   (analyze_real_dialogue.py)
#   ステージ2: 音源分離 + 分離トラックで再書き起こし (separate_real_dialogue.py)
#
# ここまでで「2 話者に分ける」作業は完了する。この後の人手作業と評価ジョブの
# 投げ方は、ジョブ末尾に実際のパス入りで出力される。
#
# 使い方(これだけ):
#   qsub -v 'WAVS=/path/dialogue1.wav' scripts/run_real_dialogue_pipeline.pbs
#
# 複数ファイル(カンマ区切り、glob 可):
#   qsub -v 'WAVS=/path/a.wav,/path/b.wav' scripts/run_real_dialogue_pipeline.pbs
#   qsub -v 'WAVS=/path/sessions/*.wav'    scripts/run_real_dialogue_pipeline.pbs
#
# 任意:
#   OUT_DIR=data/real_dialogue/<name>  出力ルート(既定: data/real_dialogue/<jobid>)
#   SKIP_ANALYSIS=1                    ステージ1 が済んでいる場合に飛ばす
#   SKIP_SEPARATION=1                  ステージ1 だけ回す
#   WHISPER_MODEL=large-v3
#   SEP_MODEL=speechbrain/sepformer-whamr16k
#   SEP_SKIP_ASR=1                     分離結果だけ先に聴きたいとき(再書き起こし省略)
#   DIAR_UV_WITH / SEP_UV_WITH         各 uv 環境への追加 --with 引数
#
# ステージ1 と 2 は依存が衝突する(NeMo は numpy<2 と古い transformers を要求し、
# SpeechBrain は別系統)ため、同じジョブ内でも別々の隔離 uv 環境で実行する。

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

WAVS="${WAVS:?Set WAVS to one or more input wav paths (comma separated, glob ok)}"

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
OUT_DIR="${OUT_DIR:-data/real_dialogue/${JOB_ID_SHORT}}"

# カンマ区切り -> 配列。glob はここで展開される。
IFS=',' read -r -a wav_patterns <<< "$WAVS"
wav_files=()
for pat in "${wav_patterns[@]}"; do
    for f in $pat; do
        wav_files+=("$f")
    done
done
if [[ ${#wav_files[@]} -eq 0 ]]; then
    echo "ERROR: no wav files matched: $WAVS" >&2
    exit 1
fi
for f in "${wav_files[@]}"; do
    if [[ ! -f "$f" ]]; then
        echo "ERROR: not a file: $f" >&2
        exit 1
    fi
done

mkdir -p "$OUT_DIR"
LOG_FILE="${LOG_FILE:-$OUT_DIR/pipeline.log}"
exec > >(tee -a "$LOG_FILE") 2>&1

export PYTHONUNBUFFERED=1

banner() {
    echo ""
    echo "=================================================================="
    echo "$1"
    echo "  時刻: $(date -Is)"
    echo "=================================================================="
}

banner "実対話 前処理パイプライン 開始"
echo "job:      ${JOB_ID_RAW}"
echo "host:     $(hostname)"
echo "inputs:   ${wav_files[*]}"
echo "out_dir:  $OUT_DIR"
echo "log:      $LOG_FILE"
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,memory.total --format=csv
fi

# WAV ごとの出力ディレクトリ。以降の案内で実パスを出すために先に作っておく。
analysis_dirs=()
for f in "${wav_files[@]}"; do
    stem="$(basename "$f")"
    stem="${stem%.*}"
    analysis_dirs+=("$OUT_DIR/$stem")
done

# ---------------------------------------------------------------- ステージ1
if [[ "${SKIP_ANALYSIS:-0}" == "1" ]]; then
    banner "ステージ1: スキップ (SKIP_ANALYSIS=1)"
else
    banner "ステージ1/2: ダイアライゼーション + 書き起こし"
    echo "使用モデル: nvidia/diar_streaming_sortformer_4spk-v2 (CC-BY-4.0, トークン不要)"
    echo "長い音声ではここが最も時間を要します。"

    # shellcheck disable=SC2086
    uv run --no-project --python 3.11 \
        --index-url https://download.pytorch.org/whl/cu121 \
        --extra-index-url https://pypi.org/simple \
        --with 'torch==2.5.1' \
        --with 'torchvision==0.20.1' \
        --with 'torchaudio==2.5.1' \
        --with 'nemo_toolkit[asr]>=2.5.0' \
        --with faster-whisper \
        --with librosa \
        --with soundfile \
        --with 'numpy<2' \
        ${DIAR_UV_WITH:-} \
        python -u scripts/analyze_real_dialogue.py \
        "${wav_files[@]}" \
        --out-dir "$OUT_DIR" \
        ${WHISPER_MODEL:+--whisper-model "$WHISPER_MODEL"}

    banner "ステージ1 完了 — ここで一度聴けます"
    for d in "${analysis_dirs[@]}"; do
        echo "$d"
        echo "  時間マスクの solo:  speaker_A_solo.wav / speaker_B_solo.wav"
        echo "  L/R プレビュー:     stereo_diarized.wav"
        echo "  発話ごと:           segments/A/ , segments/B/"
        echo "  統計:               stats.json"
    done
    echo ""
    echo "注意: この段階の solo トラックは「相手の区間を無音化」しただけです。"
    echo "      1ch 録音なので重畳区間には相手の声が残っています。それを消すのが"
    echo "      次のステージ2 です。"
fi

# ---------------------------------------------------------------- ステージ2
if [[ "${SKIP_SEPARATION:-0}" == "1" ]]; then
    banner "ステージ2: スキップ (SKIP_SEPARATION=1)"
else
    banner "ステージ2/2: 音源分離 + 分離トラックで再書き起こし"
    echo "使用モデル: ${SEP_MODEL:-speechbrain/sepformer-whamr16k} (Apache-2.0)"
    echo "チャネルの帰属はステージ1 のダイアライゼーション結果で決めます。"

    sep_extra=""
    if [[ "${SEP_SKIP_ASR:-0}" == "1" ]]; then
        sep_extra="--skip-asr"
        echo "SEP_SKIP_ASR=1: 再書き起こしは省略します。"
    fi

    # shellcheck disable=SC2086
    uv run --no-project --python 3.11 \
        --index-url https://download.pytorch.org/whl/cu121 \
        --extra-index-url https://pypi.org/simple \
        --with 'torch==2.5.1' \
        --with 'torchaudio==2.5.1' \
        --with 'speechbrain>=1.0.0' \
        --with faster-whisper \
        --with librosa \
        --with soundfile \
        --with 'numpy<2' \
        ${SEP_UV_WITH:-} \
        python -u scripts/separate_real_dialogue.py \
        "${wav_files[@]}" \
        --out-dir "$OUT_DIR" \
        ${SEP_MODEL:+--sep-model "$SEP_MODEL"} \
        ${WHISPER_MODEL:+--whisper-model "$WHISPER_MODEL"} \
        $sep_extra

    banner "ステージ2 完了 — 2 話者への分離まで終わりました"
fi

# ---------------------------------------------------------------- 結果の案内
banner "結果と次の手順"

for d in "${analysis_dirs[@]}"; do
    echo "------------------------------------------------------------------"
    echo "$d"
    if [[ -f "$d/separation_report.json" ]]; then
        chunks=$(grep -o '"chunks":[[:space:]]*[0-9]*' "$d/separation_report.json" | head -1 | tr -dc '0-9')
        inherited=$(grep -o '"inherited_assignments":[[:space:]]*[0-9]*' "$d/separation_report.json" | head -1 | tr -dc '0-9')
        echo "  分離チャンク数: ${chunks:-?} (割り当て継承: ${inherited:-?})"
        echo "    継承が多い場合は手がかりが弱い区間が多かったということです。"
        echo "    気になるときは SEP_UV_WITH ではなく --chunk-sec を短くして再実行します。"
    fi
    echo "  【聴くもの】"
    echo "    分離トラック: $d/separated/A.wav , $d/separated/B.wav"
    echo "    L/R 同時確認: $d/separated/stereo.wav"
    echo "    発話ごと:     $d/segments_separated/A/ , $d/segments_separated/B/"
    echo "  【特に確認してほしい点】"
    echo "    ファイル名に _ov が付いた発話 = 重畳区間。ここで相手の相槌が"
    echo "    消えているかが分離成否の判定点です。"
    echo "    重畳のない単独発話がこもったり金属的になっていないかも見てください。"
done

echo ""
echo "=================================================================="
echo "次にやること(人手)"
echo "=================================================================="
echo ""
echo "1) 相談員側の話者を決めて、空ファイルを置く"
for d in "${analysis_dirs[@]}"; do
    echo "     touch $d/counselor_B.txt     # 相談員が B の場合"
    echo "     touch $d/counselor_A.txt     # 相談員が A の場合(どちらか一方だけ)"
done
echo ""
echo "2) テストデータを間引く(keep 列を 0 にした行が評価から外れる)"
for d in "${analysis_dirs[@]}"; do
    echo "     $d/A_segments_review.tsv"
    echo "     $d/B_segments_review.tsv"
done
echo ""
echo "3) 評価ジョブを投げる。ANALYSIS_DIRS には下のパスをそのまま渡す"
echo "   (複数ある場合はスペース区切り。qsub -v はカンマを変数区切りとして"
echo "    解釈するので、カンマにしてはいけません)"
echo ""
printf '     qsub -v '\''MODEL_ID=lora_h01,MODEL_WEIGHT=/path/model.safetensors,ANALYSIS_DIRS=%s'\'' \\\n' "${analysis_dirs[*]}"
echo "       scripts/run_real_dialogue_eval.pbs"
echo ""
echo "log: $LOG_FILE"
echo "finished_at: $(date -Iseconds)"
