#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N qwen_tts_whole_10000_4gpu
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# Qwen3-TTS whole-utterance production: per-speaker concatenated TTS + MMS_FA
# forced alignment, with aizuchi merge and style presets. 4-GPU parallel shards.
#
# 10000-dialogue scale. The 1000-dialogue run took ~12h wall on 4 GPUs, so
# 10000 is ~120h of compute -- far past any single reservation. Instead of one
# giant walltime this job RESUMES: walltime=24:00:00 (the value every other TTS
# job here uses), and you just re-submit the SAME script until it finishes.
#
# Each re-submit continues where the previous one was killed:
#   * per-shard   -- finished shards are skipped (no model reload);
#   * per-dialogue -- generate_qwen3_tts_data.py --resume skips dialogues whose
#                     WAV+JSON already exist and only renders the remainder.
# Roughly ~6 back-to-back 24h jobs cover 10000; the run is done once the final
# "merged_manifest" line appears (step 3/3 succeeds).
#
# Submit (repeat until it prints the merged manifest):
#   qsub -V scripts/run_qwen_tts_whole_utterance_10000_4gpu.pbs
#
# Chain them so you don't babysit (each waits for the previous jobid):
#   j=$(qsub -V scripts/run_qwen_tts_whole_utterance_10000_4gpu.pbs)
#   for _ in 1 2 3 4 5; do
#     j=$(qsub -V -W depend=afterany:"$j" scripts/run_qwen_tts_whole_utterance_10000_4gpu.pbs)
#   done
#
# Useful overrides:
#   NUM_SHARDS=4
#   CUDA_VISIBLE_DEVICES=0,1,2,3
#   SOURCE_BATCH_ID=qwen_dialogues_10000
#   STYLE_PRESET=auto             (auto: pick voice tone/tempo per dialogue from emotional_state in dialogues.jsonl)
#   NUM_DIALOGUES=all
#   FRESH=1     # ignore any existing output and start a new timestamped run
#   RESUME=0    # force a clean re-render into the same dir (default: auto)

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
    # shellcheck source=/dev/null
    source "$PWD/scripts/setup_proxy.sh"
fi
# shellcheck source=/dev/null
source "$PWD/scripts/run_id_utils.sh"

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

# Matches the versioned default BATCH_ID of run_dialogues_qwen_10000.pbs, so a
# freshly generated batch is picked up automatically. Bump DIALOGUES_VERSION
# (or set SOURCE_BATCH_ID) to point at another batch.
export SOURCE_BATCH_ID="${SOURCE_BATCH_ID:-qwen_dialogues_10000_${DIALOGUES_VERSION:-v1}}"

# Default to Kokoro at this scale: Qwen3-TTS is too slow to finish 10000
# dialogues within realistic walltimes. Kokoro ignores emotion/style instructs
# (STYLE_PRESET becomes a no-op) but is an order of magnitude faster.
# Set TTS_BACKEND=qwen3 to restore the old behavior.
export TTS_BACKEND="${TTS_BACKEND:-kokoro}"

# Clone references are meaningful only to Qwen3. Reject them before resolving
# the Qwen voice mode so a direct Kokoro submission cannot infer mixed/clone,
# skip reference resolution, and fail later while fingerprinting an empty path.
requested_qwen_voice_mode="${QWEN_VOICE_MODE:-auto}"
if [[ "$TTS_BACKEND" != "qwen3" ]]; then
    if [[ "$requested_qwen_voice_mode" == "clone" \
          || "$requested_qwen_voice_mode" == "mixed" \
          || -n "${CLONE_OUT_DIR_MOSHI:-}${MOSHI_REF_WAV:-}${MOSHI_REF_TEXT:-}" \
          || -n "${CLONE_OUT_DIR_USER:-}${USER_REF_WAV:-}${USER_REF_TEXT:-}" ]]; then
        echo "ERROR: Qwen clone/mixed voices require TTS_BACKEND=qwen3 (got $TTS_BACKEND)" >&2
        exit 1
    fi
fi

# The vLLM wrapper resolves this before exec, but keep the production script
# safe when it is submitted directly as well.
resolve_qwen_voice_mode() {
    local requested="${QWEN_VOICE_MODE:-auto}"
    local moshi_audio=0 user_audio=0 moshi_any=0 user_any=0
    [[ -n "${CLONE_OUT_DIR_MOSHI:-}${MOSHI_REF_WAV:-}" ]] && moshi_audio=1
    [[ -n "${CLONE_OUT_DIR_USER:-}${USER_REF_WAV:-}" ]] && user_audio=1
    [[ "$moshi_audio" == "1" || -n "${MOSHI_REF_TEXT:-}" ]] && moshi_any=1
    [[ "$user_audio" == "1" || -n "${USER_REF_TEXT:-}" ]] && user_any=1

    if [[ "$moshi_any" == "1" && "$moshi_audio" == "0" ]]; then
        echo "ERROR: MOSHI_REF_TEXT was set without CLONE_OUT_DIR_MOSHI or MOSHI_REF_WAV" >&2
        return 1
    fi
    if [[ "$user_any" == "1" && "$user_audio" == "0" ]]; then
        echo "ERROR: USER_REF_TEXT was set without CLONE_OUT_DIR_USER or USER_REF_WAV" >&2
        return 1
    fi

    case "$requested" in
        auto)
            if [[ "$moshi_audio" == "1" && "$user_audio" == "1" ]]; then
                printf 'clone'
            elif [[ "$moshi_audio" == "1" ]]; then
                printf 'mixed'
            elif [[ "$user_audio" == "1" ]]; then
                echo "ERROR: a user clone source without a moshi clone source is unsupported" >&2
                return 1
            else
                printf 'customvoice'
            fi
            ;;
        customvoice)
            if [[ "$moshi_any" == "1" || "$user_any" == "1" ]]; then
                echo "ERROR: QWEN_VOICE_MODE=customvoice conflicts with clone reference variables" >&2
                return 1
            fi
            printf 'customvoice'
            ;;
        mixed)
            if [[ "$moshi_audio" == "0" || "$user_any" == "1" ]]; then
                echo "ERROR: QWEN_VOICE_MODE=mixed needs only a moshi clone source" >&2
                return 1
            fi
            printf 'mixed'
            ;;
        clone)
            if [[ "$moshi_audio" == "0" || "$user_audio" == "0" ]]; then
                echo "ERROR: QWEN_VOICE_MODE=clone needs both moshi and user clone sources" >&2
                return 1
            fi
            printf 'clone'
            ;;
        *)
            echo "ERROR: QWEN_VOICE_MODE must be auto, customvoice, clone, or mixed: $requested" >&2
            return 1
            ;;
    esac
}
export QWEN_VOICE_MODE="$(resolve_qwen_voice_mode)"

# Stable (non-timestamped) batch id so re-submitting the same job resumes into
# the same output dir instead of starting a brand-new run. Pass FRESH=1 to
# force a clean, uniquely-timestamped run instead.
case "$QWEN_VOICE_MODE" in
    customvoice) default_batch_id="${SOURCE_BATCH_ID}_tts_whole_4gpu" ;;
    clone)       default_batch_id="${SOURCE_BATCH_ID}_tts_whole_clone_4gpu" ;;
    mixed)       default_batch_id="${SOURCE_BATCH_ID}_tts_whole_mixed_4gpu" ;;
esac
if [[ "${FRESH:-0}" == "1" ]]; then
    export BATCH_ID="${BATCH_ID:-$(default_run_id "$default_batch_id")}"
else
    export BATCH_ID="${BATCH_ID:-$default_batch_id}"
fi
if ! [[ "$BATCH_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: BATCH_ID may contain only letters, digits, dot, underscore, hyphen." >&2
    exit 1
fi
export RUN_ID="$BATCH_ID"
export DIALOGUES_JSONL="${DIALOGUES_JSONL:-$PWD/data/runs/${SOURCE_BATCH_ID}/llm_dialogues/dialogues.jsonl}"
export OUT_ROOT="${OUT_ROOT:-$PWD/data/runs/$BATCH_ID}"
# RESUME=auto (default): continue a partially-rendered batch if one already
# exists under OUT_ROOT, otherwise start fresh. RESUME=1 forces resume;
# RESUME=0 forces a clean (re-)render of every shard. This makes a job that
# hit the walltime limit safe to just re-submit -- it picks up where it left
# off (per-shard and, via generate_qwen3_tts_data.py --resume, per-dialogue).
# This matters most at 10000 scale: split the wall time across several shorter
# jobs (e.g. walltime=24:00:00) and re-submit until the merge step succeeds.
export RESUME="${RESUME:-auto}"
if [[ "$RESUME" == "auto" ]]; then
    if compgen -G "$OUT_ROOT/shard_*/training_set/synthetic_moshi_train.jsonl" >/dev/null 2>&1 \
       || compgen -G "$OUT_ROOT/shard_*/training_set/.qwen_mixed_cache/*/config.json" >/dev/null 2>&1; then
        RESUME=1
    else
        RESUME=0
    fi
fi
if [[ "$RESUME" != "0" && "$RESUME" != "1" ]]; then
    echo "ERROR: RESUME must be 0, 1, or auto: $RESUME" >&2
    exit 1
fi
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"
export NUM_SHARDS="${NUM_SHARDS:-4}"
export NUM_DIALOGUES="${NUM_DIALOGUES:-all}"
export TTS_DTYPE="${TTS_DTYPE:-float16}"
export TTS_DEVICE="${TTS_DEVICE:-cuda}"
export LEAD_IN_SEC="${LEAD_IN_SEC:-0.3}"
export GAP_SEC="${GAP_SEC:-0.2}"
export STYLE_PRESET="${STYLE_PRESET:-none}"
# Default STYLE_PRESET=none uses raw tempo without a style instruct.
# Set STYLE_PRESET=auto for the former domain-C-style slower tone.
export QWEN_ENGINE="${QWEN_ENGINE:-transformers}"
if [[ "$QWEN_VOICE_MODE" == "clone" ]]; then
    export QWEN_TTS_MODEL="${QWEN_TTS_MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-Base}"
else
    export QWEN_TTS_MODEL="${QWEN_TTS_MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice}"
fi
export QWEN_CLONE_MODEL="${QWEN_CLONE_MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-Base}"
export USER_SPEAKER_POOL="${USER_SPEAKER_POOL:-Ono_Anna,Sohee,Vivian,Dylan,Eric,Aiden}"
export SPEAKER_USER="${SPEAKER_USER:-Ono_Anna}"
export SPEAKER_MOSHI="${SPEAKER_MOSHI:-Serena}"
export SPEAKER_OTHER="${SPEAKER_OTHER:-Dylan}"
export SPEAKER_BACKGROUND="${SPEAKER_BACKGROUND:-Ryan}"
export INSTRUCT_USER="${INSTRUCT_USER:-}"
export INSTRUCT_MOSHI="${INSTRUCT_MOSHI:-}"
export TTS_LANGUAGE="${TTS_LANGUAGE:-Japanese}"
export CLONE_MODE="${CLONE_MODE:-in-context}"
# ref01 is the adopted moshi reference for production. Set REF_RANK=0 to go
# back to the longest clean segment.
export REF_RANK="${REF_RANK:-1}"
export TTS_BATCH_SIZE="${TTS_BATCH_SIZE:-16}"
export DIALOGUE_BATCH_SIZE="${DIALOGUE_BATCH_SIZE:-16}"
export VLLM_MAX_NEW_TOKENS="${VLLM_MAX_NEW_TOKENS:-2048}"
export QWEN_CLONE_MAX_NEW_TOKENS="${QWEN_CLONE_MAX_NEW_TOKENS:-4096}"
export WHOLE_UTTERANCE_MAX_CHARS="${WHOLE_UTTERANCE_MAX_CHARS:-150}"
export VLLM_STAGE_CONFIG="${VLLM_STAGE_CONFIG:-$PWD/configs/qwen3_tts_v100_batch16.yaml}"
export VLLM_PYTHON="${VLLM_PYTHON:-$PWD/.venv-vllm-omni/bin/python}"
export KOKORO_VOICE_MOSHI="${KOKORO_VOICE_MOSHI:-jf_alpha}"
export KOKORO_USER_VOICES="${KOKORO_USER_VOICES:-jf_gongitsune,jf_nezumi,jf_tebukuro,jm_kumo}"
# Throttles generate_qwen3_tts_data.py's per-dialogue progress logging (every
# LOG_EVERY dialogues instead of every one) to keep shard_*.log from growing
# unbounded on large runs. Set LOG_EVERY=1 or VERBOSE=1 for full per-call
# detail when debugging a specific shard.
export LOG_EVERY="${LOG_EVERY:-20}"
export VERBOSE="${VERBOSE:-0}"
# Fraction of each shard's dialogue count added as spare dialogues so that
# per-dialogue synthesis/CTC-alignment failures (e.g. "target_length is too
# long for CTC") can be compensated without the final merged training set
# falling short of NUM_DIALOGUES. Spares are only consumed when a primary
# dialogue in the shard fails. Non-mixed backends synthesize spares only after
# a primary failure. Mixed mode must finish both model passes before alignment,
# so it pre-synthesizes the spare set too (up to this additional fraction).
export SPARE_RATIO="${SPARE_RATIO:-0.15}"

if ! [[ "$NUM_SHARDS" =~ ^[0-9]+$ ]] || [[ "$NUM_SHARDS" -lt 1 ]]; then
    echo "ERROR: NUM_SHARDS must be a positive integer: $NUM_SHARDS" >&2
    exit 1
fi
if [[ "$NUM_DIALOGUES" != "all" ]]; then
    if ! [[ "$NUM_DIALOGUES" =~ ^[0-9]+$ ]] || [[ "$NUM_DIALOGUES" -lt 1 ]]; then
        echo "ERROR: NUM_DIALOGUES must be a positive integer or 'all': $NUM_DIALOGUES" >&2
        exit 1
    fi
fi
if [[ "$QWEN_VOICE_MODE" != "customvoice" \
      && "$QWEN_VOICE_MODE" != "clone" && "$QWEN_VOICE_MODE" != "mixed" ]]; then
    echo "ERROR: resolved QWEN_VOICE_MODE is invalid: $QWEN_VOICE_MODE" >&2
    exit 1
fi
if [[ "$CLONE_MODE" != "in-context" && "$CLONE_MODE" != "x-vector" ]]; then
    echo "ERROR: CLONE_MODE must be in-context or x-vector: $CLONE_MODE" >&2
    exit 1
fi
if ! [[ "$REF_RANK" =~ ^[0-9]+$ ]]; then
    echo "ERROR: REF_RANK must be a non-negative integer: $REF_RANK" >&2
    exit 1
fi
for numeric_setting in \
    "$VLLM_MAX_NEW_TOKENS" "$QWEN_CLONE_MAX_NEW_TOKENS" "$WHOLE_UTTERANCE_MAX_CHARS"; do
    if ! [[ "$numeric_setting" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR: token/character limits must be positive integers: $numeric_setting" >&2
        exit 1
    fi
done
IFS=',' read -r -a GPU_IDS <<< "$CUDA_VISIBLE_DEVICES"
if [[ "${#GPU_IDS[@]}" -lt "$NUM_SHARDS" ]]; then
    echo "ERROR: CUDA_VISIBLE_DEVICES has ${#GPU_IDS[@]} GPU(s), but NUM_SHARDS=$NUM_SHARDS" >&2
    exit 1
fi
if [[ ! -s "$DIALOGUES_JSONL" ]]; then
    echo "ERROR: dialogues JSONL was not found or is empty: $DIALOGUES_JSONL" >&2
    exit 1
fi

mkdir -p "$OUT_ROOT" "$OUT_ROOT/logs" experiments/pbs_logs
JOB_TAG="${PBS_JOBID:-local}"
JOB_TAG="${JOB_TAG%%.*}"
JOB_LOG="experiments/pbs_logs/${BATCH_ID}_${JOB_TAG:-local}.log"
JOB_STARTED_EPOCH="$(date +%s)"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== TTS whole-utterance production 10000 (4 GPU, backend=$TTS_BACKEND) ====="
echo "job_id:        ${PBS_JOBID:-n/a}"
echo "host:          $(hostname)"
echo "tts_backend:   $TTS_BACKEND"
echo "qwen_engine:   $QWEN_ENGINE"
echo "qwen_voice:    $QWEN_VOICE_MODE"
echo "qwen_model:    $QWEN_TTS_MODEL"
echo "clone_model:   $QWEN_CLONE_MODEL"
echo "tts_batch:     $TTS_BATCH_SIZE (dialogues=$DIALOGUE_BATCH_SIZE)"
echo "source_batch:  $SOURCE_BATCH_ID"
echo "out_root:      $OUT_ROOT"
echo "resume:        $RESUME"
echo "dialogues:     $DIALOGUES_JSONL"
echo "num_dialogues: $NUM_DIALOGUES"
echo "num_shards:    $NUM_SHARDS"
echo "spare_ratio:   $SPARE_RATIO"
echo "log_every:     $LOG_EVERY"
echo "verbose:       $VERBOSE"
echo "gpus:          $CUDA_VISIBLE_DEVICES"
echo "dtype:         $TTS_DTYPE"
echo "style_preset:  $STYLE_PRESET"
echo "timing:        lead_in=$LEAD_IN_SEC gap=$GAP_SEC"
echo "mode:          whole-utterance (MMS_FA alignment)"
echo "started_at:    $(date -Iseconds)"
echo "============================================================="

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

echo "===== step 0/3: uv environment preflight ====="
# Kokoro is not part of the main project env (its misaki[ja]/unidic deps are
# heavy and conflict-prone), so it runs in an isolated uv env pinned to the
# main env's torch/torchaudio -- the same pattern as run_tts_comparison.pbs.
GEN_CMD=(uv run python)
if [[ "$TTS_BACKEND" == "kokoro" ]]; then
    TORCH_VERSION="$(uv run python -c 'import torch; print(torch.__version__)')"
    TORCHAUDIO_VERSION="$(uv run python -c 'import torchaudio; print(torchaudio.__version__)')"
    GEN_UV=(
        uv run --isolated --no-project
        --index "pytorch-cu121=https://download.pytorch.org/whl/cu121"
        --with "kokoro>=0.9.4"
        --with "misaki[ja]"
        --with unidic
        --with pyopenjtalk
        --with numpy
        --with sphn
        --with soundfile
        --with uroman
        --with "torch==$TORCH_VERSION"
        --with "torchaudio==$TORCHAUDIO_VERSION"
    )
    # fugashi (via misaki[ja]) needs the full unidic dictionary downloaded once;
    # the identical --with set below reuses this cached env.
    echo "[kokoro] downloading unidic dictionary..."
    "${GEN_UV[@]}" python -m unidic download
    "${GEN_UV[@]}" python - <<'PY'
import numpy  # noqa: F401
import sphn  # noqa: F401
from kokoro import KPipeline  # noqa: F401
import torchaudio  # noqa: F401
print("kokoro/torchaudio preflight ok")
PY
    GEN_CMD=("${GEN_UV[@]}" python)
elif [[ "$QWEN_ENGINE" == "vllm-omni" ]]; then
    if [[ "$TTS_BACKEND" != "qwen3" ]]; then
        echo "ERROR: QWEN_ENGINE=vllm-omni requires TTS_BACKEND=qwen3" >&2
        exit 1
    fi
    if [[ ! -x "$VLLM_PYTHON" ]]; then
        echo "ERROR: vLLM Python not found: $VLLM_PYTHON" >&2
        echo "Run scripts/setup_vllm_omni_v100_env.sh first." >&2
        exit 1
    fi
    if [[ ! -s "$VLLM_STAGE_CONFIG" ]]; then
        echo "ERROR: vLLM stage config not found: $VLLM_STAGE_CONFIG" >&2
        exit 1
    fi
    if ! "$VLLM_PYTHON" scripts/patch_vllm_omni_qwen3_tts_v100.py --check; then
        echo "ERROR: the vLLM-Omni Qwen3-TTS V100 patch is missing or stale." >&2
        echo "Re-run scripts/setup_vllm_omni_v100_env.sh, then submit this job again." >&2
        exit 1
    fi
    "$VLLM_PYTHON" - <<'PY'
import numpy  # noqa: F401
import soundfile  # noqa: F401
import sphn  # noqa: F401
import torch
import torchaudio  # noqa: F401
import vllm  # noqa: F401
import vllm_omni  # noqa: F401
if not torch.cuda.is_available():
    raise SystemExit("CUDA is unavailable in the vLLM-Omni environment")
major, minor = torch.cuda.get_device_capability()
if (major, minor) != (7, 0):
    print(f"warning: expected V100 sm70, found sm{major}{minor}")
print("vllm-omni/V100/torchaudio preflight ok")
PY
    GEN_CMD=("$VLLM_PYTHON")
else
    uv run python - <<'PY'
import numpy  # noqa: F401
import sphn  # noqa: F401
try:
    import qwen_tts  # noqa: F401
except Exception as exc:
    raise SystemExit(f"qwen_tts import failed before parallel launch: {exc}")
try:
    import torchaudio  # noqa: F401
except Exception as exc:
    raise SystemExit(f"torchaudio import failed (needed for MMS_FA): {exc}")
print("uv/qwen_tts/torchaudio preflight ok")
PY
fi

# Resolve clone_voice_examples.py output folders once in the parent process.
# This keeps Japanese transcripts out of qsub's comma-separated -v syntax.
if [[ "$TTS_BACKEND" == "qwen3" \
      && ( "$QWEN_VOICE_MODE" == "clone" || "$QWEN_VOICE_MODE" == "mixed" ) ]]; then
    resolve_clone_ref() {  # resolve_clone_ref <field> <role>
        local field="$1" role="$2" clone_out
        if [[ "$role" == "moshi" ]]; then
            clone_out="${CLONE_OUT_DIR_MOSHI:-}"
        else
            clone_out="${CLONE_OUT_DIR_USER:-}"
        fi
        if [[ -z "$clone_out" ]]; then
            echo "ERROR: CLONE_OUT_DIR_${role^^} is required when an explicit ${role^^}_REF_* is absent" >&2
            return 1
        fi
        uv run python scripts/resolve_clone_refs.py \
            --clone-out-dir "$clone_out" \
            --rank "$REF_RANK" \
            --mode "$CLONE_MODE" \
            --field "$field"
    }

    MOSHI_REF_WAV="${MOSHI_REF_WAV:-$(resolve_clone_ref wav moshi)}"
    if [[ "$CLONE_MODE" == "in-context" ]]; then
        MOSHI_REF_TEXT="${MOSHI_REF_TEXT:-$(resolve_clone_ref text moshi)}"
    fi
    if [[ "$QWEN_VOICE_MODE" == "clone" ]]; then
        USER_REF_WAV="${USER_REF_WAV:-$(resolve_clone_ref wav user)}"
        if [[ "$CLONE_MODE" == "in-context" ]]; then
            USER_REF_TEXT="${USER_REF_TEXT:-$(resolve_clone_ref text user)}"
        fi
    fi
    echo "clone mode:     $CLONE_MODE (rank=$REF_RANK)"
    echo "moshi ref:      $MOSHI_REF_WAV"
    if [[ "$QWEN_VOICE_MODE" == "clone" ]]; then
        echo "user ref:       $USER_REF_WAV"
    else
        echo "user voices:    $USER_SPEAKER_POOL (CustomVoice)"
    fi
fi

# Lock every output-affecting generation setting to OUT_ROOT.  Request-level
# mixed caches already have their own fingerprints, but completed WAVs are
# skipped by --resume; without this run-level lock, changing a reference or
# voice pool would silently mix old and new voices in one training set.
export MOSHI_REF_WAV="${MOSHI_REF_WAV:-}"
export MOSHI_REF_TEXT="${MOSHI_REF_TEXT:-}"
export USER_REF_WAV="${USER_REF_WAV:-}"
export USER_REF_TEXT="${USER_REF_TEXT:-}"
GENERATION_CONFIG_LOCK="$OUT_ROOT/generation_config.json"
export GENERATION_CONFIG_LOCK
uv run python - "$GENERATION_CONFIG_LOCK" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
import sys
from pathlib import Path


LOCK_VERSION = 1
lock_path = Path(sys.argv[1])
out_root = lock_path.parent


def sha256_file(raw_path: str) -> str:
    path = Path(raw_path)
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def resolved_file(raw_path: str) -> str:
    return str(Path(raw_path).resolve()) if raw_path else ""


env = os.environ
dialogues = env["DIALOGUES_JSONL"]
stage_config = env["VLLM_STAGE_CONFIG"]
generator = "scripts/generate_qwen3_tts_data.py"
qwen_backend = "scripts/qwen3_tts_vllm_backend.py"
config: dict[str, object] = {
    "source_batch_id": env["SOURCE_BATCH_ID"],
    "dialogues_path": resolved_file(dialogues),
    "dialogues_sha256": sha256_file(dialogues),
    "selected_num_dialogues": env["NUM_DIALOGUES"],
    "num_shards": env["NUM_SHARDS"],
    "spare_ratio": env["SPARE_RATIO"],
    "tts_backend": env["TTS_BACKEND"],
    "qwen_engine": env["QWEN_ENGINE"],
    "qwen_voice_mode": env["QWEN_VOICE_MODE"],
    "qwen_model": env["QWEN_TTS_MODEL"],
    "qwen_clone_model": env["QWEN_CLONE_MODEL"],
    "dtype": env["TTS_DTYPE"],
    "device": env["TTS_DEVICE"],
    "language": env["TTS_LANGUAGE"],
    "speaker_user": env["SPEAKER_USER"],
    "speaker_moshi": env["SPEAKER_MOSHI"],
    "speaker_other": env["SPEAKER_OTHER"],
    "speaker_background": env["SPEAKER_BACKGROUND"],
    "user_speaker_pool": env["USER_SPEAKER_POOL"],
    "instruct_user": env["INSTRUCT_USER"],
    "instruct_moshi": env["INSTRUCT_MOSHI"],
    "style_preset": env["STYLE_PRESET"],
    "no_emotion": True,
    "auto_overlap_aizuchi": True,
    "whole_utterance": True,
    "lead_in_sec": env["LEAD_IN_SEC"],
    "gap_sec": env["GAP_SEC"],
    "whole_utterance_max_chars": env["WHOLE_UTTERANCE_MAX_CHARS"],
    "tts_batch_size": env["TTS_BATCH_SIZE"],
    "dialogue_batch_size": env["DIALOGUE_BATCH_SIZE"],
    "vllm_max_new_tokens": env["VLLM_MAX_NEW_TOKENS"],
    "qwen_clone_max_new_tokens": env["QWEN_CLONE_MAX_NEW_TOKENS"],
    "vllm_stage_config": resolved_file(stage_config),
    "vllm_stage_config_sha256": sha256_file(stage_config),
    "generator_sha256": sha256_file(generator),
    "kokoro_voice_moshi": env["KOKORO_VOICE_MOSHI"],
    "kokoro_user_voices": env["KOKORO_USER_VOICES"],
}

if env["TTS_BACKEND"] == "qwen3":
    config.update({
        "qwen3_tts_vllm_backend_path": resolved_file(qwen_backend),
        "qwen3_tts_vllm_backend_sha256": sha256_file(qwen_backend),
    })

if (
    env["TTS_BACKEND"] == "qwen3"
    and env["QWEN_VOICE_MODE"] in {"clone", "mixed"}
):
    moshi_ref = env["MOSHI_REF_WAV"]
    config.update({
        "clone_mode": env["CLONE_MODE"],
        "clone_ref_rank": env["REF_RANK"],
        "moshi_ref_wav": resolved_file(moshi_ref),
        "moshi_ref_wav_sha256": sha256_file(moshi_ref),
        "moshi_ref_text": env["MOSHI_REF_TEXT"],
    })
if env["TTS_BACKEND"] == "qwen3" and env["QWEN_VOICE_MODE"] == "clone":
    user_ref = env["USER_REF_WAV"]
    config.update({
        "user_ref_wav": resolved_file(user_ref),
        "user_ref_wav_sha256": sha256_file(user_ref),
        "user_ref_text": env["USER_REF_TEXT"],
    })

canonical = json.dumps(
    {"lock_version": LOCK_VERSION, "config": config},
    ensure_ascii=False,
    sort_keys=True,
    separators=(",", ":"),
)
fingerprint = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
payload = {
    "lock_version": LOCK_VERSION,
    "fingerprint": fingerprint,
    "config": config,
}

if lock_path.is_file():
    try:
        previous = json.loads(lock_path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise SystemExit(
            f"ERROR: unreadable generation config lock: {lock_path}: {exc}\n"
            "Use FRESH=1 or choose a new BATCH_ID; do not resume this output blindly."
        )
    old_config = previous.get("config")
    if old_config != config:
        old_config = old_config if isinstance(old_config, dict) else {}
        changed = sorted(
            key for key in set(old_config) | set(config)
            if old_config.get(key) != config.get(key)
        )
        preview = ", ".join(changed[:20]) or "(unknown)"
        raise SystemExit(
            "ERROR: generation settings differ from the existing run at "
            f"{out_root}\nChanged keys: {preview}\n"
            "Keep every setting/reference identical when resuming, or use "
            "FRESH=1 / a new BATCH_ID."
        )
    print(f"generation config lock matched: {fingerprint[:16]} ({lock_path})")
    raise SystemExit(0)

legacy_material = (
    any(out_root.glob("shard_*/training_set/synthetic_moshi_train.jsonl"))
    or any(out_root.glob("shard_*/training_set/data_stereo/*.wav"))
    or any(out_root.glob(
        "shard_*/training_set/.qwen_mixed_cache/*/config.json"
    ))
)
if legacy_material:
    print(
        "WARNING: existing legacy output has no generation config lock; "
        "adopting the current settings. Verify them before continuing.",
        file=sys.stderr,
    )

lock_path.parent.mkdir(parents=True, exist_ok=True)
tmp = lock_path.with_name(f".{lock_path.name}.{os.getpid()}.tmp")
tmp.write_text(
    json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)
os.replace(tmp, lock_path)
print(f"generation config lock created: {fingerprint[:16]} ({lock_path})")
PY

echo "===== step 1/3: split dialogues ====="
uv run python - "$DIALOGUES_JSONL" "$OUT_ROOT" "$NUM_SHARDS" "$NUM_DIALOGUES" "$SPARE_RATIO" <<'PY'
import json
import math
import sys
from pathlib import Path

src = Path(sys.argv[1])
out_root = Path(sys.argv[2])
num_shards = int(sys.argv[3])
limit_arg = sys.argv[4]
limit = None if limit_arg == "all" else int(limit_arg)
spare_ratio = float(sys.argv[5])

rows = [line for line in src.read_text(encoding="utf-8").splitlines() if line.strip()]
if limit is not None:
    rows = rows[:limit]
if not rows:
    raise SystemExit("No dialogue rows selected")

n = len(rows)
counts = [0 for _ in range(num_shards)]
spare_counts = [0 for _ in range(num_shards)]
for i in range(num_shards):
    shard_dir = out_root / "shard_{:03d}".format(i)
    shard_dir.mkdir(parents=True, exist_ok=True)

    primary = [row for j, row in enumerate(rows) if j % num_shards == i]
    primary_count = len(primary)

    # Spare dialogues: extra rows appended after the primary quota so a
    # shard can absorb per-dialogue failures (e.g. CTC alignment giving up
    # on a too-long concatenated utterance) without falling short of its
    # primary_count target. Drawn cyclically from the full row pool with a
    # per-shard stagger so shards don't all reach for the same spares first.
    spare_n = math.ceil(primary_count * spare_ratio) if primary_count > 0 else 0
    spares = []
    start = (i * 37) % n
    k = 0
    while len(spares) < spare_n:
        spares.append(rows[(start + k) % n])
        k += 1

    shard_path = shard_dir / "dialogues.jsonl"
    selected = primary + spares
    shard_path.write_text("\n".join(selected) + ("\n" if selected else ""), encoding="utf-8")
    (shard_dir / "success_target.txt").write_text(f"{primary_count}\n", encoding="utf-8")

    counts[i] = primary_count
    spare_counts[i] = len(spares)

summary = {
    "source": str(src),
    "selected_dialogues": n,
    "num_shards": num_shards,
    "spare_ratio": spare_ratio,
    "counts": counts,
    "spare_counts": spare_counts,
}
(out_root / "split_summary.json").write_text(
    json.dumps(summary, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)
print(json.dumps(summary, ensure_ascii=False))
PY

echo "===== step 2/3: render shards in parallel ====="
pids=()
for ((i = 0; i < NUM_SHARDS; i++)); do
    shard_tag="$(printf 'shard_%03d' "$i")"
    shard_dir="$OUT_ROOT/$shard_tag"
    shard_dialogues="$shard_dir/dialogues.jsonl"
    shard_training="$shard_dir/training_set"
    shard_log="$OUT_ROOT/logs/${shard_tag}.log"
    gpu_id="${GPU_IDS[$i]}"

    if [[ ! -s "$shard_dialogues" ]]; then
        echo "ERROR: split shard is empty: $shard_dialogues" >&2
        exit 1
    fi
    success_target="$(cat "$shard_dir/success_target.txt")"

    # Resume fast-path: a shard that already reached its success_target is left
    # untouched (no model reload), so re-submitting the job only spends GPU
    # time on shards that still have work left.
    shard_manifest="$shard_training/synthetic_moshi_train.jsonl"
    if [[ "$RESUME" == "1" && -s "$shard_manifest" ]]; then
        have="$(grep -c . "$shard_manifest" 2>/dev/null || echo 0)"
        if [[ "$have" -ge "$success_target" ]]; then
            echo "skipped $shard_tag: already complete ($have/$success_target rows)"
            continue
        fi
        echo "resuming $shard_tag: $have/$success_target rows rendered so far"
    fi

    (
        set -euo pipefail
        echo "[$shard_tag] gpu=$gpu_id dialogues=$shard_dialogues out=$shard_training success_target=$success_target resume=$RESUME"
        tts_args=(
            "${GEN_CMD[@]}" scripts/generate_qwen3_tts_data.py
            --tts-backend "$TTS_BACKEND"
            --qwen-engine "$QWEN_ENGINE"
            --dialogues-jsonl "$shard_dialogues"
            --auto-overlap-aizuchi
            --whole-utterance
            --success-target "$success_target"
            --out-dir "$shard_training"
            --device "$TTS_DEVICE"
            --dtype "$TTS_DTYPE"
            --language "$TTS_LANGUAGE"
            --tts-batch-size "$TTS_BATCH_SIZE"
            --dialogue-batch-size "$DIALOGUE_BATCH_SIZE"
            --vllm-stage-config "$VLLM_STAGE_CONFIG"
            --vllm-max-new-tokens "$VLLM_MAX_NEW_TOKENS"
            --qwen-clone-max-new-tokens "$QWEN_CLONE_MAX_NEW_TOKENS"
            --whole-utterance-max-chars "$WHOLE_UTTERANCE_MAX_CHARS"
            --lead-in-sec "$LEAD_IN_SEC"
            --gap-sec "$GAP_SEC"
            --no-emotion
            --style-preset "$STYLE_PRESET"
            --log-every "$LOG_EVERY"
        )
        if [[ "$TTS_BACKEND" == "qwen3" ]]; then
            tts_args+=(
                --qwen-voice-mode "$QWEN_VOICE_MODE"
                --model "$QWEN_TTS_MODEL"
                --qwen-clone-model "$QWEN_CLONE_MODEL"
                --speaker-user "$SPEAKER_USER"
                --speaker-moshi "$SPEAKER_MOSHI"
                --speaker-other "$SPEAKER_OTHER"
                --speaker-background "$SPEAKER_BACKGROUND"
            )
            if [[ -n "$INSTRUCT_USER" ]]; then
                tts_args+=(--instruct-user "$INSTRUCT_USER")
            fi
            if [[ -n "$INSTRUCT_MOSHI" ]]; then
                tts_args+=(--instruct-moshi "$INSTRUCT_MOSHI")
            fi
            if [[ "$QWEN_VOICE_MODE" == "clone" || "$QWEN_VOICE_MODE" == "mixed" ]]; then
                tts_args+=(--qwen-clone-ref-audio-moshi "$MOSHI_REF_WAV")
                if [[ "$CLONE_MODE" == "in-context" ]]; then
                    tts_args+=(--qwen-clone-ref-text-moshi "$MOSHI_REF_TEXT")
                else
                    tts_args+=(--qwen-clone-x-vector-only)
                fi
            fi
            if [[ "$QWEN_VOICE_MODE" == "clone" ]]; then
                tts_args+=(
                    --user-speaker-pool ''
                    --qwen-clone-ref-audio-user "$USER_REF_WAV"
                )
                if [[ "$CLONE_MODE" == "in-context" ]]; then
                    tts_args+=(--qwen-clone-ref-text-user "$USER_REF_TEXT")
                fi
            else
                tts_args+=(--user-speaker-pool "$USER_SPEAKER_POOL")
            fi
        fi
        if [[ "$TTS_BACKEND" == "kokoro" ]]; then
            tts_args+=(
                --kokoro-voice-moshi "$KOKORO_VOICE_MOSHI"
                --kokoro-user-voices "$KOKORO_USER_VOICES"
            )
        fi
        if [[ "$RESUME" == "1" ]]; then
            tts_args+=(--resume)
        fi
        if [[ "$VERBOSE" == "1" ]]; then
            tts_args+=(--verbose)
        fi
        CUDA_VISIBLE_DEVICES="$gpu_id" "${tts_args[@]}"
        test -s "$shard_training/synthetic_moshi_train.jsonl"
        echo "[$shard_tag] done"
    ) > "$shard_log" 2>&1 &
    pid="$!"
    pids+=("$pid")
    echo "started $shard_tag on gpu $gpu_id (pid=$pid, log=$shard_log)"
done

failed=0
for pid in "${pids[@]}"; do
    if ! wait "$pid"; then
        failed=1
    fi
done
if [[ "$failed" != "0" ]]; then
    echo "ERROR: at least one TTS shard failed. Logs: $OUT_ROOT/logs/shard_*.log" >&2
    exit 1
fi

echo "===== step 3/3: merge shard manifests ====="
uv run python scripts/merge_training_shards.py \
    --batch-dir "$OUT_ROOT" \
    --out-dir "$OUT_ROOT/merged" \
    --expected-shards "$NUM_SHARDS"

MERGED_MANIFEST="$OUT_ROOT/merged/training_set/synthetic_moshi_train.jsonl"
test -s "$MERGED_MANIFEST"
MERGED_ROWS="$(grep -c . "$MERGED_MANIFEST" || true)"
echo "merged_manifest: $MERGED_MANIFEST"
echo "merged_rows:     $MERGED_ROWS"
uv run python - "$MERGED_MANIFEST" "$JOB_STARTED_EPOCH" <<'PY'
import json
import sys
import time
from pathlib import Path

manifest = Path(sys.argv[1])
started = float(sys.argv[2])
rows = [json.loads(line) for line in manifest.read_text(encoding="utf-8").splitlines() if line.strip()]
dialogues = len(rows)
audio_sec = sum(float(row.get("duration") or 0.0) for row in rows)
wall_sec = max(time.time() - started, 1e-9)
dialogues_per_sec = dialogues / wall_sec
audio_x = audio_sec / wall_sec
rtf = wall_sec / audio_sec if audio_sec > 0 else 0.0
print(
    "performance: "
    f"dialogues={dialogues} audio_sec={audio_sec:.2f} wall_sec={wall_sec:.2f} "
    f"dialogues_per_sec={dialogues_per_sec:.4f} "
    f"aggregate_audio_x={audio_x:.3f} aggregate_rtf={rtf:.3f}"
)
PY
echo "finished_at:     $(date -Iseconds)"
