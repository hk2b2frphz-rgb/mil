#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N job_s03
#PBS -l select=1:host=xvn_s:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
export RUN_ID="${RUN_ID:-s03_${JOB_ID_SHORT}}"
export SWEEP_PATTERNS="${SWEEP_PATTERNS:-h05 h06}"
export NUM_CASES="${NUM_CASES:-250}"
export MLFLOW_EXPERIMENT_NAME="${MLFLOW_EXPERIMENT_NAME:-job_sweep}"
export MLFLOW_TRACKING_URI="${MLFLOW_TRACKING_URI:-file:$PWD/mlruns}"

mkdir -p experiments/pbs_logs
exec > >(tee -a "experiments/pbs_logs/${RUN_ID}.log") 2>&1

bash scripts/run_sweep_pair.sh
