#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N kaburi_tts
#PBS -q xan_s
#PBS -l select=1:res=middle
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# KABURI-TTS production body. Renders a dialogues.jsonl corpus into the same
# Moshi fine-tune layout the Qwen3/Kokoro path produces, so everything from
# merge_training_shards.py onwards is unchanged.
#
# Unlike the Qwen3/Kokoro path this does NOT synthesize per utterance and lay
# the pieces out: KABURI renders both speakers at once on separate channels and
# its gap model decides the overlaps and pauses. There is no LEAD_IN_SEC /
# GAP_SEC / auto-overlap-aizuchi here, and no MMS_FA forced alignment -- the
# utterance boundaries come straight from the phoneme raster that was fed in.
#
# KABURI's canvas is a fixed 30 seconds. Listening dialogues run 2-3 minutes, so
# generate_kaburi_tts_data.py cuts each dialogue into chunks that fit and
# concatenates the rendered chunks (prosody is discontinuous at the seams).
#
# A100 queue on purpose: the codec decodes in bfloat16, which V100 (sm70) does
# not support in hardware.
#
# Submit a wrapper such as scripts/2026-09-04/aizuchi_normal_kaburi_tts_3000.pbs
# rather than this file. Re-submit to resume: finished shards are skipped and
# an unfinished shard continues per dialogue.
#
# Useful overrides:
#   KABURI_REPO=/path/to/kaburi-tts     (default: ../kaburi-tts)
#   CLONE_OUT_DIR_MOSHI=...             clone_voice_examples.py output for the
#                                       listener voice; a reference pack is
#                                       built from it and cached under
#                                       data/kaburi_ref_packs/ (REF_RANK /
#                                       CLONE_MODE select which ref, same as
#                                       the Qwen3 jobs)
#   USER_REF_WAV / CLONE_OUT_DIR_USER   user-side voice (default: KABURI's
#                                       bundled DEMO_F2 synthetic voice)
#   KABURI_REF_PACK=/path/to/refpack    use a prebuilt pack and skip all of the
#                                       above
#   KABURI_TORCH_FROM_PYPI=1            resolve torch from PyPI instead of the
#                                       pinned cu128 index, for a proxy that
#                                       cannot reach download-r2.pytorch.org.
#                                       Must match how the env was synced.
#   KABURI_NATIVE_TLS=0                 stop passing --native-tls to uv
#   KABURI_PYTHON=/path/to/python       an interpreter built outside uv
#                                       (see scripts/kaburi_uv_env.sh)
#   NUM_SHARDS=2 CUDA_VISIBLE_DEVICES=0,1
#   NUM_DIALOGUES=all
#   RASTER_MODE=pred|stat|paper         which timing model places the
#                                       utterances (paper also needs
#                                       ALLOW_MISSING_ALIGNMENTS=1)
#   CHUNK_SEC=26 CHUNK_GAP_SEC=0.3 MIN_FIT_SCALE=0.9
#   CFG_SCALE=2.5 NUM_STEPS=32 SAMPLE_RATE=24000
#   FRESH=1   # ignore existing output and start a new timestamped run
#   RESUME=0  # force a clean re-render into the same directory

set -euo pipefail

# PBS_O_WORKDIR is where qsub was run, which is this repo for a submitted job.
# An interactive PBS session sets it too -- usually to the home directory --
# and following it there breaks every relative path below. Trust it only when
# it actually holds this repo, else fall back to where this file lives.
KABURI_BODY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -n "${PBS_O_WORKDIR:-}" && -f "$PBS_O_WORKDIR/scripts/run_kaburi_tts.pbs" ]]; then
    cd "$PBS_O_WORKDIR"
else
    cd "$KABURI_BODY_DIR"
fi
if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
    # shellcheck source=/dev/null
    source "$PWD/scripts/setup_proxy.sh"
fi
# shellcheck source=/dev/null
source "$PWD/scripts/run_id_utils.sh"

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

if [[ -z "${SOURCE_BATCH_ID:-}" && -z "${DIALOGUES_JSONL:-}" ]]; then
    echo "ERROR: set SOURCE_BATCH_ID or DIALOGUES_JSONL before running this body." >&2
    exit 1
fi
export SOURCE_BATCH_ID="${SOURCE_BATCH_ID:-kaburi_source}"

export KABURI_REPO="${KABURI_REPO:-$PWD/../kaburi-tts}"
if [[ ! -d "$KABURI_REPO/kaburi_tts" ]]; then
    echo "ERROR: KABURI-TTS checkout not found: $KABURI_REPO" >&2
    echo "Run scripts/setup_kaburi_env.sh first." >&2
    exit 1
fi
# Speaker references. With a moshi clone source (the same
# data/clone_examples/<id> the Qwen3 jobs clone the listener voice from), the
# pack is built once from it and cached under data/kaburi_ref_packs/. Without
# one, fall back to KABURI's bundled two-voice pack.
export REF_RANK="${REF_RANK:-1}"
export CLONE_MODE="${CLONE_MODE:-in-context}"
BUILD_REF_PACK=0
if [[ -z "${KABURI_REF_PACK:-}" ]]; then
    if [[ -n "${CLONE_OUT_DIR_MOSHI:-}${MOSHI_REF_WAV:-}" ]]; then
        if [[ -n "${CLONE_OUT_DIR_MOSHI:-}" ]]; then
            ref_pack_tag="$(basename "$CLONE_OUT_DIR_MOSHI")_ref$(printf '%02d' "$REF_RANK")_${CLONE_MODE}"
        else
            ref_pack_tag="$(basename "${MOSHI_REF_WAV%.*}")"
        fi
        export KABURI_REF_PACK="$PWD/data/kaburi_ref_packs/$ref_pack_tag"
        BUILD_REF_PACK=1
    else
        export KABURI_REF_PACK="$KABURI_REPO/assets/test_refpack"
        echo "WARNING: no CLONE_OUT_DIR_MOSHI/MOSHI_REF_WAV; using the bundled demo voices." >&2
    fi
fi

# Timing source. pred = realizer + gap model (upstream's current release),
# stat = statistical placement from the training corpus, paper = the paper's
# single timing predictor. The acoustic model is the same in all three; only
# the decision of when each utterance starts differs. paper returns no
# per-utterance timing, so it cannot produce training alignments -- it is for
# listening and for the turn-taking numbers, and the renderer refuses it
# without ALLOW_MISSING_ALIGNMENTS=1.
export RASTER_MODE="${RASTER_MODE:-pred}"
export ALLOW_MISSING_ALIGNMENTS="${ALLOW_MISSING_ALIGNMENTS:-0}"
case "$RASTER_MODE" in
    pred|stat) ;;
    paper)
        if [[ "$ALLOW_MISSING_ALIGNMENTS" != "1" ]]; then
            echo "ERROR: RASTER_MODE=paper writes no training alignments." >&2
            echo "Set ALLOW_MISSING_ALIGNMENTS=1 if this run is for listening only." >&2
            exit 1
        fi
        ;;
    *)
        echo "ERROR: RASTER_MODE must be pred, stat, or paper: $RASTER_MODE" >&2
        exit 1
        ;;
esac

default_batch_id="${SOURCE_BATCH_ID}_kaburi_${RASTER_MODE}"
if [[ "${FRESH:-0}" == "1" ]]; then
    export BATCH_ID="${BATCH_ID:-$(default_run_id "$default_batch_id")}"
else
    export BATCH_ID="${BATCH_ID:-$default_batch_id}"
fi
if ! [[ "$BATCH_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: BATCH_ID may contain only letters, digits, dot, underscore, hyphen." >&2
    exit 1
fi
export RUN_ID="$BATCH_ID"
export DIALOGUES_JSONL="${DIALOGUES_JSONL:-$PWD/data/runs/${SOURCE_BATCH_ID}/llm_dialogues/dialogues.jsonl}"
export OUT_ROOT="${OUT_ROOT:-$PWD/data/runs/$BATCH_ID}"

export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"
IFS=',' read -r -a GPU_IDS <<< "$CUDA_VISIBLE_DEVICES"
export NUM_SHARDS="${NUM_SHARDS:-${#GPU_IDS[@]}}"
export NUM_DIALOGUES="${NUM_DIALOGUES:-all}"
export SPARE_RATIO="${SPARE_RATIO:-0.15}"
export CHUNK_SEC="${CHUNK_SEC:-26}"
export CHUNK_GAP_SEC="${CHUNK_GAP_SEC:-0.3}"
export MIN_FIT_SCALE="${MIN_FIT_SCALE:-0.9}"
export CFG_SCALE="${CFG_SCALE:-2.5}"
export NUM_STEPS="${NUM_STEPS:-32}"
export SAMPLE_RATE="${SAMPLE_RATE:-24000}"
export SEED="${SEED:-0}"
export LOG_EVERY="${LOG_EVERY:-20}"
export VERBOSE="${VERBOSE:-0}"
export RESUME="${RESUME:-auto}"

if ! [[ "$NUM_SHARDS" =~ ^[0-9]+$ ]] || [[ "$NUM_SHARDS" -lt 1 ]]; then
    echo "ERROR: NUM_SHARDS must be a positive integer: $NUM_SHARDS" >&2
    exit 1
fi
if [[ "${#GPU_IDS[@]}" -lt "$NUM_SHARDS" ]]; then
    echo "ERROR: CUDA_VISIBLE_DEVICES has ${#GPU_IDS[@]} GPU(s), but NUM_SHARDS=$NUM_SHARDS" >&2
    exit 1
fi
if [[ "$NUM_DIALOGUES" != "all" ]]; then
    if ! [[ "$NUM_DIALOGUES" =~ ^[0-9]+$ ]] || [[ "$NUM_DIALOGUES" -lt 1 ]]; then
        echo "ERROR: NUM_DIALOGUES must be a positive integer or 'all': $NUM_DIALOGUES" >&2
        exit 1
    fi
fi
if [[ ! -s "$DIALOGUES_JSONL" ]]; then
    echo "ERROR: dialogues JSONL was not found or is empty: $DIALOGUES_JSONL" >&2
    exit 1
fi

if [[ "$RESUME" == "auto" ]]; then
    if compgen -G "$OUT_ROOT/shard_*/training_set/synthetic_moshi_train.jsonl" >/dev/null 2>&1; then
        RESUME=1
    else
        RESUME=0
    fi
fi
if [[ "$RESUME" != "0" && "$RESUME" != "1" ]]; then
    echo "ERROR: RESUME must be 0, 1, or auto: $RESUME" >&2
    exit 1
fi

mkdir -p "$OUT_ROOT" "$OUT_ROOT/logs" experiments/pbs_logs
JOB_TAG="${PBS_JOBID:-local}"
JOB_TAG="${JOB_TAG%%.*}"
JOB_LOG="experiments/pbs_logs/${BATCH_ID}_${JOB_TAG:-local}.log"
JOB_STARTED_EPOCH="$(date +%s)"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== KABURI-TTS production ====="
echo "job_id:        ${PBS_JOBID:-n/a}"
echo "host:          $(hostname)"
echo "kaburi_repo:   $KABURI_REPO"
echo "ref_pack:      $KABURI_REF_PACK"
echo "source_batch:  $SOURCE_BATCH_ID"
echo "dialogues:     $DIALOGUES_JSONL"
echo "out_root:      $OUT_ROOT"
echo "resume:        $RESUME"
echo "num_dialogues: $NUM_DIALOGUES"
echo "num_shards:    $NUM_SHARDS"
echo "spare_ratio:   $SPARE_RATIO"
echo "gpus:          $CUDA_VISIBLE_DEVICES"
echo "chunking:      chunk_sec=$CHUNK_SEC gap=$CHUNK_GAP_SEC min_fit=$MIN_FIT_SCALE"
echo "timing_mode:   $RASTER_MODE"
echo "decode:        cfg_scale=$CFG_SCALE steps=$NUM_STEPS sample_rate=$SAMPLE_RATE"
echo "started_at:    $(date -Iseconds)"
echo "================================="

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

# KABURI runs in its own uv project (torch cu128, python <3.12); the main env is
# cu121 and cannot host it. scripts/kaburi_uv_env.sh decides the TLS and index
# flags -- read it before changing anything about how uv is called here.
# shellcheck source=/dev/null
source "$PWD/scripts/kaburi_uv_env.sh"
kaburi_uv_run KABURI_UV
echo "kaburi_uv:     ${KABURI_UV[*]}"

echo "===== step 0/3: environment preflight ====="
if ! "${KABURI_UV[@]}" - <<'PY'
import torch
import torchaudio  # noqa: F401
if not torch.cuda.is_available():
    raise SystemExit("CUDA is unavailable in the KABURI environment")
major, minor = torch.cuda.get_device_capability()
if (major, minor) < (8, 0):
    raise SystemExit(
        f"KABURI decodes the codec in bfloat16 and needs sm80+, found sm{major}{minor}"
    )
import kaburi_tts  # noqa: F401
from irodori_tts.codec import DACVAECodec  # noqa: F401
print("kaburi/irodori/torch preflight ok")
PY
then
    echo "ERROR: the KABURI environment is not usable." >&2
    echo "Run scripts/setup_kaburi_env.sh first. If it failed on the torch wheel," >&2
    echo "its header lists the proxy/TLS workarounds (SSL_CERT_FILE," >&2
    echo "KABURI_TORCH_FROM_PYPI=1); they have to be set here as well." >&2
    exit 1
fi

# Reading a wav is the first thing the reference-pack build does, and it goes
# through torchcodec, which fails on a CUDA mismatch only at that point. Probe
# it here rather than after downloading 5GB of weights -- and repair it in
# place, because being sent off to run the setup script again is no better than
# the failure. A no-op when the environment is healthy. Serial: this runs once,
# before any shard starts, so no two processes write the venv at the same time.
# KABURI_AUTO_REPAIR=0 makes it report instead of repairing.
if ! bash scripts/fix_kaburi_audio_io.sh; then
    echo "ERROR: torchaudio cannot read audio in the KABURI environment." >&2
    echo "To retry the probe alone: bash scripts/run_kaburi_audio_check.sh" >&2
    exit 1
fi

if [[ "$BUILD_REF_PACK" == "1" ]]; then
    echo "===== step 0b: speaker reference pack ====="
    bash scripts/make_kaburi_ref_pack.sh "$KABURI_REF_PACK"
fi
if [[ ! -s "$KABURI_REF_PACK/manifest.jsonl" ]]; then
    echo "ERROR: reference pack has no manifest.jsonl: $KABURI_REF_PACK" >&2
    exit 1
fi

echo "===== step 1/3: split dialogues ====="
uv run python - "$DIALOGUES_JSONL" "$OUT_ROOT" "$NUM_SHARDS" "$NUM_DIALOGUES" "$SPARE_RATIO" <<'PY'
import json
import math
import sys
from pathlib import Path

src = Path(sys.argv[1])
out_root = Path(sys.argv[2])
num_shards = int(sys.argv[3])
limit_arg = sys.argv[4]
limit = None if limit_arg == "all" else int(limit_arg)
spare_ratio = float(sys.argv[5])

rows = [line for line in src.read_text(encoding="utf-8").splitlines() if line.strip()]
if limit is not None:
    rows = rows[:limit]
if not rows:
    raise SystemExit("No dialogue rows selected")

n = len(rows)
counts = [0 for _ in range(num_shards)]
spare_counts = [0 for _ in range(num_shards)]
for i in range(num_shards):
    shard_dir = out_root / "shard_{:03d}".format(i)
    shard_dir.mkdir(parents=True, exist_ok=True)

    primary = [row for j, row in enumerate(rows) if j % num_shards == i]
    primary_count = len(primary)

    # Spares absorb per-dialogue failures (a chunk whose realizer drops every
    # utterance, say) so the shard still reaches its primary count.
    spare_n = math.ceil(primary_count * spare_ratio) if primary_count > 0 else 0
    spares = []
    start = (i * 37) % n
    k = 0
    while len(spares) < spare_n:
        spares.append(rows[(start + k) % n])
        k += 1

    selected = primary + spares
    (shard_dir / "dialogues.jsonl").write_text(
        "\n".join(selected) + ("\n" if selected else ""), encoding="utf-8")
    (shard_dir / "success_target.txt").write_text(f"{primary_count}\n", encoding="utf-8")

    counts[i] = primary_count
    spare_counts[i] = len(spares)

summary = {
    "source": str(src),
    "selected_dialogues": n,
    "num_shards": num_shards,
    "spare_ratio": spare_ratio,
    "counts": counts,
    "spare_counts": spare_counts,
}
(out_root / "split_summary.json").write_text(
    json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
print(json.dumps(summary, ensure_ascii=False))
PY

echo "===== step 2/3: render shards in parallel ====="
pids=()
for ((i = 0; i < NUM_SHARDS; i++)); do
    shard_tag="$(printf 'shard_%03d' "$i")"
    shard_dir="$OUT_ROOT/$shard_tag"
    shard_dialogues="$shard_dir/dialogues.jsonl"
    shard_training="$shard_dir/training_set"
    shard_log="$OUT_ROOT/logs/${shard_tag}.log"
    gpu_id="${GPU_IDS[$i]}"

    if [[ ! -s "$shard_dialogues" ]]; then
        echo "ERROR: split shard is empty: $shard_dialogues" >&2
        exit 1
    fi
    success_target="$(cat "$shard_dir/success_target.txt")"

    shard_manifest="$shard_training/synthetic_moshi_train.jsonl"
    if [[ "$RESUME" == "1" && -s "$shard_manifest" ]]; then
        have="$(grep -c . "$shard_manifest" 2>/dev/null || echo 0)"
        if [[ "$have" -ge "$success_target" ]]; then
            echo "skipped $shard_tag: already complete ($have/$success_target rows)"
            continue
        fi
        echo "resuming $shard_tag: $have/$success_target rows rendered so far"
    fi

    (
        set -euo pipefail
        echo "[$shard_tag] gpu=$gpu_id dialogues=$shard_dialogues out=$shard_training target=$success_target resume=$RESUME"
        render_args=(
            "${KABURI_UV[@]}" scripts/generate_kaburi_tts_data.py
            --dialogues-jsonl "$shard_dialogues"
            --out-dir "$shard_training"
            --kaburi-repo "$KABURI_REPO"
            --ref-pack "$KABURI_REF_PACK"
            --mode "$RASTER_MODE"
            --device cuda
            --success-target "$success_target"
            --chunk-sec "$CHUNK_SEC"
            --chunk-gap-sec "$CHUNK_GAP_SEC"
            --min-fit-scale "$MIN_FIT_SCALE"
            --cfg-scale "$CFG_SCALE"
            --num-steps "$NUM_STEPS"
            --sample-rate "$SAMPLE_RATE"
            --seed "$SEED"
            --log-every "$LOG_EVERY"
        )
        if [[ "$RASTER_MODE" == "paper" ]]; then
            render_args+=(--allow-missing-alignments)
        fi
        if [[ "$RESUME" == "1" ]]; then
            render_args+=(--resume)
        fi
        if [[ "$VERBOSE" == "1" ]]; then
            render_args+=(--verbose)
        fi
        CUDA_VISIBLE_DEVICES="$gpu_id" "${render_args[@]}"
        test -s "$shard_training/synthetic_moshi_train.jsonl"
        echo "[$shard_tag] done"
    ) > "$shard_log" 2>&1 &
    pid="$!"
    pids+=("$pid")
    echo "started $shard_tag on gpu $gpu_id (pid=$pid, log=$shard_log)"
done

failed=0
for pid in "${pids[@]:-}"; do
    [[ -z "$pid" ]] && continue
    if ! wait "$pid"; then
        failed=1
    fi
done
if [[ "$failed" != "0" ]]; then
    echo "ERROR: at least one KABURI shard failed. Logs: $OUT_ROOT/logs/shard_*.log" >&2
    exit 1
fi

echo "===== step 3/3: merge shard manifests ====="
uv run python scripts/merge_training_shards.py \
    --batch-dir "$OUT_ROOT" \
    --out-dir "$OUT_ROOT/merged" \
    --expected-shards "$NUM_SHARDS"

MERGED_MANIFEST="$OUT_ROOT/merged/training_set/synthetic_moshi_train.jsonl"
test -s "$MERGED_MANIFEST"
MERGED_ROWS="$(grep -c . "$MERGED_MANIFEST" || true)"
echo "merged_manifest: $MERGED_MANIFEST"
echo "merged_rows:     $MERGED_ROWS"
uv run python - "$MERGED_MANIFEST" "$JOB_STARTED_EPOCH" <<'PY'
import json
import sys
import time
from pathlib import Path

manifest = Path(sys.argv[1])
started = float(sys.argv[2])
rows = [json.loads(line) for line in manifest.read_text(encoding="utf-8").splitlines() if line.strip()]
dialogues = len(rows)
audio_sec = sum(float(row.get("duration") or 0.0) for row in rows)
wall_sec = max(time.time() - started, 1e-9)
rtf = wall_sec / audio_sec if audio_sec > 0 else 0.0
print(
    "performance: "
    f"dialogues={dialogues} audio_sec={audio_sec:.2f} wall_sec={wall_sec:.2f} "
    f"aggregate_audio_x={audio_sec / wall_sec:.3f} aggregate_rtf={rtf:.3f}"
)
PY

# Smoke runs ask for the per-dialogue cost and the turn-taking numbers. Skipped
# by default: the report reads every rendered WAV, which is fine for a handful
# of dialogues and pointless for a few thousand.
if [[ -n "${SMOKE_REPORT_LABEL:-}" ]]; then
    echo "===== smoke report ====="
    report_args=(
        uv run python scripts/report_tts_smoke.py
        --projection "${REPORT_PROJECTION:-3000}"
        --json-out "$OUT_ROOT/smoke_report.json"
    )
    for ((i = 0; i < NUM_SHARDS; i++)); do
        shard_tag="$(printf 'shard_%03d' "$i")"
        label="$SMOKE_REPORT_LABEL"
        if [[ "$NUM_SHARDS" -gt 1 ]]; then
            label="${SMOKE_REPORT_LABEL}_${shard_tag}"
        fi
        report_args+=(--training-dir "$OUT_ROOT/$shard_tag/training_set" --label "$label")
    done
    "${report_args[@]}"
fi

echo "finished_at:     $(date -Iseconds)"
