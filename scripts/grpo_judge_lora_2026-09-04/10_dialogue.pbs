#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N grpo_dlg
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# OPTIONAL stage 1. Not on the default path.
#
# 30_grpo_train.pbs is the entry point of this experiment and reuses an already
# rendered response corpus, because GRPO consumes at most ~200 segments per axis
# over a whole run and any existing multi-agent corpus already saturates that.
# Run this stage, then 20_tts.pbs, ONLY if no rendered response corpus exists;
# then point CORPUS_ROOT in 30_grpo_train.pbs at the output.
#
# Generates the dialogue corpus GRPO will be aligned on. Every setting below is
# hardcoded on purpose: this file IS the experiment record, and a value that can
# be overridden from the submit shell is a value nobody can reconstruct later.
# To run a different size or version, copy this folder and edit the constants.
#
# MODE: multi-agent, NOT aizuchi-only.
#   GRPO extracts four segment types (pause, turn_taking, backchannel,
#   interruption) from these recordings. An aizuchi-only corpus mechanically
#   strips every moshi utterance outside the backchannel vocabulary, so three of
#   the four axes would come out empty and only the backchannel reward would
#   ever fire. Setting the mode explicitly also stops a stale
#   DIALOGUE_GENERATION_MODE inherited through "qsub -V" from silently turning
#   this stage back into a backchannel-only corpus.
#
# LENGTH: 5-8 pairs, longer than the SFT corpora use.
#   The 170s chunk budget that pins the SFT corpora to 3-5 pairs is a
#   moshi-finetune constraint: it splits any dialogue over duration_sec and the
#   later chunks start mid-conversation with no opening greeting. GRPO has no
#   such limit -- segment_extractor.py works per utterance over the whole
#   recording, so a longer dialogue simply yields more segments per rendered
#   second. More moshi turns is also what makes this a response corpus rather
#   than a listening one.
#   The cost is TTS time, which scales with total audio, not dialogue count.
#
# Submit:
#   qsub -V scripts/grpo_judge_lora_2026-09-04/10_dialogue.pbs
#
# This stage chains to 20_tts.pbs on success.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

export NUM_CASES="10000"
export BATCH_ID="qwen_grpo_response_10000_v1"
export OUT_ROOT="$PWD/data/runs/grpo_response_10000_v1/dialogue"

export DIALOGUE_GENERATION_MODE="multi-agent"
export MULTI_AGENT_MIN_PAIRS="5"
export MULTI_AGENT_MAX_PAIRS="8"

# Backchannels are kept, but they are not what this corpus is for. They are the
# ground truth for the GRPO backchannel axis (gt_backchannel_times comes from
# the moshi channel of these recordings), so switching them off would leave that
# axis with no data at all. Two per user turn is the runner default and is the
# floor, not a target -- the pair count above is what makes moshi talk.
export MULTI_AGENT_AIZUCHI_MODE="separate"
export MULTI_AGENT_MAX_AIZUCHI_PER_USER="2"

bash scripts/run_dialogues_qwen_10000.pbs

DIALOGUES="$OUT_ROOT/llm_dialogues/dialogues.jsonl"
test -s "$DIALOGUES"
echo "stage 1 done: $DIALOGUES"

NEXT="scripts/grpo_judge_lora_2026-09-04/20_tts.pbs"
if command -v qsub >/dev/null 2>&1; then
    echo "chaining -> $NEXT"
    qsub -V "$NEXT"
else
    echo "WARNING: qsub not on PATH; submit $NEXT manually." >&2
fi
