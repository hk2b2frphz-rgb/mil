#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N grpo_tts
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# OPTIONAL stage 2. Not on the default path; see the header of 10_dialogue.pbs.
#
# Renders the dialogues to stereo WAVs with Qwen3-TTS. Every setting is
# hardcoded; see the note at the top of 10_dialogue.pbs.
#
# VOICE: CLONE_OUT_DIR_MOSHI points at the same clone source the aizuchi and
#   response corpora used (data/clone_examples/99999). Keeping one moshi voice
#   across every corpus matters here for the same reason it matters for SFT: a
#   second voice gives the acoustic codebooks a bimodal target for one speaker.
#   QWEN_VOICE_MODE is deliberately left unset -- it defaults to "auto", which
#   resolves to "mixed" when a moshi clone source is present and no user clone
#   source is (resolve_qwen_voice_mode in scripts/run_qwen_tts_vllm_common.sh).
#
# RESUME: re-submitting this same file continues the unfinished shards.
#   Finished shards, dialogues and requests are all skipped. When the merge has
#   not happened yet, this stage re-submits itself rather than chaining on.
#
# Submit:
#   qsub -V scripts/grpo_judge_lora_2026-09-04/20_tts.pbs
#
# This stage does NOT chain into training. 30_grpo_train.pbs hardcodes which
# corpus it trains on, so pointing it at this output is a deliberate edit, not
# something a chained job should decide.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

RUN_ROOT="$PWD/data/runs/grpo_response_10000_v1"

export CLONE_OUT_DIR_MOSHI="$PWD/data/clone_examples/99999"

export SOURCE_BATCH_ID="qwen_grpo_response_10000_v1"
export BATCH_ID="grpo_response_10000_v1_tts_vllm"
export DIALOGUES_JSONL="$RUN_ROOT/dialogue/llm_dialogues/dialogues.jsonl"
export OUT_ROOT="$RUN_ROOT/tts"
export NUM_DIALOGUES="10000"

test -s "$DIALOGUES_JSONL" || {
    echo "ERROR: dialogues not found: $DIALOGUES_JSONL" >&2
    echo "       Run scripts/grpo_judge_lora_2026-09-04/10_dialogue.pbs first." >&2
    exit 1
}

bash scripts/run_qwen_tts_vllm_10000_4gpu.pbs

MERGED="$OUT_ROOT/merged/training_set/synthetic_moshi_train.jsonl"

if [[ ! -s "$MERGED" ]]; then
    # The TTS driver merges shards only once every shard has finished. This is
    # not an error, it is what an interrupted run looks like.
    echo "merged manifest not present yet: $MERGED"
    if command -v qsub >/dev/null 2>&1; then
        echo "re-submitting this stage to continue the remaining shards"
        qsub -V scripts/grpo_judge_lora_2026-09-04/20_tts.pbs
    fi
    exit 0
fi

echo "stage 2 done: $MERGED"
echo
echo "To train on this corpus, set CORPUS_ROOT in"
echo "  scripts/grpo_judge_lora_2026-09-04/30_grpo_train.pbs"
echo "to $RUN_ROOT, then submit that file."
