#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N grpo_train
#PBS -q xan_s
#PBS -l select=1:res=middle
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII text anywhere in this file.
#
# STAGE 3 of the GRPO pipeline: 10_dialogue -> 20_tts -> 30_grpo_train.
#
# Extracts GRPO segments from the rendered corpus, then hands off to
# scripts/2026-09-04/grpo_judge_lora.pbs, which runs:
#
#   judge   Qwen3.6-27B on GPU 1 (vLLM, OpenAI-compatible server)
#   train   GRPO on LoRA adapters on GPU 0
#   merge   fold the final adapter back into MOSHI_WEIGHT
#   eval    Full-Duplex-Bench-JA on the merged model
#
# Needs 2 GPUs. res=middle is the class the LoRA jobs use; if it hands back one
# GPU the runner stops with an explicit error rather than OOMing the judge.
#
# Every setting is hardcoded; see the note at the top of 10_dialogue.pbs.
#
# MOSHI_WEIGHT must be the MERGED SFT model. GRPO's reference policy is that
# model with the adapters switched off, so pointing this at the untuned base
# would have the KL term pulling the listener back toward a model that was
# never fine-tuned. Produce it with:
#
#   qsub -v LORA_CKPT=<sft>/consolidated/lora.safetensors,\
#           OUT_WEIGHT=$PWD/merged_model/consolidated.safetensors \
#        scripts/merge_lora.pbs
#
# RESUME: re-submitting this same file continues the run. RUN_NAME is a fixed
#   name, and the runner picks up the newest adapter already under
#   experiments/grpo/<RUN_NAME>/checkpoints/. Adapters resume; optimizer state
#   does not, same as the SFT chain.
#
# CORPUS: an existing multi-agent (response) corpus, NOT newly generated.
#
#   GRPO touches at most segments_per_epoch * epochs = 8 * 100 = 800 segments
#   over the whole run, round-robined across four axes, so roughly 200 per axis.
#   segment_extractor.py caps extraction at 2000 per axis, and even a 2,000
#   dialogue corpus saturates that cap. Generating 10,000 fresh dialogues and
#   rendering them would spend days of TTS on an order of magnitude more data
#   than the run can consume.
#
#   The corpus must be multi-agent. An aizuchi-only corpus strips every moshi
#   utterance outside the backchannel vocabulary, which leaves three of the four
#   axes empty.
#
# Submit:
#   qsub -V scripts/grpo_judge_lora_2026-09-04/30_grpo_train.pbs
#
# Output lands under experiments/grpo/grpo_response_2000_v1/.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

CORPUS_ROOT="$PWD/data/runs/grpo_response_2000_v1"
MANIFEST="$CORPUS_ROOT/tts/merged/training_set/synthetic_moshi_train.jsonl"
SEGMENT_DIR="$CORPUS_ROOT/grpo_segments"

test -s "$MANIFEST" || {
    echo "ERROR: rendered corpus not found: $MANIFEST" >&2
    echo "       Run scripts/grpo_judge_lora_2026-09-04/10_dialogue.pbs first;" >&2
    echo "       it chains through 20_tts.pbs back to this stage." >&2
    echo "       To train on a corpus that already exists instead, point" >&2
    echo "       CORPUS_ROOT at it. It must be MULTI-AGENT: on an aizuchi-only" >&2
    echo "       corpus three of the four GRPO axes come out empty." >&2
    exit 1
}

export MOSHI_WEIGHT="$PWD/merged_model/consolidated.safetensors"
test -s "$MOSHI_WEIGHT" || {
    echo "ERROR: merged SFT weights not found: $MOSHI_WEIGHT" >&2
    echo "       GRPO's reference policy comes from this file. Merge the SFT" >&2
    echo "       adapter first with scripts/merge_lora.pbs (see the header)." >&2
    exit 1
}

# Segment extraction is cheap next to training and is skipped once it has run,
# so it lives here rather than in its own stage.
if [[ -s "$SEGMENT_DIR/turn_taking_segments.jsonl" ]]; then
    echo "reusing segments: $SEGMENT_DIR"
else
    echo "extracting segments -> $SEGMENT_DIR"
    uv run python scripts/grpo/segment_extractor.py \
        --manifest "$MANIFEST" \
        --out-dir "$SEGMENT_DIR" \
        --max-per-axis 2000
fi

for AXIS in pause turn_taking backchannel interruption; do
    COUNT="$(wc -l < "$SEGMENT_DIR/${AXIS}_segments.jsonl" 2>/dev/null || echo 0)"
    echo "segments ${AXIS}: ${COUNT}"
done

export RUN_NAME="grpo_response_2000_v1"
export GRPO_SEGMENT_DIR="$SEGMENT_DIR"
export GRPO_CONFIG="configs/grpo_judge_lora.yaml"
export JUDGE_MODEL="Qwen/Qwen3.6-27B"
export JUDGE_PORT="8000"
export JUDGE_GPU_UTIL="0.90"
export JUDGE_MAX_LEN="8192"
export RUN_MERGE="1"
export RUN_EVAL="1"
export RESUME="1"

exec bash scripts/2026-09-04/grpo_judge_lora.pbs
