#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N real_dialogue_sep
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -V

# ASCII ONLY. Do not add non-ASCII characters anywhere in this file
# (not even in comments) -- the job dies immediately at submission.
#
# Stage 2 for a real-dialogue 1ch WAV: source separation + re-transcription of
# the separated tracks (scripts/separate_real_dialogue.py).
#
# Requires stage 1 (scripts/run_real_dialogue_analysis.pbs) to have been run
# with the same OUT_DIR. timeline.jsonl is used to assign separated channels
# to speakers.
#
# Required:
#   qsub -v 'WAVS=/path/dialogue1.wav,OUT_DIR=data/real_dialogue/pilot' \
#     scripts/run_real_dialogue_separation.pbs
#
# Optional:
#   SEP_MODEL=speechbrain/sepformer-whamr16k
#   WHISPER_MODEL=large-v3
#   EXTRA_ARGS="--skip-asr"        (listen to the separation first, no ASR)
#   SEP_UV_WITH="--with torch==2.5.1"
#
# Like stage 1, separation runs in its own uv env: SpeechBrain can conflict
# with the transformers/numpy pinned in the main env.

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

WAVS="${WAVS:?Set WAVS to one or more input wav paths (comma separated, glob ok)}"
OUT_DIR="${OUT_DIR:?Set OUT_DIR to the same directory used by the stage-1 analysis}"

if [[ ! -d "$OUT_DIR" ]]; then
    echo "ERROR: OUT_DIR does not exist: $OUT_DIR" >&2
    echo "       Run scripts/run_real_dialogue_analysis.pbs first." >&2
    exit 1
fi

IFS=',' read -r -a wav_patterns <<< "$WAVS"
wav_files=()
for pat in "${wav_patterns[@]}"; do
    for f in $pat; do
        wav_files+=("$f")
    done
done
if [[ ${#wav_files[@]} -eq 0 ]]; then
    echo "ERROR: no wav files matched: $WAVS" >&2
    exit 1
fi

LOG_FILE="${LOG_FILE:-$OUT_DIR/separation.log}"
{
    echo "===== real dialogue separation (stage 2) ====="
    echo "job:     ${PBS_JOBID:-manual}"
    echo "started: $(date -Is)"
    echo "inputs:  ${wav_files[*]}"
    echo "out_dir: $OUT_DIR"
    echo "model:   ${SEP_MODEL:-speechbrain/sepformer-whamr16k}"
} | tee "$LOG_FILE"

export PYTHONUNBUFFERED=1

# shellcheck disable=SC2086
uv run --no-project --python 3.11 \
    --index-url https://download.pytorch.org/whl/cu121 \
    --extra-index-url https://pypi.org/simple \
    --with 'torch==2.5.1' \
    --with 'torchaudio==2.5.1' \
    --with 'speechbrain>=1.0.0' \
    --with faster-whisper \
    --with librosa \
    --with soundfile \
    --with 'numpy<2' \
    ${SEP_UV_WITH:-} \
    python -u scripts/separate_real_dialogue.py \
    "${wav_files[@]}" \
    --out-dir "$OUT_DIR" \
    ${SEP_MODEL:+--sep-model "$SEP_MODEL"} \
    ${WHISPER_MODEL:+--whisper-model "$WHISPER_MODEL"} \
    ${EXTRA_ARGS:-} 2>&1 | tee -a "$LOG_FILE"

echo "done: $OUT_DIR (log: $LOG_FILE)" | tee -a "$LOG_FILE"
echo ""
echo "next steps (manual):"
echo "  1) listen to segments_separated/ and judge the separation quality"
echo "  2) decide which speaker is the counselor, touch counselor_A.txt or counselor_B.txt"
echo "  3) prune rows by setting keep=0 in <speaker>_segments_review.tsv"
echo "  4) MODEL_ID=... ANALYSIS_DIRS=... bash scripts/run_real_dialogue_eval.sh"
