#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N fdb_ja_batch
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -V

# Runs scripts/run_full_duplex_eval.sh once per model listed in MODELS_FILE,
# one after another in a single job, writing each model's results under
# BATCH_OUT_DIR/<model_id>/ plus a combined_summary.json comparing every
# model side by side (eval/combine_full_duplex_summaries.py). One model's
# failure does not stop the remaining models -- see the summary table at the
# end of the log / <BATCH_OUT_DIR>/batch.log. This job never calls
# OpenAI/Azure APIs (same rule as run_full_duplex_eval.pbs).
#
#   qsub -v MODELS_FILE=scripts/models_manifest.txt \
#     scripts/run_full_duplex_eval_batch.pbs
#
# Manifest format (one model per line, "|"-delimited, "#" starts a comment):
#   model_id|model_weight|model_config|hf_repo|extra_env
# See scripts/models_manifest.example.txt for details and an example.
#
# Useful overrides (batch-wide defaults; a manifest row's own extra_env
# column overrides these for that row only):
#   BATCH_ID=my_batch_label        Defaults to batch_<PBS job id>.
#   BATCH_OUT_DIR=...              Defaults to eval_runs/full_duplex_batches/<BATCH_ID>.
#   FDB_TASKS=pause_handling,smooth_turn_taking,user_interruption
#   FDB_SEEDS=0,1,2
#   FDB_TAIL_SEC=8
#   FDB_TTS_BACKEND=auto
#   FDB_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
#   FDB_TTS_SPEAKER=Ono_Anna
#   FDB_DEVICE=cuda
#   FDB_DTYPE=bfloat16
#   FDB_WHOLE_UTTERANCE=1 (default)
#   FDB_WHOLE_UTTERANCE_MAX_CHARS=150
#   FDB_BACKCHANNEL_GT=eval_sets/full_duplex_ja/backchannel_gt.json (default if present)
#   FDB_OPENING_GREETING=1 (default; set to 0 for base Moshi / llm-jp baselines --
#     the dataset dir name encodes this flag, so it is safe to mix rows with
#     different opening-greeting settings across the same batch by putting
#     FDB_OPENING_GREETING=0 in that row's extra_env column)
#   FDB_OPENING_GREETING_GAP_SEC=0.4
#   REFRESH_FDB_DATA=1

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

MODELS_FILE="${MODELS_FILE:?Set MODELS_FILE to a manifest listing models to evaluate, e.g. -v MODELS_FILE=scripts/models_manifest.txt}"

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
export BATCH_ID="${BATCH_ID:-batch_${JOB_ID_SHORT}}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export HALF="${HALF:-1}"
export FDB_TTS_BACKEND="${FDB_TTS_BACKEND:-auto}"
export FDB_TTS_MODEL="${FDB_TTS_MODEL:-Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice}"
export FDB_TTS_SPEAKER="${FDB_TTS_SPEAKER:-Ono_Anna}"
export FDB_DEVICE="${FDB_DEVICE:-cuda}"
export FDB_DTYPE="${FDB_DTYPE:-bfloat16}"
export FDB_WHOLE_UTTERANCE="${FDB_WHOLE_UTTERANCE:-1}"
export FDB_WHOLE_UTTERANCE_MAX_CHARS="${FDB_WHOLE_UTTERANCE_MAX_CHARS:-150}"
export FDB_OPENING_GREETING="${FDB_OPENING_GREETING:-1}"
export FDB_OPENING_GREETING_GAP_SEC="${FDB_OPENING_GREETING_GAP_SEC:-0.4}"

# Disable Triton / torch.compile -- V100 lacks support for many Triton kernels.
export TORCHINDUCTOR_DISABLE=1
export NO_TORCH_COMPILE="${NO_TORCH_COMPILE:-1}"
export TORCH_COMPILE_DISABLE=1

mkdir -p experiments/pbs_logs
exec > >(tee -a "experiments/pbs_logs/full_duplex_batch_${BATCH_ID}.log") 2>&1

echo "job_id:      ${PBS_JOBID:-n/a}"
echo "queue:       xvn_s"
echo "host:        $(hostname)"
echo "workdir:     $(pwd)"
echo "batch_id:    $BATCH_ID"
echo "models_file: $MODELS_FILE"
echo "cuda:        $CUDA_VISIBLE_DEVICES"

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

bash scripts/run_full_duplex_eval_batch.sh
