#!/usr/bin/env bash
#PBS -N vllm_smoke
#PBS -q xan_s
# TODO(cluster): verify that `select=1:res=small` guarantees one A100 GPU.
#PBS -l select=1:res=small
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -V
#PBS -S /bin/bash

# vLLM smoke test for loading a single model on one A100 80GB GPU.
# This only verifies that the model loads and returns inference; it is not a
# production generation configuration.
#
# Usage:
#   gpt-oss:       qsub -V scripts/run_vllm_smoketest.pbs
#   qwen 27B:      VLLM_MODEL=Qwen/Qwen3.6-27B     qsub -V scripts/run_vllm_smoketest.pbs
#   qwen 35B-A3B:  VLLM_MODEL=Qwen/Qwen3.6-35B-A3B qsub -V scripts/run_vllm_smoketest.pbs
# Note: all of the above are expected to fit on one A100 80GB. Qwen3.6-35B-A3B
# (MoE ~70GB in bf16) is the tightest -- keep MAX_MODEL_LEN modest. If an HF repo
# ID 404s, double-check the exact name on HuggingFace.

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
    # shellcheck source=/dev/null
    source "$PWD/scripts/setup_proxy.sh"
fi

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}
command -v curl >/dev/null 2>&1 || {
    echo "ERROR: curl is not available on PATH." >&2
    exit 1
}

export VLLM_MODEL="${VLLM_MODEL:-openai/gpt-oss-120b}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export PORT="${PORT:-8000}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-8192}"
export UV_TORCH_BACKEND="${UV_TORCH_BACKEND:-cu128}"
export VLLM_VERSION="${VLLM_VERSION:-0.23.0}"
export VLLM_CUDA_VERSION="${VLLM_CUDA_VERSION:-128}"
export VLLM_TENSOR_PARALLEL_SIZE="${VLLM_TENSOR_PARALLEL_SIZE:-1}"
export VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.90}"
export VLLM_MAX_NUM_BATCHED_TOKENS="${VLLM_MAX_NUM_BATCHED_TOKENS:-1024}"
export VLLM_QWEN_REASONING_PARSER="${VLLM_QWEN_REASONING_PARSER:-qwen3}"
export VLLM_QWEN_CHAT_TEMPLATE_KWARGS="${VLLM_QWEN_CHAT_TEMPLATE_KWARGS:-}"
export VLLM_PREPARE_GPTOSS_TIKTOKEN="${VLLM_PREPARE_GPTOSS_TIKTOKEN:-1}"
export TIKTOKEN_ENCODINGS_DIR="${TIKTOKEN_ENCODINGS_DIR:-$PWD/.cache/tiktoken_encodings}"

if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
    echo "ERROR: PORT must be an integer from 1 to 65535; got '$PORT'." >&2
    exit 1
fi

VLLM_INSTALL_SPEC="${VLLM_INSTALL_SPEC:-vllm==${VLLM_VERSION}}"
VLLM_WHEEL_URL="${VLLM_WHEEL_URL:-}"
VLLM_WITH_SPEC="${VLLM_WHEEL_URL:-$VLLM_INSTALL_SPEC}"
PYTORCH_INDEX_URL="${PYTORCH_INDEX_URL:-https://download.pytorch.org/whl/cu${VLLM_CUDA_VERSION}}"

SANITIZED_MODEL="${VLLM_MODEL//\//_}"
mkdir -p experiments/pbs_logs
JOB_LOG="experiments/pbs_logs/vllm_smoke_${SANITIZED_MODEL}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== vLLM smoke test ====="
echo "job_id:        ${PBS_JOBID:-n/a}"
echo "host:          $(hostname)"
echo "model:         $VLLM_MODEL"
echo "cuda_devices:  $CUDA_VISIBLE_DEVICES"
echo "port:          $PORT"
echo "max_model_len: $MAX_MODEL_LEN"
echo "torch_backend: $UV_TORCH_BACKEND"
echo "vllm_version:  $VLLM_VERSION"
echo "vllm_cuda:     cu$VLLM_CUDA_VERSION"
echo "vllm_install:  $VLLM_WITH_SPEC"
echo "tp_size:       $VLLM_TENSOR_PARALLEL_SIZE"
echo "gpu_mem_util:  $VLLM_GPU_MEMORY_UTILIZATION"
echo "max_batched:   $VLLM_MAX_NUM_BATCHED_TOKENS"
echo "started_at:    $(date -Iseconds)"
echo "==========================="

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

prepare_gptoss_tiktoken() {
    if [[ "$VLLM_PREPARE_GPTOSS_TIKTOKEN" != "1" ]]; then
        return 0
    fi
    if [[ "$VLLM_MODEL" != openai/gpt-oss-* ]]; then
        return 0
    fi

    mkdir -p "$TIKTOKEN_ENCODINGS_DIR"
    export TIKTOKEN_ENCODINGS_BASE="$TIKTOKEN_ENCODINGS_DIR"
    if [[ ! -s "$TIKTOKEN_ENCODINGS_DIR/o200k_base.tiktoken" ]]; then
        curl --fail --location --silent --show-error \
            --output "$TIKTOKEN_ENCODINGS_DIR/o200k_base.tiktoken" \
            "https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken"
    fi
    if [[ ! -s "$TIKTOKEN_ENCODINGS_DIR/cl100k_base.tiktoken" ]]; then
        curl --fail --location --silent --show-error \
            --output "$TIKTOKEN_ENCODINGS_DIR/cl100k_base.tiktoken" \
            "https://openaipublic.blob.core.windows.net/encodings/cl100k_base.tiktoken"
    fi
    echo "tiktoken_encodings_base: $TIKTOKEN_ENCODINGS_BASE"
}

prepare_gptoss_tiktoken

serve_args=(
    vllm serve "$VLLM_MODEL"
    --tensor-parallel-size "$VLLM_TENSOR_PARALLEL_SIZE"
    --host 127.0.0.1
    --port "$PORT"
    --max-model-len "$MAX_MODEL_LEN"
    --gpu-memory-utilization "$VLLM_GPU_MEMORY_UTILIZATION"
)
if [[ -n "$VLLM_MAX_NUM_BATCHED_TOKENS" ]]; then
    serve_args+=(--max-num-batched-tokens "$VLLM_MAX_NUM_BATCHED_TOKENS")
fi
if [[ "$VLLM_MODEL" == Qwen/Qwen3* || "$VLLM_MODEL" == Qwen/Qwen3.* ]]; then
    serve_args+=(--reasoning-parser "$VLLM_QWEN_REASONING_PARSER")
    if [[ -n "$VLLM_QWEN_CHAT_TEMPLATE_KWARGS" ]]; then
        serve_args+=(--default-chat-template-kwargs "$VLLM_QWEN_CHAT_TEMPLATE_KWARGS")
    fi
fi

uv run --isolated \
    --extra-index-url "$PYTORCH_INDEX_URL" \
    --with "$VLLM_WITH_SPEC" \
    "${serve_args[@]}" &
VLLM_PID=$!

cleanup() {
    if kill -0 "$VLLM_PID" 2>/dev/null; then
        kill "$VLLM_PID"
        wait "$VLLM_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

VLLM_READY=0
for _ in $(seq 1 120); do
    if curl --fail --silent --show-error \
        "http://127.0.0.1:${PORT}/v1/models" >/dev/null; then
        VLLM_READY=1
        break
    fi
    if ! kill -0 "$VLLM_PID" 2>/dev/null; then
        echo "ERROR: vLLM exited before becoming healthy." >&2
        exit 1
    fi
    sleep 5
done
if [[ "$VLLM_READY" != "1" ]]; then
    echo "ERROR: vLLM health check timed out after 10 minutes." >&2
    exit 1
fi

CHAT_RESPONSE="$(
    curl --silent --show-error \
        --write-out '\n%{http_code}' \
        --header "Content-Type: application/json" \
        --data '{"model":"'"$VLLM_MODEL"'","messages":[{"role":"user","content":"Hello, please introduce yourself briefly."}],"max_tokens":64}' \
        "http://127.0.0.1:${PORT}/v1/chat/completions"
)"
HTTP_STATUS="${CHAT_RESPONSE##*$'\n'}"
RESPONSE_BODY="${CHAT_RESPONSE%$'\n'*}"

echo "$RESPONSE_BODY"

if [[ "$HTTP_STATUS" != "200" ]]; then
    echo "ERROR: chat completion returned HTTP status $HTTP_STATUS." >&2
    exit 1
fi
if ! printf '%s\n' "$RESPONSE_BODY" | grep -q '"choices"'; then
    echo "ERROR: chat completion response did not contain choices." >&2
    exit 1
fi

echo "SMOKE TEST PASSED: $VLLM_MODEL"
echo "finished_at: $(date -Iseconds)"
