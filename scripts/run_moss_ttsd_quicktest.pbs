#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N moss_ttsd_quicktest
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

# MOSS-TTSD audio-only quick test using the three checked-in aizuchi dialogues.
# Default voice references are generated automatically; no audio prep is needed.
#   qsub -V scripts/run_moss_ttsd_quicktest.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

export BATCH_ID="${BATCH_ID:-moss_ttsd_quicktest}"
export RUN_ID="$BATCH_ID"
export OUT_ROOT="${OUT_ROOT:-$PWD/data/runs/$BATCH_ID}"
export STEPS=audio
export DIALOGUES_JSONL="$PWD/tests/fixtures/aizuchi_dialogues.jsonl"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export TTS_BACKEND=moss-ttsd
export TTS_DTYPE=float16
export TTS_DEVICE=cuda
export MOSS_TTS_MODEL="${MOSS_TTS_MODEL:-OpenMOSS-Team/MOSS-TTSD-v1.0}"
export MOSS_CODEC_MODEL="${MOSS_CODEC_MODEL:-OpenMOSS-Team/MOSS-Audio-Tokenizer}"

mkdir -p experiments/pbs_logs
JOB_LOG="experiments/pbs_logs/${BATCH_ID}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== MOSS-TTSD quick test ====="
echo "job_id:      ${PBS_JOBID:-n/a}"
echo "host:        $(hostname)"
echo "out_root:    $OUT_ROOT"
echo "dialogues:   $DIALOGUES_JSONL"
echo "tts_model:   $MOSS_TTS_MODEL"
echo "codec_model: $MOSS_CODEC_MODEL"
echo "started_at:  $(date -Iseconds)"
echo "================================"

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

bash scripts/run_full_duplex_training_data.sh

MANIFEST="$OUT_ROOT/training_set/synthetic_moshi_train.jsonl"
if [[ ! -s "$MANIFEST" ]]; then
    echo "ERROR: quick-test manifest was not created: $MANIFEST" >&2
    exit 1
fi

echo "manifest:    $MANIFEST ($(grep -c . "$MANIFEST") samples)"
echo "stereo_wav:  $OUT_ROOT/training_set/data_stereo"
echo "finished_at: $(date -Iseconds)"
