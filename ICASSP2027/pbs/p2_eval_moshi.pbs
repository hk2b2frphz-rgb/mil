#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N clarify_eval
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V
#PBS -J 0-3

# Closed-loop clarification evaluation, sharded 4-way as a PBS array job
# (one V100 per shard). Merge shards afterwards with p7_summarize.pbs or
# summarize_results.py (it reads scores_shard*.jsonl transparently).
#
# Base model:
#   qsub -v BENCH_ID=bench_v1,MODEL_ID=base ICASSP2027/pbs/p2_eval_moshi.pbs
#
# Fine-tuned (merged LoRA / exported full-FT):
#   qsub -v BENCH_ID=bench_v1,MODEL_ID=clarify_full,\
#   MODEL_WEIGHT=/path/consolidated.safetensors ICASSP2027/pbs/p2_eval_moshi.pbs
#
# Optional: MODEL_CONFIG, HF_REPO, SEEDS=0,1,2, CONDITIONS=all,
#           OUT_ID (default MODEL_ID), SAVE_AUDIO=1

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
SHARD="${PBS_ARRAY_INDEX:-0}"
NUM_SHARDS="${NUM_SHARDS:-4}"

BENCH_ID="${BENCH_ID:?set BENCH_ID (e.g. bench_v1)}"
MODEL_ID="${MODEL_ID:?set MODEL_ID (e.g. base)}"
OUT_ID="${OUT_ID:-$MODEL_ID}"
SEEDS="${SEEDS:-0,1,2}"
CONDITIONS="${CONDITIONS:-all}"
HF_REPO="${HF_REPO:-llm-jp/llm-jp-moshi-v1}"

export TORCHINDUCTOR_DISABLE=1
export NO_TORCH_COMPILE=1
export TORCH_COMPILE_DISABLE=1
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

mkdir -p ICASSP2027/runs/pbs_logs
exec > >(tee -a "ICASSP2027/runs/pbs_logs/eval_${OUT_ID}_${JOB_ID_SHORT}_s${SHARD}.log") 2>&1

echo "job: ${PBS_JOBID:-n/a} host: $(hostname) model: $MODEL_ID shard: $SHARD/$NUM_SHARDS"
command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi || true

EXTRA_ARGS=()
if [[ -n "${MODEL_WEIGHT:-}" ]]; then
    EXTRA_ARGS+=(--moshi-weight "$MODEL_WEIGHT")
    # Auto-detect moshi_lm_kwargs.json next to the weight (full-FT export
    # convention), matching run_full_duplex_eval.sh behavior.
    if [[ -z "${MODEL_CONFIG:-}" ]]; then
        CAND="$(dirname "$MODEL_WEIGHT")/moshi_lm_kwargs.json"
        [[ -f "$CAND" ]] && MODEL_CONFIG="$CAND"
    fi
fi
[[ -n "${MODEL_CONFIG:-}" ]] && EXTRA_ARGS+=(--config "$MODEL_CONFIG")
[[ "${SAVE_AUDIO:-0}" == "1" ]] && EXTRA_ARGS+=(--save-audio)

uv run python ICASSP2027/scripts/run_closed_loop_eval.py \
    --dataset-dir "ICASSP2027/runs/${BENCH_ID}" \
    --out-dir "ICASSP2027/runs/eval_${OUT_ID}" \
    --model-id "$MODEL_ID" \
    --hf-repo "$HF_REPO" \
    --half \
    --seeds "$SEEDS" \
    --conditions "$CONDITIONS" \
    --shard "$SHARD" --num-shards "$NUM_SHARDS" \
    "${EXTRA_ARGS[@]}"

echo "EVAL SHARD OK: ICASSP2027/runs/eval_${OUT_ID} (shard $SHARD)"
