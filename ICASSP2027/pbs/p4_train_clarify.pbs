#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N clarify_lora
#PBS -q xan_s
#PBS -l select=1:res=small
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -V

# LoRA fine-tune one clarify variant on one A100, reusing the existing
# sweep infrastructure (scripts/run_sweep_pair.sh, kyutai moshi-finetune).
#
#   qsub -v SRC_RUN_DIR=ICASSP2027/runs/train_clarify_full \
#        ICASSP2027/pbs/p4_train_clarify.pbs
#
# Overrides: SWEEP_PATTERNS=h01 (LoRA hyperparameter pattern),
#            RUN_ID (experiment label).
# For full fine-tuning use scripts/fullft_sweep.pbs directly with the same
# SRC_RUN_DIR (see experiments/README.md).

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
source scripts/setup_proxy.sh

JOB_ID_RAW="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
JOB_ID_SHORT="${JOB_ID_RAW%%.*}"
source scripts/setup_pbs_distributed.sh

export SRC_RUN_DIR="${SRC_RUN_DIR:?set SRC_RUN_DIR (p3 output dir)}"
export SWEEP_PATTERNS="${SWEEP_PATTERNS:-h01}"
export RUN_ID="${RUN_ID:-clarify_$(basename "$SRC_RUN_DIR")_${JOB_ID_SHORT}}"
export MLFLOW_EXPERIMENT_NAME="${MLFLOW_EXPERIMENT_NAME:-icassp2027_clarify}"
export MLFLOW_TRACKING_URI="${MLFLOW_TRACKING_URI:-sqlite:///$PWD/mlruns/mlflow.db}"
export MLFLOW_ARTIFACT_ROOT="${MLFLOW_ARTIFACT_ROOT:-file:$PWD/mlruns/artifacts}"

# The clarify eval does not use the counseling opening greeting.
export FDB_OPENING_GREETING="${FDB_OPENING_GREETING:-0}"
# run_sweep_pair.sh skips data generation automatically when SRC_RUN_DIR
# is set (see scripts/run_sweep_pair.sh).

mkdir -p ICASSP2027/runs/pbs_logs
exec > >(tee -a "ICASSP2027/runs/pbs_logs/${RUN_ID}.log") 2>&1

echo "job: ${PBS_JOBID:-n/a} host: $(hostname) src: $SRC_RUN_DIR patterns: $SWEEP_PATTERNS"
command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi || true

if [[ ! -f "$SRC_RUN_DIR/training_set/synthetic_moshi_train.jsonl" ]]; then
    echo "ERROR: $SRC_RUN_DIR/training_set/synthetic_moshi_train.jsonl not found (run p3 first)" >&2
    exit 1
fi

bash scripts/run_sweep_pair.sh

echo "TRAIN OK: patterns=$SWEEP_PATTERNS from $SRC_RUN_DIR"
echo "Next: merge LoRA (scripts/merge_lora.pbs), then evaluate with p2 and p6."
