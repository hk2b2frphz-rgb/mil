# Python
__pycache__/
*.pyc
.venv-vllm-omni/

# Pipeline outputs (regenerable)
data/
results/
eval_runs/

# Per-experiment runtime artifacts (regenerable / heavy).
# Keep config.yaml / HYPERPARAMS.md / notes.md / args.yaml under VCS,
# discard everything else.
experiments/*/data/
experiments/*/checkpoints/
experiments/*/run.log
experiments/*/_resolved.yaml

# Voice-synth working configs: copy the tracked .example, keep the copy local.
configs/voice_synth.yaml
configs/voice_synth.*.yaml
!configs/voice_synth.example.yaml

# editor
.vscode/
.idea/

# Reference literature (downloaded PDFs etc.) -- kept out of VCS on request.
references/
