#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N qwen_tts_1000_4gpu
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# Production Qwen3-TTS rendering for qwen_dialogues_1000 on one 4-GPU node.
#
# The job splits the input dialogues JSONL into NUM_SHARDS shards, runs one
# generate_qwen3_tts_data.py process per GPU, then merges shard manifests into:
#   data/runs/<BATCH_ID>/merged/training_set/synthetic_moshi_train.jsonl
#
# Submit:
#   qsub -V scripts/run_qwen_tts_1000_4gpu.pbs
#
# Useful overrides:
#   NUM_SHARDS=4
#   CUDA_VISIBLE_DEVICES=0,1,2,3
#   SOURCE_BATCH_ID=qwen_dialogues_1000
#   NUM_DIALOGUES=all

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"
if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
    # shellcheck source=/dev/null
    source "$PWD/scripts/setup_proxy.sh"
fi

command -v uv >/dev/null 2>&1 || {
    echo "ERROR: uv is not available on PATH." >&2
    exit 1
}

export SOURCE_BATCH_ID="${SOURCE_BATCH_ID:-qwen_dialogues_1000}"
export BATCH_ID="${BATCH_ID:-${SOURCE_BATCH_ID}_tts_4gpu}"
export RUN_ID="$BATCH_ID"
export DIALOGUES_JSONL="${DIALOGUES_JSONL:-$PWD/data/runs/${SOURCE_BATCH_ID}/llm_dialogues/dialogues.jsonl}"
export OUT_ROOT="${OUT_ROOT:-$PWD/data/runs/$BATCH_ID}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"
export NUM_SHARDS="${NUM_SHARDS:-4}"
export NUM_DIALOGUES="${NUM_DIALOGUES:-all}"
export TTS_DTYPE="${TTS_DTYPE:-float16}"
export TTS_DEVICE="${TTS_DEVICE:-cuda}"
export LEAD_IN_SEC="${LEAD_IN_SEC:-0.3}"
export GAP_SEC="${GAP_SEC:-0.2}"
export EMOTION_MAP_FILE="${EMOTION_MAP_FILE:-$PWD/configs/emotion_presets_mild.json}"

if ! [[ "$NUM_SHARDS" =~ ^[0-9]+$ ]] || [[ "$NUM_SHARDS" -lt 1 ]]; then
    echo "ERROR: NUM_SHARDS must be a positive integer: $NUM_SHARDS" >&2
    exit 1
fi
if [[ "$NUM_DIALOGUES" != "all" ]]; then
    if ! [[ "$NUM_DIALOGUES" =~ ^[0-9]+$ ]] || [[ "$NUM_DIALOGUES" -lt 1 ]]; then
        echo "ERROR: NUM_DIALOGUES must be a positive integer or 'all': $NUM_DIALOGUES" >&2
        exit 1
    fi
fi
IFS=',' read -r -a GPU_IDS <<< "$CUDA_VISIBLE_DEVICES"
if [[ "${#GPU_IDS[@]}" -lt "$NUM_SHARDS" ]]; then
    echo "ERROR: CUDA_VISIBLE_DEVICES has ${#GPU_IDS[@]} GPU(s), but NUM_SHARDS=$NUM_SHARDS" >&2
    exit 1
fi
if [[ ! -s "$DIALOGUES_JSONL" ]]; then
    echo "ERROR: dialogues JSONL was not found or is empty: $DIALOGUES_JSONL" >&2
    exit 1
fi
if [[ -n "$EMOTION_MAP_FILE" && ! -f "$EMOTION_MAP_FILE" ]]; then
    echo "ERROR: EMOTION_MAP_FILE does not exist: $EMOTION_MAP_FILE" >&2
    exit 1
fi

mkdir -p "$OUT_ROOT" "$OUT_ROOT/logs" experiments/pbs_logs
JOB_TAG="${PBS_JOBID:-local}"
JOB_TAG="${JOB_TAG%%.*}"
JOB_LOG="experiments/pbs_logs/${BATCH_ID}_${JOB_TAG:-local}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== Qwen3-TTS 1000 production (4 GPU) ====="
echo "job_id:        ${PBS_JOBID:-n/a}"
echo "host:          $(hostname)"
echo "source_batch:  $SOURCE_BATCH_ID"
echo "out_root:      $OUT_ROOT"
echo "dialogues:     $DIALOGUES_JSONL"
echo "num_dialogues: $NUM_DIALOGUES"
echo "num_shards:    $NUM_SHARDS"
echo "gpus:          $CUDA_VISIBLE_DEVICES"
echo "dtype:         $TTS_DTYPE"
echo "emotion_map:   ${EMOTION_MAP_FILE:-n/a}"
echo "timing:        lead_in=$LEAD_IN_SEC gap=$GAP_SEC"
echo "started_at:    $(date -Iseconds)"
echo "============================================="

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi
fi

echo "===== step 0/3: uv environment preflight ====="
uv run python - <<'PY'
import numpy  # noqa: F401
import sphn  # noqa: F401
try:
    import qwen_tts  # noqa: F401
except Exception as exc:
    raise SystemExit(f"qwen_tts import failed before parallel launch: {exc}")
print("uv/qwen_tts preflight ok")
PY

echo "===== step 1/3: split dialogues ====="
uv run python - "$DIALOGUES_JSONL" "$OUT_ROOT" "$NUM_SHARDS" "$NUM_DIALOGUES" <<'PY'
import json
import sys
from pathlib import Path

src = Path(sys.argv[1])
out_root = Path(sys.argv[2])
num_shards = int(sys.argv[3])
limit_arg = sys.argv[4]
limit = None if limit_arg == "all" else int(limit_arg)

rows = [line for line in src.read_text(encoding="utf-8").splitlines() if line.strip()]
if limit is not None:
    rows = rows[:limit]
if not rows:
    raise SystemExit("No dialogue rows selected")

counts = [0 for _ in range(num_shards)]
for i in range(num_shards):
    shard_dir = out_root / "shard_{:03d}".format(i)
    shard_dir.mkdir(parents=True, exist_ok=True)
    shard_path = shard_dir / "dialogues.jsonl"
    selected = [row for j, row in enumerate(rows) if j % num_shards == i]
    shard_path.write_text("\n".join(selected) + ("\n" if selected else ""), encoding="utf-8")
    counts[i] = len(selected)

summary = {
    "source": str(src),
    "selected_dialogues": len(rows),
    "num_shards": num_shards,
    "counts": counts,
}
(out_root / "split_summary.json").write_text(
    json.dumps(summary, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)
print(json.dumps(summary, ensure_ascii=False))
PY

echo "===== step 2/3: render shards in parallel ====="
pids=()
for ((i = 0; i < NUM_SHARDS; i++)); do
    shard_tag="$(printf 'shard_%03d' "$i")"
    shard_dir="$OUT_ROOT/$shard_tag"
    shard_dialogues="$shard_dir/dialogues.jsonl"
    shard_training="$shard_dir/training_set"
    shard_log="$OUT_ROOT/logs/${shard_tag}.log"
    gpu_id="${GPU_IDS[$i]}"

    if [[ ! -s "$shard_dialogues" ]]; then
        echo "ERROR: split shard is empty: $shard_dialogues" >&2
        exit 1
    fi

    (
        set -euo pipefail
        echo "[$shard_tag] gpu=$gpu_id dialogues=$shard_dialogues out=$shard_training"
        tts_args=(
            uv run python scripts/generate_qwen3_tts_data.py
            --tts-backend qwen3
            --dialogues-jsonl "$shard_dialogues"
            --auto-overlap-aizuchi
            --out-dir "$shard_training"
            --device "$TTS_DEVICE"
            --dtype "$TTS_DTYPE"
            --lead-in-sec "$LEAD_IN_SEC"
            --gap-sec "$GAP_SEC"
        )
        if [[ -n "$EMOTION_MAP_FILE" ]]; then
            tts_args+=(--emotion-map-file "$EMOTION_MAP_FILE")
        fi
        CUDA_VISIBLE_DEVICES="$gpu_id" "${tts_args[@]}"
        test -s "$shard_training/synthetic_moshi_train.jsonl"
        echo "[$shard_tag] done"
    ) > "$shard_log" 2>&1 &
    pid="$!"
    pids+=("$pid")
    echo "started $shard_tag on gpu $gpu_id (pid=$pid, log=$shard_log)"
done

failed=0
for pid in "${pids[@]}"; do
    if ! wait "$pid"; then
        failed=1
    fi
done
if [[ "$failed" != "0" ]]; then
    echo "ERROR: at least one TTS shard failed. Logs: $OUT_ROOT/logs/shard_*.log" >&2
    exit 1
fi

echo "===== step 3/3: merge shard manifests ====="
uv run python scripts/merge_training_shards.py \
    --batch-dir "$OUT_ROOT" \
    --out-dir "$OUT_ROOT/merged" \
    --expected-shards "$NUM_SHARDS"

MERGED_MANIFEST="$OUT_ROOT/merged/training_set/synthetic_moshi_train.jsonl"
test -s "$MERGED_MANIFEST"
MERGED_ROWS="$(grep -c . "$MERGED_MANIFEST" || true)"
echo "merged_manifest: $MERGED_MANIFEST"
echo "merged_rows:     $MERGED_ROWS"
echo "finished_at:     $(date -Iseconds)"
